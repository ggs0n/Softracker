{
  "ApiService": {
    "BaseUrl": "http://127.0.0.1:5200",
    "RequestTimeoutSeconds": 0,
    "BackendPrefixes": [
      "/Admin",
      "/Agent",
      "/Auth",
      "/Bug",
      "/Calendar",
      "/ChangeRequest",
      "/Developer",
      "/GitHubAuth",
      "/Monitor",
      "/Notification",
      "/Onboarding",
      "/Payment",
      "/Qa",
      "/Settings",
      "/TaskBoard",
      "/Team"
    ]
  },
  "AssetCaching": {
    "MaxAgeSeconds": 604800
  },
  "ResponseCompression": {
    "BrotliLevel": "Fastest",
    "GzipLevel": "SmallestSize"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

        "IsRunning": false
      },
      {
        "Name": "Daily Agent Cleanup",
        "Description": "Archive finished OpenClaw agent logs and stale queue items.",
        "CronExpression": "0 1 * * *",
        "IsEnabled": true,
        "IsRunning": false
      }
    ]
  },

@model WFHMonitor.ViewModels.OnboardingWelcomeViewModel
@{
    Layout = null;
    var connectDisabled = !Model.CanUseGitHubOAuth;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome - adib</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            /* Match adib design system */
            --ob-bg: #18181b;
            --ob-bg-raised: #1f1f23;
            --ob-surface: rgba(255,255,255,0.04);
            --ob-surface-hover: rgba(255,255,255,0.07);
            --ob-border: rgba(255,255,255,0.08);
            --ob-border-hover: rgba(255,255,255,0.16);
            --ob-text: #e4e4e7;
            --ob-text-muted: #a1a1aa;
            --ob-text-bright: #ffffff;
            /* Emerald accent */
            --ob-accent: #10b981;
            --ob-accent-hover: #059669;
            --ob-accent-bg: rgba(16,185,129,0.1);
            --ob-accent-border: rgba(16,185,129,0.25);
            --ob-accent-glow: rgba(16,185,129,0.2);
            --ob-card-radius: 16px;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            min-height: 100dvh;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            color: var(--ob-text);
            background: var(--ob-bg);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        /* --- Animated mesh gradient background --- */
        .ob-bg-canvas {
            position: fixed;
            inset: 0;
            z-index: 0;
            overflow: hidden;
            pointer-events: none;
        }
        .ob-bg-canvas::before,
        .ob-bg-canvas::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            filter: blur(130px);
            opacity: 0.4;
            animation: meshFloat 20s ease-in-out infinite alternate;
        }
        .ob-bg-canvas::before {
            width: 700px; height: 700px;
            background: radial-gradient(circle, #10b981 0%, transparent 70%);
            top: -20%; left: -10%;
        }
        .ob-bg-canvas::after {
            width: 600px; height: 600px;
            background: radial-gradient(circle, #059669 0%, transparent 70%);
            bottom: -15%; right: -10%;
            animation-delay: -8s;
            animation-direction: alternate-reverse;
        }
        .ob-blob-3 {
            position: absolute;
            width: 450px; height: 450px;
            border-radius: 50%;
            background: radial-gradient(circle, #34d399 0%, transparent 70%);
            filter: blur(130px);
            opacity: 0.15;
            top: 45%; left: 55%;
            transform: translate(-50%, -50%);
            animation: meshFloat 24s ease-in-out infinite alternate-reverse;
            animation-delay: -4s;
        }
        .ob-grid-overlay {
            position: absolute; inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
            background-size: 64px 64px;
            mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 20%, transparent 100%);
            -webkit-mask-image: radial-gradient(ellipse 60% 50% at 50% 50%, black 20%, transparent 100%);
        }
        .ob-noise {
            position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
            opacity: 0.03;
            mix-blend-mode: overlay;
        }

        @@keyframes meshFloat {
            0%   { transform: translate(0, 0) scale(1); }
            50%  { transform: translate(50px, -35px) scale(1.08); }
            100% { transform: translate(-25px, 25px) scale(0.95); }
        }

        /* --- Page layout --- */
        .ob-page {
            position: relative;
            z-index: 1;
            min-height: 100dvh;
            display: flex;
            flex-direction: column;
            padding: 24px clamp(20px, 4vw, 48px);
        }

        /* --- Top bar --- */
        .ob-topbar {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 16px;
        }
        .ob-skip-btn {
            border: 1px solid var(--ob-border);
            background: var(--ob-surface);
            color: var(--ob-text-muted);
            font-size: 0.85rem;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: 10px;
            cursor: pointer;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            transition: all 0.25s ease;
        }
        .ob-skip-btn:hover {
            background: var(--ob-surface-hover);
            border-color: var(--ob-border-hover);
            color: var(--ob-text-bright);
        }

        /* --- Main container --- */
        .ob-main {
            margin: auto;
            width: min(960px, 100%);
            text-align: center;
        }

        /* --- Logo --- */
        .ob-logo {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }
        .ob-logo-icon {
            width: 46px; height: 46px;
            border-radius: 12px;
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: #fff;
            box-shadow: 0 0 28px rgba(16,185,129,0.3);
        }
        .ob-logo-text {
            font-size: 1.75rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            background: linear-gradient(135deg, #e4e4e7 0%, #ffffff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* --- Step badge --- */
        .ob-step-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--ob-accent);
            background: var(--ob-accent-bg);
            border: 1px solid var(--ob-accent-border);
            padding: 6px 16px;
            border-radius: 100px;
            margin-bottom: 24px;
        }
        .ob-step-badge i { font-size: 0.85rem; }

        /* --- Title & subtitle --- */
        .ob-title {
            font-size: clamp(2.2rem, 5vw, 3.2rem);
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.03em;
            color: var(--ob-text-bright);
            margin-bottom: 14px;
        }
        .ob-subtitle {
            max-width: 560px;
            margin: 0 auto 44px;
            color: var(--ob-text-muted);
            font-size: 1.05rem;
            line-height: 1.6;
        }

        /* --- Card grid --- */
        .ob-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        /* --- Card --- */
        .ob-card {
            position: relative;
            text-align: left;
            padding: 32px 28px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            min-height: 240px;
            border: 1px solid var(--ob-border);
            border-radius: var(--ob-card-radius);
            background: var(--ob-bg-raised);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            color: inherit;
            text-decoration: none;
            cursor: pointer;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .ob-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: var(--ob-card-radius);
            opacity: 0;
            background: linear-gradient(135deg, rgba(16,185,129,0.06), rgba(5,150,105,0.03), transparent);
            transition: opacity 0.3s ease;
        }
        .ob-card:hover {
            border-color: var(--ob-accent-border);
            transform: translateY(-4px);
            box-shadow: 0 16px 48px rgba(0,0,0,0.3), 0 0 30px var(--ob-accent-glow);
        }
        .ob-card:hover::before { opacity: 1; }

        .ob-card.is-disabled,
        .ob-card.is-disabled:hover {
            opacity: 0.4;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        .ob-card.is-disabled::before { display: none; }

        /* --- Card icon --- */
        .ob-card-icon {
            position: relative;
            z-index: 1;
            width: 50px; height: 50px;
            border-radius: 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            margin-bottom: 4px;
        }
        .ob-card-icon.github-icon {
            background: rgba(255,255,255,0.08);
            color: #fff;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .ob-card-icon.skip-icon {
            background: var(--ob-accent-bg);
            color: var(--ob-accent);
            border: 1px solid var(--ob-accent-border);
        }

        .ob-card-title {
            position: relative; z-index: 1;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--ob-text-bright);
            margin: 0;
        }

        .ob-card-desc {
            position: relative; z-index: 1;
            margin: 0;
            color: var(--ob-text-muted);
            line-height: 1.55;
            font-size: 0.95rem;
        }

        .ob-card-action {
            position: relative; z-index: 1;
            margin-top: auto;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--ob-accent);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: gap 0.25s ease;
        }
        .ob-card:hover .ob-card-action { gap: 10px; }

        /* --- Form wrapper --- */
        .ob-form {
            margin: 0;
            display: flex;
        }
        .ob-form .ob-card {
            width: 100%;
        }

        /* --- Alert note --- */
        .ob-note {
            margin: 24px auto 0;
            max-width: 720px;
            color: #fbbf24;
            background: rgba(251,191,36,0.08);
            border: 1px solid rgba(251,191,36,0.2);
            border-radius: 14px;
            padding: 14px 18px;
            font-size: 0.9rem;
            text-align: left;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        /* --- Floating particles --- */
        .ob-particles {
            position: fixed; inset: 0; z-index: 0;
            pointer-events: none; overflow: hidden;
        }
        .ob-particle {
            position: absolute;
            border-radius: 50%;
            background: rgba(16,185,129,0.25);
            animation: particleFloat linear infinite;
        }
        @@keyframes particleFloat {
            0%   { transform: translateY(100vh) scale(0); opacity: 0; }
            10%  { opacity: 1; }
            90%  { opacity: 1; }
            100% { transform: translateY(-10vh) scale(1); opacity: 0; }
        }

        /* --- Responsive --- */
        @@media (max-width: 760px) {
            .ob-grid { grid-template-columns: 1fr; }
            .ob-card { min-height: 200px; }
        }
    </style>
</head>
<body>
    <!-- Background layers -->
    <div class="ob-bg-canvas">
        <div class="ob-blob-3"></div>
        <div class="ob-grid-overlay"></div>
        <div class="ob-noise"></div>
    </div>

    <!-- Floating particles -->
    <div class="ob-particles" id="particles"></div>

    <!-- Page content -->
    <div class="ob-page">
        <div class="ob-topbar">
            <form asp-controller="Onboarding" asp-action="SkipWelcome" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="ob-skip-btn">
                    <i class="bi bi-arrow-right-short"></i> Skip to dashboard
                </button>
            </form>
        </div>

        <main class="ob-main" aria-labelledby="welcomeTitle">
            <div class="ob-logo">
                <div class="ob-logo-icon"><i class="bi bi-cpu"></i></div>
                <span class="ob-logo-text">adib</span>
            </div>

            <div class="ob-step-badge">
                <i class="bi bi-stars"></i> Onboarding Step 2 of 3
            </div>

            <h1 id="welcomeTitle" class="ob-title">What do you want to<br/>connect first?</h1>
            <p class="ob-subtitle">Choose how you want to continue. You can always replay the walkthrough later from Help / Start Tour.</p>

            <div class="ob-grid">
                @if (connectDisabled)
                {
                    <div class="ob-card is-disabled" aria-disabled="true">
                        <div class="ob-card-icon github-icon"><i class="bi bi-github"></i></div>
                        <h2 class="ob-card-title">Connect GitHub Repo</h2>
                        <p class="ob-card-desc">Link your GitHub account to import repository details and speed up project setup.</p>
                        <div class="ob-card-action">Unavailable right now</div>
                    </div>
                }
                else
                {
                    <a class="ob-card" href="@Model.ConnectUrl">
                        <div class="ob-card-icon github-icon"><i class="bi bi-github"></i></div>
                        <h2 class="ob-card-title">Connect GitHub Repo</h2>
                        <p class="ob-card-desc">Authorize GitHub access so adib can fetch repo info and support your onboarding flow.</p>
                        <div class="ob-card-action">Continue with GitHub <i class="bi bi-arrow-right"></i></div>
                    </a>
                }

                <form asp-controller="Onboarding" asp-action="SkipWelcome" method="post" class="ob-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="ob-card">
                        <div class="ob-card-icon skip-icon"><i class="bi bi-rocket-takeoff"></i></div>
                        <h2 class="ob-card-title">Continue Without GitHub</h2>
                        <p class="ob-card-desc">Go straight to dashboard now. You can connect GitHub anytime from the top bar.</p>
                        <div class="ob-card-action">Skip for now <i class="bi bi-arrow-right"></i></div>
                    </button>
                </form>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.NoAccessMessage))
            {
                <p class="ob-note"><i class="bi bi-exclamation-triangle me-1"></i> @Model.NoAccessMessage</p>
            }
        </main>
    </div>

    <script>
        (function () {
            var container = document.getElementById('particles');
            if (!container) return;
            for (var i = 0; i < 25; i++) {
                var p = document.createElement('div');
                p.className = 'ob-particle';
                p.style.left = Math.random() * 100 + '%';
                p.style.animationDuration = (14 + Math.random() * 18) + 's';
                p.style.animationDelay = -(Math.random() * 30) + 's';
                p.style.width = p.style.height = (2 + Math.random() * 2.5) + 'px';
                container.appendChild(p);
            }
        })();
    </script>
</body>
</html>

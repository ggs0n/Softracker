@model TaskBoardViewModel
@{ ViewData["Title"] = "Task Board"; }

<div class="mod-header mb-4">
    <div class="mod-header-left">
        <h1 class="mod-title"><i class="bi bi-kanban-fill" style="color:#818cf8"></i> Task Board</h1>
        <p class="mod-subtitle">Track work in progress across all stages</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="dp-btn-primary">
            <i class="bi bi-plus-circle"></i> New Task
        </a>
    }
</div>

@if (User.IsInRole("Developer"))
{
    <div class="dp" style="--dp-color:#6366f1">
        <div class="dp-header">
            <div class="dp-header-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
                <i class="bi bi-list-check"></i>
            </div>
            <span class="dp-header-title">My Assigned Tasks</span>
            <span class="dp-header-count">@Model.AssignedTasks.Count() tasks</span>
        </div>

        @if (!Model.AssignedTasks.Any())
        {
            <div class="dp-empty">
                <i class="bi bi-inbox"></i>
                No tasks assigned to you
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="dp-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Detail</th>
                            <th>Timeline</th>
                            <th>Related</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.AssignedTasks)
                        {
                            var stCls = task.Status.ToString() switch {
                                "ToDo"       => "dp-badge-slate",
                                "InProgress" => "dp-badge-indigo",
                                "Blocked"    => "dp-badge-red",
                                "Done"       => "dp-badge-green",
                                _            => "dp-badge-slate"
                            };
                            <tr>
                                <td class="dp-cell-title">@task.Title</td>
                                <td class="dp-cell-muted">@(string.IsNullOrWhiteSpace(task.Details) ? "—" : task.Details)</td>
                                <td class="dp-cell-muted" style="font-size:0.75rem;white-space:nowrap">
                                    @if (task.TimelineStart.HasValue || task.TimelineEnd.HasValue)
                                    {
                                        var hasInvalidTimeline = task.TimelineStart.HasValue && task.TimelineEnd.HasValue && task.TimelineEnd.Value.Date < task.TimelineStart.Value.Date;
                                        if (hasInvalidTimeline)
                                        {
                                            <span class="text-danger">Invalid timeline</span>
                                        }
                                        else
                                        {
                                            @(task.TimelineStart?.ToString("yyyy-MM-dd"))<span class="mx-1" style="color:#334155">→</span>@(task.TimelineEnd?.ToString("yyyy-MM-dd"))
                                        }
                                    }
                                    else if (task.DueDate.HasValue)
                                    {
                                        <span>Due @task.DueDate.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    else { <span>—</span> }
                                </td>
                                <td>
                                    @if (task.ChangeRequest != null)
                                    {
                                        <span class="dp-badge dp-badge-indigo me-1">@task.ChangeRequest.CrNumber</span>
                                    }
                                    @if (task.BugReport != null)
                                    {
                                        <span class="dp-badge dp-badge-red">@task.BugReport.BugNumber</span>
                                    }
                                    @if (task.ChangeRequest == null && task.BugReport == null)
                                    {
                                        <span class="dp-cell-muted">—</span>
                                    }
                                </td>
                                <td><span class="dp-badge @stCls">@task.Status</span></td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@task.Id" class="dp-btn" title="View / Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
else
{
    <div class="row g-3">
        @await Html.PartialAsync("_TaskColumn", (Model.ToDo, "To Do", "secondary", "bi-circle"))
        @await Html.PartialAsync("_TaskColumn", (Model.InProgress, "In Progress", "primary", "bi-arrow-repeat"))
        @await Html.PartialAsync("_TaskColumn", (Model.Blocked, "Blocked", "danger", "bi-slash-circle"))
        @await Html.PartialAsync("_TaskColumn", (Model.Done, "Done", "success", "bi-check-circle"))
    </div>
}

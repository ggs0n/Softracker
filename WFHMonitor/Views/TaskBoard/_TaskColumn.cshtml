@model (List<WorkTask> Tasks, string Title, string Color, string Icon)

<div class="col-md-3">
    <div class="card h-100">
        <div class="card-header bg-@Model.Color @(Model.Color == "secondary" ? "" : "text-white") d-flex justify-content-between align-items-center">
            <span><i class="bi @Model.Icon me-2"></i>@Model.Title</span>
            <span class="badge bg-white text-dark">@Model.Tasks.Count</span>
        </div>
        <div class="card-body p-2" style="min-height: 300px;">
            @foreach (var task in Model.Tasks)
            {
                <div class="card mb-2 border-start border-@Model.Color border-3">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="card-title mb-1 fw-semibold">@task.Title</h6>
                            <div class="dropdown ms-2">
                                <button class="btn btn-sm btn-light py-0 px-1" data-bs-toggle="dropdown">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@task.Id">
                                        <i class="bi bi-pencil me-2"></i>Edit
                                    </a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <form asp-action="Delete" asp-route-id="@task.Id" method="post"
                                                  onsubmit="return confirm('Delete this task?')">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item text-danger">
                                                    <i class="bi bi-trash me-2"></i>Delete
                                                </button>
                                            </form>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <p class="card-text small text-muted mb-1">@task.Description</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(task.Details))
                        {
                            <p class="card-text small mb-1"><strong>Detail:</strong> @task.Details</p>
                        }
                        <div class="d-flex gap-2 flex-wrap mt-1">
                            @if (task.Assignee != null)
                            {
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-person me-1"></i>@task.Assignee.FullName
                                </span>
                            }
                            @if (task.TimelineStart.HasValue || task.TimelineEnd.HasValue)
                            {
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-calendar-range me-1"></i>@task.TimelineStart?.ToString("MMM dd") - @task.TimelineEnd?.ToString("MMM dd")
                                </span>
                            }
                            @if (task.DueDate.HasValue)
                            {
                                var isOverdue = task.DueDate.Value.Date < DateTime.Today && task.Status != WorkTaskStatus.Done;
                                <span class="badge @(isOverdue ? "bg-danger" : "bg-light text-dark border") small">
                                    <i class="bi bi-calendar me-1"></i>@task.DueDate.Value.ToString("MMM dd")
                                </span>
                            }
                            @if (task.ChangeRequest != null)
                            {
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-file-earmark-diff me-1"></i>@task.ChangeRequest.CrNumber
                                </span>
                            }
                            @if (task.BugReport != null)
                            {
                                <span class="badge bg-light text-dark border small">
                                    <i class="bi bi-bug me-1"></i>@task.BugReport.BugNumber
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Tasks.Any())
            {
                <p class="text-center text-muted small mt-4 fst-italic">No tasks</p>
            }
        </div>
    </div>
</div>

@model (List<WorkTask> Tasks, string Title, string Color, string Icon)

@{
    var colColor = Model.Color switch {
        "primary"   => "#3b82f6",
        "success"   => "#10b981",
        "danger"    => "#ef4444",
        "warning"   => "#eab308",
        _           => "#71717a"
    };
}

<div class="col-md-3">
    <div class="dp-kanban-col h-100" style="--kc-color:@colColor">
        <div class="dp-kanban-header">
            <i class="bi @Model.Icon" style="color:@colColor;font-size:0.9rem"></i>
            <span class="dp-kanban-title">@Model.Title</span>
            <span class="dp-kanban-count">@Model.Tasks.Count</span>
        </div>

        <div style="padding:10px;min-height:300px;display:flex;flex-direction:column;gap:8px">
            @foreach (var task in Model.Tasks)
            {
                <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.06);border-left:2px solid @colColor;border-radius:10px;padding:12px 14px;transition:all 0.2s cubic-bezier(0.16,1,0.3,1)"
                     onmouseenter="this.style.background='rgba(255,255,255,0.06)';this.style.transform='translateY(-1px)';this.style.boxShadow='0 4px 12px rgba(0,0,0,0.15)'"
                     onmouseleave="this.style.background='rgba(255,255,255,0.03)';this.style.transform='translateY(0)';this.style.boxShadow='none'">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <div style="font-size:0.82rem;font-weight:600;color:var(--text-on-dark);line-height:1.3">@task.Title</div>
                        <div class="dropdown flex-shrink-0">
                            <button class="dp-btn" data-bs-toggle="dropdown" style="width:24px;height:24px;font-size:0.7rem">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" style="background:var(--bg-dark-raised, #1f1f23);border:1px solid rgba(255,255,255,0.08);border-radius:10px;min-width:140px;box-shadow:0 8px 24px rgba(0,0,0,0.3)">
                                <li>
                                    <a class="dropdown-item" asp-action="Edit" asp-route-id="@task.Id"
                                       style="color:#e4e4e7;font-size:0.82rem;padding:8px 14px">
                                        <i class="bi bi-pencil me-2" style="color:var(--accent)"></i>Edit
                                    </a>
                                </li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li>
                                        <form asp-action="Delete" asp-route-id="@task.Id" method="post"
                                              onsubmit="return confirm('Delete this task?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item"
                                                    style="color:#f87171;font-size:0.82rem;padding:8px 14px;background:none;border:none;width:100%;text-align:left">
                                                <i class="bi bi-trash me-2"></i>Delete
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(task.Description))
                    {
                        <p style="font-size:0.72rem;color:var(--text-on-dark-muted);margin:5px 0 0;line-height:1.4">@task.Description</p>
                    }

                    <div class="d-flex gap-1 flex-wrap mt-2">
                        @if (task.Assignee != null)
                        {
                            <span class="dp-badge dp-badge-slate"><i class="bi bi-person me-1"></i>@task.Assignee.FullName</span>
                        }
                        @if (task.TimelineStart.HasValue || task.TimelineEnd.HasValue)
                        {
                            var hasInvalidTimeline = task.TimelineStart.HasValue && task.TimelineEnd.HasValue && task.TimelineEnd.Value.Date < task.TimelineStart.Value.Date;
                            if (hasInvalidTimeline)
                            {
                                <span class="dp-badge dp-badge-red"><i class="bi bi-exclamation-triangle me-1"></i>Invalid timeline</span>
                            }
                            else
                            {
                                <span class="dp-badge dp-badge-slate"><i class="bi bi-calendar-range me-1"></i>@task.TimelineStart?.ToString("MMM dd") – @task.TimelineEnd?.ToString("MMM dd")</span>
                            }
                        }
                        @if (task.DueDate.HasValue)
                        {
                            var overdue = task.DueDate.Value.Date < DateTime.Today && task.Status != WorkTaskStatus.Done;
                            <span class="dp-badge @(overdue ? "dp-badge-red" : "dp-badge-slate")">
                                <i class="bi bi-calendar me-1"></i>@task.DueDate.Value.ToString("MMM dd")
                            </span>
                        }
                        @if (task.ChangeRequest != null)
                        {
                            <span class="dp-badge dp-badge-indigo"><i class="bi bi-file-earmark-diff me-1"></i>@task.ChangeRequest.CrNumber</span>
                        }
                        @if (task.BugReport != null)
                        {
                            <span class="dp-badge dp-badge-red"><i class="bi bi-bug me-1"></i>@task.BugReport.BugNumber</span>
                        }
                    </div>
                </div>
            }

            @if (!Model.Tasks.Any())
            {
                <div class="dp-empty" style="padding:40px 0">
                    <i class="bi bi-inbox"></i>
                    No tasks
                </div>
            }
        </div>
    </div>
</div>

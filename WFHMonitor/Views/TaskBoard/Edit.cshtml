@model TaskEditViewModel
@{ ViewData["Title"] = "Edit Task"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Task</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger small"></div>
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Details" class="form-label fw-semibold">Detail</label>
                        <textarea asp-for="Details" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="col-md-6">
                                <label asp-for="AssigneeId" class="form-label fw-semibold">Assignee</label>
                                <select asp-for="AssigneeId" asp-items="ViewBag.Assignees" class="form-select">
                                    <option value="">-- Unassigned --</option>
                                </select>
                            </div>
                        }
                        <div class="col-md-@(User.IsInRole("Admin") ? "6" : "12")">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<WorkTaskStatus>()" class="form-select"></select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TimelineStart" class="form-label fw-semibold">Timeline Start</label>
                            <input asp-for="TimelineStart" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TimelineEnd" class="form-label fw-semibold">Timeline End</label>
                            <input asp-for="TimelineEnd" type="date" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ChangeRequestId" class="form-label fw-semibold">Related Project</label>
                            <select asp-for="ChangeRequestId" asp-items="ViewBag.ChangeRequests" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BugReportId" class="form-label fw-semibold">Related Bug</label>
                            <select asp-for="BugReportId" asp-items="ViewBag.Bugs" class="form-select">
                                <option value="">-- None --</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label asp-for="DueDate" class="form-label fw-semibold">Due Date</label>
                        <input asp-for="DueDate" type="date" class="form-control" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg me-2"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

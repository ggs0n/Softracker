@model WFHMonitor.Models.ChangeRequest
@{
    ViewData["Title"] = Model.CrNumber;
    var resolvedRepoOwner = ViewBag.ResolvedGitHubOwner as string;
    var resolvedRepoName = ViewBag.ResolvedGitHubRepo as string;
    var resolvedRepoBranch = ViewBag.ResolvedGitHubBranch as string;
    var linkedBugs = ViewBag.LinkedBugs as IList<WFHMonitor.Models.BugReport> ?? new List<WFHMonitor.Models.BugReport>();
    var openClawScanAgentOptions = ViewBag.OpenClawScanAgentOptions as IList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var projectHealth = ViewBag.ProjectHealth as WFHMonitor.ViewModels.ProjectHealthViewModel;
    var hasProAccess = ViewBag.HasProAccess as bool? ?? false;
    var isOpenClawEnabled = ViewBag.IsOpenClawEnabled as bool? ?? true;
    var isBugScanQueued = Model.BugScanStatus == WFHMonitor.Models.ProjectBugScanStatus.Queued;
    var isBugScanProcessing = Model.BugScanStatus == WFHMonitor.Models.ProjectBugScanStatus.InProgress;
    var isBugScanRunning = isBugScanQueued || isBugScanProcessing;
    var repositoryFeatures = Model.RepositoryFeatures.OrderBy(f => f.Name).ToList();

    var stageItems = new List<(WFHMonitor.Models.CrStage Stage, string Label)>
    {
        (WFHMonitor.Models.CrStage.Development, "Development"),
        (WFHMonitor.Models.CrStage.Testing, "Testing"),
        (WFHMonitor.Models.CrStage.Deploy, "Deploy")
    };
    var normalizedStage = Model.Stage == WFHMonitor.Models.CrStage.ProjectStart
        ? WFHMonitor.Models.CrStage.Development
        : Model.Stage == WFHMonitor.Models.CrStage.DeploymentComplete
            ? WFHMonitor.Models.CrStage.Deploy
            : Model.Stage;
    var currentStageIndex = stageItems.FindIndex(s => s.Stage == normalizedStage);
}

<style>
    .pd-shell{max-width:1420px;margin:0 auto}

    /* Hero */
    .pd-hero{position:relative;background:var(--bg-dark);border:1px solid rgba(16,185,129,.18);border-radius:16px;padding:28px 32px 24px;margin-bottom:24px;overflow:hidden}
    .pd-hero::before{content:'';position:absolute;top:-60px;right:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(16,185,129,.12) 0%,transparent 70%);pointer-events:none}
    .pd-hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;position:relative;z-index:1}
    .pd-hero-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25);color:#34d399;font-size:.66rem;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
    .pd-hero-title{font-size:1.75rem;font-weight:800;color:#f4f5f7;letter-spacing:-.02em;line-height:1.15}
    .pd-hero-meta{font-size:.76rem;color:#a1a1aa;margin-top:3px;font-weight:500}
    .pd-hero-actions{display:flex;gap:8px;align-items:center;flex-shrink:0}
    .pd-btn-edit{background:rgba(251,191,36,.15);color:#fbbf24;border:1px solid rgba(251,191,36,.3);border-radius:10px;padding:8px 18px;font-size:.8rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .2s ease;text-decoration:none}
    .pd-btn-edit:hover{background:rgba(251,191,36,.25);color:#fbbf24;transform:translateY(-1px)}
    .pd-btn-del{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:8px 16px;font-size:.8rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .2s ease}
    .pd-btn-del:hover{background:rgba(239,68,68,.2);color:#f87171;transform:translateY(-1px)}

    /* Stage flow */
    .pd-stage-flow{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;align-items:center;position:relative;z-index:1}
    .pd-stage{font-size:.72rem;font-weight:700;border-radius:999px;padding:5px 13px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.06);color:#71717a;transition:all .2s ease}
    .pd-stage-done{background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.3);color:#34d399}
    .pd-stage-now{background:rgba(59,130,246,.15);border-color:rgba(59,130,246,.3);color:#60a5fa}
    .pd-stage-arrow{color:#52525b;font-size:.68rem}

    /* Grid */
    .pd-grid{display:grid;grid-template-columns:1fr 340px;gap:20px}

    /* Section cards */
    .pd-section{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;margin-bottom:20px;overflow:hidden;transition:box-shadow .2s ease}
    .pd-section:hover{box-shadow:0 8px 28px rgba(0,0,0,.06)}
    .pd-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 20px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,#fafbfc,#f6f7f9)}
    .pd-section-left{display:flex;align-items:center;gap:10px}
    .pd-section-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
    .pd-section-label{font-size:.82rem;font-weight:700;color:var(--text-primary);letter-spacing:.01em}
    .pd-section-body{padding:18px 20px}
    .pd-section-body-flush{padding:0}

    /* Description */
    .pd-desc{color:#52525b;font-size:.86rem;line-height:1.6;white-space:pre-wrap}

    /* Badges */
    .pd-badge{font-size:.7rem;font-weight:700;border-radius:999px;padding:3px 10px;border:1px solid transparent}
    .pd-badge-count{font-size:.66rem;font-weight:700;border-radius:999px;padding:2px 8px;background:#eef2f7;color:#71717a;margin-left:4px}

    /* Table */
    .pd-table{width:100%;border-collapse:collapse;font-size:.82rem}
    .pd-table th{font-size:.72rem;font-weight:700;color:#71717a;text-transform:uppercase;letter-spacing:.04em;padding:8px 10px;border-bottom:2px solid var(--border);background:#fafbfc}
    .pd-table td{padding:10px;border-bottom:1px solid var(--border);color:var(--text-secondary);vertical-align:middle}
    .pd-table tr:last-child td{border-bottom:none}
    .pd-table-link{font-weight:600;text-decoration:none;color:var(--text-primary);transition:color .15s ease}
    .pd-table-link:hover{color:var(--accent)}

    /* Status pill colors */
    .pd-st-draft{background:#eef2ff;color:#4f46e5;border-color:#c7d2fe}
    .pd-st-inreview{background:#e0f2fe;color:#0369a1;border-color:#bae6fd}
    .pd-st-approved{background:#dcfce7;color:#15803d;border-color:#bbf7d0}
    .pd-st-inprogress{background:#fef3c7;color:#b45309;border-color:#fde68a}
    .pd-st-done{background:#d1fae5;color:#047857;border-color:#a7f3d0}
    .pd-st-rejected{background:#fee2e2;color:#b91c1c;border-color:#fecaca}
    .pd-pr-low{background:#e8faf0;color:#0f766e;border-color:#b7f0df}
    .pd-pr-medium{background:#e5edff;color:#1d4ed8;border-color:#bfdbfe}
    .pd-pr-high{background:#fff4de;color:#b45309;border-color:#fde68a}
    .pd-pr-critical{background:#ffe4e6;color:#be123c;border-color:#fecdd3}

    /* Right side blocks */
    .pd-sblock{border:1px solid var(--border);border-radius:10px;padding:12px 14px;background:#fafbfc;margin-bottom:10px}
    .pd-sblock:last-child{margin-bottom:0}
    .pd-stitle{font-size:.66rem;text-transform:uppercase;letter-spacing:.07em;color:#71717a;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:5px}
    .pd-stext{font-size:.78rem;color:var(--text-secondary)}
    .pd-smuted{font-size:.74rem;color:#a1a1aa}
    .pd-slink{font-size:.78rem;text-decoration:none;display:flex;align-items:center;gap:6px;color:var(--accent);transition:color .15s ease}
    .pd-slink:hover{color:var(--accent-hover)}
    .pd-tech-tag{font-size:.72rem;font-weight:600;border-radius:999px;padding:3px 10px;background:#eef2f7;color:#52525b;border:1px solid var(--border);display:inline-block}
    .pd-pic-item{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border)}
    .pd-pic-item:last-child{border-bottom:none}
    .pd-pic-avatar{width:28px;height:28px;border-radius:999px;background:linear-gradient(135deg,#d1fae5,#a7f3d0);display:flex;align-items:center;justify-content:center;font-size:.72rem;color:#047857;font-weight:700}
    .pd-pic-name{font-size:.8rem;font-weight:600;color:var(--text-primary)}
    .pd-pic-role{font-size:.68rem;color:#a1a1aa}

    /* Commit list */
    .pd-commit{display:flex;align-items:start;gap:8px;padding:10px 14px;border-bottom:1px solid var(--border)}
    .pd-commit:last-child{border-bottom:none}
    .pd-commit-sha{font-family:Consolas,Monaco,monospace;font-size:.7rem;font-weight:700;background:var(--bg-dark);color:#e4e4e7;padding:3px 8px;border-radius:6px;text-decoration:none;transition:all .15s ease;flex-shrink:0}
    .pd-commit-sha:hover{background:var(--accent);color:#fff}
    .pd-commit-msg{font-size:.8rem;font-weight:600;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .pd-commit-meta{font-size:.7rem;color:#a1a1aa;margin-top:1px}

    /* Project health */
    .pd-health-score{font-size:2rem;font-weight:800;line-height:1;color:var(--text-primary)}
    .pd-health-label{font-size:.74rem;font-weight:700;border-radius:999px;padding:3px 10px;display:inline-flex;align-items:center;gap:6px;border:1px solid transparent}
    .pd-health-label.good{background:#dcfce7;color:#15803d;border-color:#bbf7d0}
    .pd-health-label.warn{background:#fef3c7;color:#b45309;border-color:#fde68a}
    .pd-health-label.bad{background:#fee2e2;color:#b91c1c;border-color:#fecaca}
    .pd-health-factor{font-size:.74rem;color:#52525b;padding:5px 0;border-bottom:1px dashed var(--border)}
    .pd-health-factor:last-child{border-bottom:none}

    /* Upload area */
    .pd-upload-area{border:1px dashed #d1d5db;border-radius:10px;padding:14px 16px;background:#fafbfc}
    .pd-upload-btn{background:var(--accent);color:#fff;border:none;border-radius:8px;padding:7px 16px;font-size:.78rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .2s ease}
    .pd-upload-btn:hover{background:var(--accent-hover)}

    /* Doc list */
    .pd-doc-item{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border)}
    .pd-doc-item:last-child{border-bottom:none}
    .pd-doc-link{font-size:.82rem;font-weight:600;text-decoration:none;color:var(--text-primary);transition:color .15s ease}
    .pd-doc-link:hover{color:var(--accent)}
    .pd-doc-date{font-size:.7rem;color:#a1a1aa}

    /* Bug scan */
    .pd-scan-bar{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border);background:#fafbfc}
    .pd-scan-dot{width:8px;height:8px;border-radius:999px;background:#71717a;flex-shrink:0}
    .pd-scan-dot.is-queued{background:#f59e0b;box-shadow:0 0 0 0 rgba(245,158,11,.35)}
    .pd-scan-dot.is-pulsing{background:#3b82f6;animation:pdPulse 1.25s infinite}
    @@keyframes pdPulse{0%{box-shadow:0 0 0 0 rgba(59,130,246,.7)}70%{box-shadow:0 0 0 10px rgba(59,130,246,0)}100%{box-shadow:0 0 0 0 rgba(59,130,246,0)}}

    /* Action buttons */
    .pd-act{width:30px;height:30px;border-radius:8px;border:1px solid #d1d5db;color:#71717a;background:#fff;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;transition:all .15s ease;font-size:.8rem}
    .pd-act:hover{background:#f8fafc;color:#111827;border-color:#a1a1aa}
    .pd-act-del:hover{border-color:#fecaca;color:#dc2626;background:#fef2f2}

    /* Bug scan action */
    .pd-scan-select{background:#fff;border:1px solid #d1d5db;border-radius:8px;padding:5px 10px;font-size:.76rem;color:var(--text-primary);font-family:inherit}
    .pd-scan-btn{background:var(--bg-dark);color:#e4e4e7;border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:6px 14px;font-size:.76rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .15s ease}
    .pd-scan-btn:hover{background:#27272a;color:#f4f5f7}
    .pd-scan-btn:disabled{opacity:.55;cursor:not-allowed}

    /* Feature view btn */
    .pd-btn-outline{border:1px solid #d1d5db;border-radius:8px;padding:6px 14px;font-size:.76rem;font-weight:600;color:#52525b;background:#fff;display:inline-flex;align-items:center;gap:5px;text-decoration:none;transition:all .15s ease;cursor:pointer}
    .pd-btn-outline:hover{border-color:#a1a1aa;color:#111827;background:#f8fafc}
    .pd-btn-outline-accent{border-color:rgba(16,185,129,.35);color:var(--accent)}
    .pd-btn-outline-accent:hover{background:var(--accent-bg);border-color:var(--accent);color:var(--accent)}

    /* Back button */
    .pd-btn-back{background:transparent;color:#a1a1aa;border:1px solid var(--border);border-radius:10px;padding:9px 20px;font-size:.82rem;font-weight:600;cursor:pointer;transition:all .2s ease;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .pd-btn-back:hover{border-color:var(--text-secondary);color:var(--text-primary)}

    /* Empty state */
    .pd-empty{font-size:.8rem;color:#a1a1aa;font-style:italic;padding:4px 0}

    /* Sync warning */
    .pd-alert{background:rgba(251,191,36,.08);border:1px solid rgba(251,191,36,.25);border-radius:10px;padding:10px 16px;font-size:.8rem;color:#b45309;margin-bottom:16px;display:flex;align-items:center;gap:8px}

    @@media(max-width:991px){
        .pd-grid{grid-template-columns:1fr}
        .pd-hero-title{font-size:1.4rem}
        .pd-hero{padding:22px 18px 20px}
    }
</style>

<div class="pd-shell">
    @if (ViewBag.SyncWarning != null)
    {
        <div class="pd-alert">
            <i class="bi bi-exclamation-triangle"></i>Auto-sync warning: @ViewBag.SyncWarning
        </div>
    }

    @* ── Hero ── *@
    <section class="pd-hero">
        <div class="pd-hero-top">
            <div>
                <div class="pd-hero-badge"><i class="bi bi-folder2-open"></i> @Model.CrNumber</div>
                <div class="pd-hero-title">@Model.Title</div>
                <div class="pd-hero-meta">
                    Created @Model.CreatedAt.ToString("MMM dd, yyyy")
                    @if (Model.OrgTeam != null)
                    {
                        <span>&middot; @Model.OrgTeam.Name</span>
                    }
                </div>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="pd-hero-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="pd-btn-edit">
                        <i class="bi bi-pencil"></i> Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Delete @Model.CrNumber?')">
                        @Html.AntiForgeryToken()
                        <button class="pd-btn-del"><i class="bi bi-trash"></i> Delete</button>
                    </form>
                </div>
            }
        </div>
        <div class="pd-stage-flow">
            @for (var i = 0; i < stageItems.Count; i++)
            {
                var isComplete = i < currentStageIndex;
                var isCurrent = i == currentStageIndex;
                var cls = isCurrent ? "pd-stage-now" : isComplete ? "pd-stage-done" : "";
                <span class="pd-stage @cls">@stageItems[i].Label</span>
                if (i < stageItems.Count - 1)
                {
                    <i class="bi bi-chevron-right pd-stage-arrow"></i>
                }
            }
        </div>
    </section>

    @* ── Grid ── *@
    <div class="pd-grid">

        @* ═══ Left Column ═══ *@
        <div>

            @* Description *@
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="pd-section">
                    <div class="pd-section-head">
                        <div class="pd-section-left">
                            <div class="pd-section-icon" style="background:#eef2ff;color:#6366f1"><i class="bi bi-card-text"></i></div>
                            <div class="pd-section-label">Description</div>
                        </div>
                    </div>
                    <div class="pd-section-body">
                        <div class="pd-desc">@Model.Description</div>
                    </div>
                </div>
            }

            @* Additional Documents *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#fef3c7;color:#d97706"><i class="bi bi-paperclip"></i></div>
                        <div class="pd-section-label">Additional Documents <span class="pd-badge-count">@Model.Documents.Count</span></div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <button class="pd-btn-outline" type="button" data-bs-toggle="collapse" data-bs-target="#docUploadForm">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                    }
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="collapse" id="docUploadForm">
                        <div class="pd-section-body" style="border-bottom:1px solid var(--border)">
                            <form asp-action="UploadDocument" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                                <div class="pd-upload-area">
                                    <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
                                        <div style="flex:1;min-width:200px">
                                            <label style="font-size:.74rem;font-weight:600;color:#52525b;margin-bottom:4px;display:block">Document File <span style="color:#ef4444">*</span></label>
                                            <input type="file" name="file" class="form-control form-control-sm" style="border:1px solid #d1d5db;border-radius:8px;font-size:.8rem" required />
                                            <div style="font-size:.68rem;color:#a1a1aa;margin-top:3px">PDF, Word, Excel, PowerPoint, TXT — max 20 MB</div>
                                        </div>
                                        <button type="submit" class="pd-upload-btn"><i class="bi bi-upload"></i> Upload</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <div class="pd-section-body-flush">
                    @if (!Model.Documents.Any())
                    {
                        <div style="padding:14px 20px"><span class="pd-empty">No documents uploaded yet.</span></div>
                    }
                    else
                    {
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="pd-doc-item">
                                <div style="display:flex;align-items:center;gap:8px">
                                    <i class="bi bi-file-earmark-text" style="color:#a1a1aa"></i>
                                    <a href="/uploads/docs/@doc.FileName" target="_blank" class="pd-doc-link">@doc.OriginalFileName</a>
                                    <span class="pd-doc-date">@doc.UploadedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this document?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <input type="hidden" name="crId" value="@Model.Id" />
                                        <button type="submit" class="pd-act pd-act-del"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @* Project Features *@
            @{
                var features = Model.Features.OrderBy(f => f.Name).ToList();
                var statusClsMap = new Dictionary<string, string> {
                    {"Draft","pd-st-draft"}, {"InReview","pd-st-inreview"}, {"Approved","pd-st-approved"},
                    {"InProgress","pd-st-inprogress"}, {"Done","pd-st-done"}, {"Rejected","pd-st-rejected"}
                };
                var priorClsMap = new Dictionary<string, string> {
                    {"Low","pd-pr-low"}, {"Medium","pd-pr-medium"}, {"High","pd-pr-high"}, {"Critical","pd-pr-critical"}
                };
            }
            <div class="pd-section" id="projectFeaturesCard">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-list-check"></i></div>
                        <div class="pd-section-label">Project Features <span class="pd-badge-count">@features.Count</span></div>
                    </div>
                    <div style="display:flex;gap:6px">
                        <a asp-action="Features" asp-route-projectId="@Model.Id" class="pd-btn-outline">
                            <i class="bi bi-grid"></i> Feature View
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="CreateFeature"
                               asp-route-projectId="@Model.Id"
                               asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                               class="pd-btn-outline pd-btn-outline-accent">
                                <i class="bi bi-plus-lg"></i> Add Feature
                            </a>
                        }
                    </div>
                </div>

                <div class="pd-section-body-flush">
                    @if (features.Count > 0)
                    {
                        <div style="overflow-x:auto">
                            <table class="pd-table">
                                <thead>
                                    <tr>
                                        <th>Feature #</th>
                                        <th>Feature</th>
                                        <th>Status</th>
                                        <th>Priority</th>
                                        <th>Stage</th>
                                        <th>Assignee</th>
                                        <th>Timeline</th>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <th style="text-align:right">Action</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var feature in features)
                                    {
                                        var timelineText = feature.TimelineStart.HasValue || feature.TimelineEnd.HasValue
                                            ? $"{feature.TimelineStart?.ToString("dd MMM yyyy") ?? "-"} to {feature.TimelineEnd?.ToString("dd MMM yyyy") ?? "-"}"
                                            : "-";
                                        var stKey = feature.Status.ToString();
                                        var prKey = feature.Priority.ToString();
                                        <tr>
                                            <td><span style="font-family:Consolas,monospace;font-size:.74rem;font-weight:700;color:var(--accent)">@feature.FeatureNumber</span></td>
                                            <td>
                                                <a asp-action="FeatureDetails" asp-route-featureId="@feature.Id" class="pd-table-link">@feature.Name</a>
                                                @if (!string.IsNullOrWhiteSpace(feature.Description))
                                                {
                                                    <div style="font-size:.74rem;color:#a1a1aa;margin-top:2px">@feature.Description</div>
                                                }
                                            </td>
                                            <td><span class="pd-badge @(statusClsMap.ContainsKey(stKey) ? statusClsMap[stKey] : "")">@feature.Status</span></td>
                                            <td><span class="pd-badge @(priorClsMap.ContainsKey(prKey) ? priorClsMap[prKey] : "")">@feature.Priority</span></td>
                                            <td><span style="font-size:.72rem;font-weight:600;color:#71717a">@feature.Stage</span></td>
                                            <td style="font-size:.8rem">@(feature.AssignedDeveloper?.FullName ?? "Unassigned")</td>
                                            <td style="font-size:.74rem;color:#a1a1aa">@timelineText</td>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <td style="text-align:right;white-space:nowrap">
                                                    <a asp-action="EditFeature"
                                                       asp-route-featureId="@feature.Id"
                                                       asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                                                       class="pd-act" title="Edit feature" style="margin-right:4px">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <form asp-action="DeleteFeature" method="post" class="d-inline"
                                                          onsubmit="return confirm('Remove this feature?')">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="featureId" value="@feature.Id" />
                                                        <button type="submit" class="pd-act pd-act-del"><i class="bi bi-trash"></i></button>
                                                    </form>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="padding:14px 20px"><span class="pd-empty">No features tracked yet. Use "Add Feature" to get started.</span></div>
                    }
                </div>
            </div>

            @* Linked Bugs *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#fee2e2;color:#dc2626"><i class="bi bi-bug"></i></div>
                        <div class="pd-section-label">Linked Bugs <span class="pd-badge-count">@linkedBugs.Count</span></div>
                    </div>
                    <div style="display:flex;align-items:center;gap:8px">
                        @if (isOpenClawEnabled)
                        {
                            @if (hasProAccess && (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer")))
                            {
                                <form asp-action="FindBugs" asp-route-id="@Model.Id" method="post" style="display:flex;align-items:center;gap:6px">
                                    @Html.AntiForgeryToken()
                                    <select name="scanAgentId" class="pd-scan-select">
                                        @foreach (var option in openClawScanAgentOptions)
                                        {
                                            <option value="@option.Value" selected="@(option.Value == Model.BugScanAgentId ? "selected" : null)">
                                                @option.Text
                                            </option>
                                        }
                                    </select>
                                    <button type="submit" class="pd-scan-btn" @(isBugScanRunning ? "disabled" : null)>
                                        @if (isBugScanProcessing)
                                        {
                                            <span><i class="bi bi-arrow-repeat"></i> Scanning...</span>
                                        }
                                        else if (isBugScanQueued)
                                        {
                                            <span><i class="bi bi-clock-history"></i> Queued...</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-cpu"></i> Find Bugs</span>
                                        }
                                    </button>
                                </form>
                            }
                            else if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
                            {
                                <a asp-controller="Payment" asp-action="Index" class="pd-btn-outline" style="color:#d97706;border-color:rgba(217,119,6,.35)">
                                    <i class="bi bi-stars"></i> Upgrade to Pro
                                </a>
                            }
                        }
                    </div>
                </div>
                @if (isOpenClawEnabled)
                {
                    <div class="pd-scan-bar">
                        <div style="display:flex;align-items:center;gap:8px;font-size:.78rem;font-weight:600;color:#52525b">
                            <span class="pd-scan-dot @(isBugScanProcessing ? "is-pulsing" : (isBugScanQueued ? "is-queued" : ""))"></span>
                            Find Bugs Status: @Model.BugScanStatus
                        </div>
                        @if (Model.BugScanLastRunAt.HasValue)
                        {
                            <span style="font-size:.7rem;color:#a1a1aa">Updated @Model.BugScanLastRunAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.BugScanLastMessage))
                    {
                        <div style="padding:8px 14px;font-size:.76rem;color:#a1a1aa;border-bottom:1px solid var(--border)">@Model.BugScanLastMessage</div>
                    }
                }
                <div class="pd-section-body-flush">
                    @if (!linkedBugs.Any())
                    {
                        <div style="padding:14px 20px"><span class="pd-empty">No bugs linked to this project.</span></div>
                    }
                    else
                    {
                        <div style="overflow-x:auto">
                            <table class="pd-table">
                                <thead>
                                    <tr>
                                        <th>Bug #</th>
                                        <th>Title</th>
                                        <th>Status</th>
                                        <th>Assigned</th>
                                        <th>Created</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bug in linkedBugs)
                                    {
                                        <tr>
                                            <td style="font-family:Consolas,monospace;font-size:.74rem;color:#71717a">@bug.BugNumber</td>
                                            <td>
                                                <a asp-controller="Bug" asp-action="Details" asp-route-id="@bug.Id" class="pd-table-link">@bug.Title</a>
                                            </td>
                                            <td>
                                                @{var bugStKey = bug.Status.ToString();}
                                                <span class="pd-badge @(statusClsMap.ContainsKey(bugStKey) ? statusClsMap[bugStKey] : "")">@bug.Status</span>
                                            </td>
                                            <td style="font-size:.8rem">
                                                @if (bug.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent)
                                                {
                                                    <span>Agent (@bug.AgentStatus)</span>
                                                }
                                                else
                                                {
                                                    <span>@(bug.AssignedDeveloper?.FullName ?? "Unassigned")</span>
                                                }
                                            </td>
                                            <td style="font-size:.74rem;color:#a1a1aa">@bug.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            @* GitHub Commits *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#f3f4f6;color:#374151"><i class="bi bi-git"></i></div>
                        <div class="pd-section-label">
                            GitHub Commits
                            @if (!string.IsNullOrEmpty(resolvedRepoBranch))
                            {
                                <span style="font-family:Consolas,monospace;font-size:.66rem;font-weight:500;color:#a1a1aa;margin-left:6px">@resolvedRepoBranch</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="pd-section-body-flush">
                    @if (string.IsNullOrEmpty(resolvedRepoOwner) || string.IsNullOrEmpty(resolvedRepoName) || string.IsNullOrEmpty(resolvedRepoBranch))
                    {
                        <div style="padding:14px 20px"><span class="pd-empty">No GitHub branch linked.</span></div>
                    }
                    else if (ViewBag.CommitError != null)
                    {
                        <div style="padding:14px 20px">
                            <div class="pd-alert" style="margin-bottom:0">
                                <i class="bi bi-exclamation-triangle"></i> @ViewBag.CommitError
                            </div>
                        </div>
                    }
                    else if (ViewBag.Commits == null || ((IList<WFHMonitor.Services.GitHubCommit>)ViewBag.Commits).Count == 0)
                    {
                        <div style="padding:14px 20px"><span class="pd-empty">No commits found on this branch.</span></div>
                    }
                    else
                    {
                        @foreach (var commit in (IList<WFHMonitor.Services.GitHubCommit>)ViewBag.Commits)
                        {
                            <div class="pd-commit">
                                <a href="@commit.Url" target="_blank" class="pd-commit-sha">@commit.Sha</a>
                                <div style="flex:1;overflow:hidden">
                                    <div class="pd-commit-msg" title="@commit.Message">@commit.Message</div>
                                    <div class="pd-commit-meta">@commit.AuthorName &middot; @commit.Date.ToString("MMM dd, yyyy HH:mm")</div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        @* ═══ Right Column ═══ *@
        <div>

            @* Project Health *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#ecfeff;color:#0e7490"><i class="bi bi-heart-pulse"></i></div>
                        <div class="pd-section-label">Project Health</div>
                    </div>
                    @if (isOpenClawEnabled && hasProAccess && (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer")))
                    {
                        <form asp-action="AnalyzeHealth" method="post" style="display:flex;align-items:center;gap:6px">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="scanAgentId" class="pd-scan-select">
                                @foreach (var option in openClawScanAgentOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == (ViewBag.HealthOpenClawAgentId as string) ? "selected" : null)">
                                        @option.Text
                                    </option>
                                }
                            </select>
                            <button type="submit" class="pd-scan-btn" title="Analyze with OpenClaw">
                                <i class="bi bi-cpu"></i> Analyze
                            </button>
                        </form>
                    }
                </div>
                <div class="pd-section-body">
                    @{
                        var health = projectHealth ?? new WFHMonitor.ViewModels.ProjectHealthViewModel();
                        var healthLabelLower = (health.Label ?? string.Empty).ToLowerInvariant();
                        var healthClass = healthLabelLower.Contains("critical")
                            ? "bad"
                            : healthLabelLower.Contains("risk")
                                ? "warn"
                                : "good";
                    }
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:4px">
                        <div class="pd-health-score">@health.Score%</div>
                        <span class="pd-health-label @healthClass">@health.Label</span>
                    </div>
                    <div style="font-size:.68rem;color:#a1a1aa;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px">Health Score (Percentage)</div>
                    <div style="font-size:.78rem;color:#52525b;margin-bottom:8px">
                        @(string.IsNullOrWhiteSpace(health.Summary) ? "Health analysis is not available yet." : health.Summary)
                    </div>
                    <div class="pd-sblock" style="padding:9px 12px;margin-bottom:8px">
                        <div class="pd-stitle"><i class="bi bi-diagram-3"></i> Complexity</div>
                        <div style="font-size:.82rem;font-weight:700;color:var(--text-primary)">@(string.IsNullOrWhiteSpace(health.Complexity) ? "Medium" : health.Complexity)</div>
                    </div>
                    @if (health.Factors.Any())
                    {
                        foreach (var factor in health.Factors.Take(5))
                        {
                            <div class="pd-health-factor">@factor</div>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(health.Error))
                    {
                        <div style="font-size:.72rem;color:#b45309;margin-top:8px">
                            <i class="bi bi-exclamation-triangle"></i> OpenClaw health analysis fallback used: @health.Error
                        </div>
                    }
                    @if (health.AnalyzedAtUtc.HasValue)
                    {
                        <div style="font-size:.7rem;color:#a1a1aa;margin-top:8px">
                            Updated @health.AnalyzedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                            @if (health.UsedOpenClaw)
                            {
                                <span>&middot; OpenClaw analyzed</span>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Links & Technology *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#e0f2fe;color:#0284c7"><i class="bi bi-link-45deg"></i></div>
                        <div class="pd-section-label">Links</div>
                    </div>
                </div>
                <div class="pd-section-body">
                    <div style="margin-bottom:12px">
                        <div class="pd-stitle"><i class="bi bi-cpu"></i> Technology / Languages</div>
                        @if (!string.IsNullOrWhiteSpace(Model.TechnologyStack))
                        {
                            var technologies = Model.TechnologyStack.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                            <div style="display:flex;flex-wrap:wrap;gap:5px">
                                @foreach (var tech in technologies)
                                {
                                    <span class="pd-tech-tag">@tech</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="pd-empty">No technology data.</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.FigmaLink))
                    {
                        <a href="@Model.FigmaLink" target="_blank" class="pd-slink" style="margin-top:8px">
                            <i class="bi bi-vector-pen"></i> Open Figma Design <i class="bi bi-box-arrow-up-right" style="font-size:.68rem;margin-left:auto"></i>
                        </a>
                    }
                    else
                    {
                        <span class="pd-empty">No Figma link.</span>
                    }

                    @if (!string.IsNullOrEmpty(Model.ArchSpecLink))
                    {
                        <a href="@Model.ArchSpecLink" target="_blank" class="pd-slink" style="margin-top:8px">
                            <i class="bi bi-diagram-3"></i> Architecture Spec <i class="bi bi-box-arrow-up-right" style="font-size:.68rem;margin-left:auto"></i>
                        </a>
                    }
                </div>
            </div>

            @* Timeline *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#fce7f3;color:#db2777"><i class="bi bi-calendar-range"></i></div>
                        <div class="pd-section-label">Timeline</div>
                    </div>
                </div>
                <div class="pd-section-body">
                    @if (Model.TimelineStart.HasValue || Model.TimelineEnd.HasValue)
                    {
                        <div style="display:flex;align-items:center;gap:14px">
                            <div>
                                <div style="font-size:.68rem;color:#a1a1aa;font-weight:600;text-transform:uppercase;letter-spacing:.04em">Start</div>
                                <div style="font-size:.88rem;font-weight:700;color:var(--text-primary)">@(Model.TimelineStart?.ToString("MMM dd, yyyy") ?? "—")</div>
                            </div>
                            <i class="bi bi-arrow-right" style="color:#d1d5db"></i>
                            <div>
                                <div style="font-size:.68rem;color:#a1a1aa;font-weight:600;text-transform:uppercase;letter-spacing:.04em">End</div>
                                <div style="font-size:.88rem;font-weight:700;color:var(--text-primary)">@(Model.TimelineEnd?.ToString("MMM dd, yyyy") ?? "—")</div>
                            </div>
                        </div>
                        @if (Model.TimelineStart.HasValue && Model.TimelineEnd.HasValue)
                        {
                            var days = (Model.TimelineEnd.Value - Model.TimelineStart.Value).Days;
                            <div style="margin-top:8px;font-size:.74rem;color:#a1a1aa">Duration: @days day(s)</div>
                        }
                    }
                    else
                    {
                        <span class="pd-empty">No timeline set.</span>
                    }
                </div>
            </div>

            @* Repository *@
            @if (!string.IsNullOrEmpty(resolvedRepoOwner) || !string.IsNullOrEmpty(resolvedRepoName) || !string.IsNullOrEmpty(Model.GitHubRepoUrl))
            {
                <div class="pd-section">
                    <div class="pd-section-head">
                        <div class="pd-section-left">
                            <div class="pd-section-icon" style="background:#f3f4f6;color:#374151"><i class="bi bi-github"></i></div>
                            <div class="pd-section-label">Repository</div>
                        </div>
                    </div>
                    <div class="pd-section-body">
                        @if (!string.IsNullOrEmpty(resolvedRepoOwner) && !string.IsNullOrEmpty(resolvedRepoName))
                        {
                            <div class="pd-sblock">
                                <div class="pd-stitle"><i class="bi bi-folder"></i> Repo</div>
                                <div style="font-family:Consolas,monospace;font-size:.82rem;font-weight:700;color:var(--text-primary)">@resolvedRepoOwner/@resolvedRepoName</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.GitHubRepoUrl))
                        {
                            <div style="margin-top:8px">
                                <a href="@Model.GitHubRepoUrl" target="_blank" rel="noopener" class="pd-slink">
                                    <i class="bi bi-box-arrow-up-right"></i> Open Repository
                                </a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(resolvedRepoBranch))
                        {
                            <div class="pd-sblock" style="margin-top:8px">
                                <div class="pd-stitle"><i class="bi bi-signpost-split"></i> Branch</div>
                                <div style="font-family:Consolas,monospace;font-size:.82rem;font-weight:700;color:var(--text-primary)">@resolvedRepoBranch</div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Repository Scan Features *@
            <div class="pd-section" id="repositoryFeaturesCard">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#ede9fe;color:#7c3aed"><i class="bi bi-search"></i></div>
                        <div class="pd-section-label">Repo Scan Features <span class="pd-badge-count">@repositoryFeatures.Count</span></div>
                    </div>
                </div>
                <div class="pd-section-body-flush">
                    @if (repositoryFeatures.Count > 0)
                    {
                        @foreach (var feature in repositoryFeatures)
                        {
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border)">
                                <span style="font-size:.82rem;font-weight:600;color:var(--text-primary)">@feature.Name</span>
                                <span style="font-size:.7rem;color:#a1a1aa">@feature.UpdatedAt.ToString("dd MMM yyyy")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding:14px 20px"><span class="pd-empty">No repository scan features yet.</span></div>
                    }
                </div>
            </div>

            @* PIC *@
            <div class="pd-section">
                <div class="pd-section-head">
                    <div class="pd-section-left">
                        <div class="pd-section-icon" style="background:#fef3c7;color:#d97706"><i class="bi bi-people"></i></div>
                        <div class="pd-section-label">Person in Charge</div>
                    </div>
                </div>
                <div class="pd-section-body">
                    @if (Model.Pics.Any())
                    {
                        @foreach (var pic in Model.Pics)
                        {
                            <div class="pd-pic-item">
                                <div class="pd-pic-avatar">@(pic.Employee?.FullName?.Substring(0, 1).ToUpper() ?? "?")</div>
                                <div>
                                    <div class="pd-pic-name">@pic.Employee?.FullName</div>
                                    @if (!string.IsNullOrEmpty(pic.Role))
                                    {
                                        <div class="pd-pic-role">@pic.Role</div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="pd-empty">No PIC assigned.</span>
                    }
                </div>
            </div>

        </div>
    </div>

    @* Back *@
    <div style="margin-top:16px">
        <a asp-action="Index" class="pd-btn-back">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@section Scripts {
    @if (isOpenClawEnabled && isBugScanRunning)
    {
        <script>
            setTimeout(function () {
                window.location.reload();
            }, 7000);
        </script>
    }
}

@model WFHMonitor.Models.ChangeRequest
@{
    ViewData["Title"] = Model.CrNumber;
    var resolvedRepoOwner = ViewBag.ResolvedGitHubOwner as string;
    var resolvedRepoName = ViewBag.ResolvedGitHubRepo as string;
    var resolvedRepoBranch = ViewBag.ResolvedGitHubBranch as string;
    var linkedBugs = ViewBag.LinkedBugs as IList<WFHMonitor.Models.BugReport> ?? new List<WFHMonitor.Models.BugReport>();

    var statColors = new Dictionary<string, string> {
        {"Draft","secondary"}, {"InReview","info"}, {"Approved","primary"},
        {"InProgress","warning"}, {"Done","success"}, {"Rejected","danger"}
    };
    var prioColors = new Dictionary<string, string> {
        {"Low","success"}, {"Medium","primary"}, {"High","warning"}, {"Critical","danger"}
    };
    var sColor = statColors.GetValueOrDefault(Model.Status.ToString(), "secondary");
    var pColor = prioColors.GetValueOrDefault(Model.Priority.ToString(), "secondary");
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <span class="text-muted small">@Model.CrNumber</span>
        <h2 class="mb-1 mt-1">@Model.Title</h2>
        <div class="d-flex gap-2">
            <span class="badge bg-@sColor">@Model.Status</span>
            <span class="badge bg-@pColor">@Model.Priority</span>
            <span class="text-muted small">Created @Model.CreatedAt.ToString("MMM dd, yyyy") by @Model.CreatedBy?.FullName</span>
        </div>
        @{
            var stageItems = new List<(WFHMonitor.Models.CrStage Stage, string Label)>
            {
                (WFHMonitor.Models.CrStage.ProjectStart, "Project Start"),
                (WFHMonitor.Models.CrStage.Development, "Development"),
                (WFHMonitor.Models.CrStage.Testing, "Testing"),
                (WFHMonitor.Models.CrStage.Deploy, "Deploy"),
                (WFHMonitor.Models.CrStage.DeploymentComplete, "Deployment Complete")
            };
            var currentStageIndex = stageItems.FindIndex(s => s.Stage == Model.Stage);
        }
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mt-2 text-center">
            @for (var i = 0; i < stageItems.Count; i++)
            {
                var isComplete = i < currentStageIndex;
                var isCurrent = i == currentStageIndex;
                var badgeClass = isCurrent ? "bg-primary" : isComplete ? "bg-success" : "bg-light text-muted border";
                <span class="badge @badgeClass fs-6 px-3 py-2">@stageItems[i].Label</span>
                if (i < stageItems.Count - 1)
                {
                    <i class="bi bi-chevron-right text-muted"></i>
                }
            }
        </div>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Delete @Model.CrNumber?')">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        </div>
    }
</div>

<div class="row g-4">
    @* Left column *@
    <div class="col-lg-8">

        @* Description *@
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-card-text me-2"></i>Description
                </div>
                <div class="card-body" style="white-space:pre-wrap;">@Model.Description</div>
            </div>
        }

        @* Architect Spec Preview *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-diagram-3 me-2"></i>Solution Architect Spec
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ArchSpecLink))
                {
                    <div class="mb-3">
                        <span class="text-muted small d-block mb-1">Spec / Diagram Link</span>
                        <a href="@Model.ArchSpecLink" target="_blank" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-box-arrow-up-right me-2"></i>Open SA Spec / Diagram
                        </a>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ArchSpecNotes))
                {
                    <div class="border rounded p-3 bg-light small" style="white-space:pre-wrap; font-family:monospace;">@Model.ArchSpecNotes</div>
                }
                @if (string.IsNullOrEmpty(Model.ArchSpecLink) && string.IsNullOrEmpty(Model.ArchSpecNotes))
                {
                    <p class="text-muted fst-italic mb-0">No architect spec attached.</p>
                }
            </div>
        </div>

        @* Architect Spec Images *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-images me-2"></i>Architect Spec Images</span>
                @if (User.IsInRole("Admin"))
                {
                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#uploadForm">
                        <i class="bi bi-upload me-1"></i>Upload Image
                    </button>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="collapse" id="uploadForm">
                    <div class="card-body border-bottom">
                        <form asp-action="UploadImage" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold small">Image File <span class="text-danger">*</span></label>
                                    <input type="file" name="file" accept="image/*" class="form-control form-control-sm" required />
                                    <div class="text-muted" style="font-size:0.72rem;">JPG, PNG, GIF, WEBP — max 10 MB</div>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold small">Caption</label>
                                    <input type="text" name="caption" class="form-control form-control-sm" placeholder="e.g. System Architecture Overview" maxlength="500" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-upload me-1"></i>Upload
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card-body @(!Model.ArchSpecImages.Any() ? "" : "p-0")">
                @if (!Model.ArchSpecImages.Any())
                {
                    <p class="text-muted fst-italic mb-0">No images uploaded yet.</p>
                }
                else
                {
                    <div class="row g-0">
                        @foreach (var img in Model.ArchSpecImages)
                        {
                            <div class="col-md-6 col-lg-4 p-2">
                                <div class="card h-100 border">
                                    <a href="/uploads/archspec/@img.FileName" target="_blank"
                                       data-bs-toggle="modal" data-bs-target="#imgModal"
                                       data-img="/uploads/archspec/@img.FileName"
                                       data-caption="@img.Caption">
                                        <img src="/uploads/archspec/@img.FileName"
                                             class="card-img-top img-fluid"
                                             style="height:auto; object-fit:contain; cursor:zoom-in; background:#f8f9fa;"
                                             alt="@img.Caption" />
                                    </a>
                                    @if (!string.IsNullOrEmpty(img.Caption))
                                    {
                                        <div class="card-body py-2 px-3">
                                            <p class="card-text small mb-0">@img.Caption</p>
                                        </div>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="card-footer p-1 text-end bg-transparent border-top">
                                            <form asp-action="DeleteImage" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this image?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="imageId" value="@img.Id" />
                                                <input type="hidden" name="crId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Additional Documents *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-paperclip me-2"></i>Additional Documents</span>
                @if (User.IsInRole("Admin"))
                {
                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#docUploadForm">
                        <i class="bi bi-upload me-1"></i>Upload Document
                    </button>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="collapse" id="docUploadForm">
                    <div class="card-body border-bottom">
                        <form asp-action="UploadDocument" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-9">
                                    <label class="form-label fw-semibold small">Document File <span class="text-danger">*</span></label>
                                    <input type="file" name="file" class="form-control form-control-sm" required />
                                    <div class="text-muted" style="font-size:0.72rem;">PDF, Word, Excel, PowerPoint, TXT - max 20 MB</div>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-upload me-1"></i>Upload
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card-body p-0">
                @if (!Model.Documents.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">No documents uploaded yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text text-muted"></i>
                                    <a href="/uploads/docs/@doc.FileName" target="_blank">@doc.OriginalFileName</a>
                                    <span class="text-muted small">@doc.UploadedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this document?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <input type="hidden" name="crId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @* Features Checklist *@
        @{
            var features = Model.Features.OrderBy(f => f.Name).ToList();
            var completedCount = features.Count(f => f.IsCompleted);
            var featurePercent = features.Count == 0 ? 0 : (int)Math.Round(completedCount * 100.0 / features.Count);
            var hasGitHub = !string.IsNullOrEmpty(ViewBag.ResolvedGitHubOwner as string)
                            && !string.IsNullOrEmpty(ViewBag.ResolvedGitHubRepo as string);
        }
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-list-check me-2"></i>Features Checklist
                    <span class="badge bg-secondary ms-1">@completedCount/@features.Count</span>
                </span>
                <div class="d-flex gap-2">
                    @if (User.IsInRole("Admin") && hasGitHub)
                    {
                        <form asp-action="ScanFeatures" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-success">
                                <i class="bi bi-radar me-1"></i>Scan Repo
                            </button>
                        </form>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <button class="btn btn-sm btn-outline-primary" type="button"
                                data-bs-toggle="collapse" data-bs-target="#addFeatureForm">
                            <i class="bi bi-plus-lg me-1"></i>Add Feature
                        </button>
                    }
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="collapse" id="addFeatureForm">
                    <div class="card-body border-bottom">
                        <form asp-action="AddFeature" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="crId" value="@Model.Id" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold small">Feature Name <span class="text-danger">*</span></label>
                                    <input type="text" name="name" class="form-control form-control-sm"
                                           placeholder="e.g. Shopping Cart" maxlength="200" required />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label fw-semibold small">Description</label>
                                    <input type="text" name="description" class="form-control form-control-sm"
                                           placeholder="Optional notes" maxlength="500" />
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-plus-lg me-1"></i>Add
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card-body">
                @if (features.Count > 0)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="progress flex-grow-1" style="height:8px">
                            <div class="progress-bar @(featurePercent == 100 ? "bg-success" : featurePercent >= 50 ? "bg-primary" : "bg-warning")"
                                 role="progressbar" style="width:@(featurePercent)%"></div>
                        </div>
                        <small class="text-nowrap fw-semibold">@featurePercent%</small>
                    </div>

                    <ul class="list-group list-group-flush">
                        @foreach (var feature in features)
                        {
                            <li class="list-group-item d-flex align-items-center justify-content-between px-0 py-2">
                                <div class="d-flex align-items-center gap-2">
                                    <form asp-action="ToggleFeature" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="featureId" value="@feature.Id" />
                                        <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent"
                                                title="Toggle completion">
                                            @if (feature.IsCompleted)
                                            {
                                                <i class="bi bi-check-square-fill text-success fs-5"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-square text-muted fs-5"></i>
                                            }
                                        </button>
                                    </form>
                                    <div>
                                        <span class="@(feature.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold")">
                                            @feature.Name
                                        </span>
                                        @if (feature.IsAutoDetected)
                                        {
                                            <span class="badge bg-info ms-1" style="font-size:0.65rem">Auto</span>
                                        }
                                        @if (!string.IsNullOrEmpty(feature.Description))
                                        {
                                            <div class="text-muted small">@feature.Description</div>
                                        }
                                    </div>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="DeleteFeature" method="post" class="d-inline"
                                          onsubmit="return confirm('Remove this feature?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="featureId" value="@feature.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">No features tracked yet. Use "Scan Repo" or "Add Feature" to get started.</p>
                }
            </div>
        </div>

        @* GitHub Commits *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-github me-2"></i>GitHub Commits
                @if (!string.IsNullOrEmpty(resolvedRepoBranch))
                {
                    <span class="badge bg-secondary ms-2 fw-normal" style="font-family:monospace;">@resolvedRepoBranch</span>
                }
            </div>
            <div class="card-body p-0">
                @if (string.IsNullOrEmpty(resolvedRepoOwner) || string.IsNullOrEmpty(resolvedRepoName) || string.IsNullOrEmpty(resolvedRepoBranch))
                {
                    <p class="text-muted fst-italic p-3 mb-0">No GitHub branch linked.</p>
                }
                else if (ViewBag.CommitError != null)
                {
                    <div class="p-3">
                        <div class="alert alert-warning mb-0 small">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.CommitError
                        </div>
                    </div>
                }
                else if (ViewBag.Commits == null || ((IList<WFHMonitor.Services.GitHubCommit>)ViewBag.Commits).Count == 0)
                {
                    <p class="text-muted fst-italic p-3 mb-0">No commits found on this branch.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var commit in (IList<WFHMonitor.Services.GitHubCommit>)ViewBag.Commits)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex align-items-start gap-2">
                                    <a href="@commit.Url" target="_blank"
                                       class="badge bg-dark text-white text-decoration-none"
                                       style="font-family:monospace; font-size:0.75rem;">@commit.Sha</a>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="small fw-semibold text-truncate" title="@commit.Message">@commit.Message</div>
                                        <div class="text-muted" style="font-size:0.72rem;">
                                            @commit.AuthorName &middot; @commit.Date.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

    </div>

    @* Right column *@
    <div class="col-lg-4">

        @* Links *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-link-45deg me-2"></i>Links
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.FigmaLink))
                {
                    <a href="@Model.FigmaLink" target="_blank" class="btn btn-sm btn-outline-secondary w-100 mb-2 text-start">
                        <i class="bi bi-vector-pen me-2"></i>Open Figma Design
                        <i class="bi bi-box-arrow-up-right ms-1 float-end mt-1"></i>
                    </a>
                }
                else
                {
                    <p class="text-muted small mb-0">No Figma link.</p>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-calendar-range me-2"></i>Timeline
            </div>
            <div class="card-body">
                @if (Model.TimelineStart.HasValue || Model.TimelineEnd.HasValue)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-center">
                            <div class="small text-muted">Start</div>
                            <div class="fw-semibold">@(Model.TimelineStart?.ToString("MMM dd, yyyy") ?? "—")</div>
                        </div>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <div class="text-center">
                            <div class="small text-muted">End</div>
                            <div class="fw-semibold">@(Model.TimelineEnd?.ToString("MMM dd, yyyy") ?? "—")</div>
                        </div>
                    </div>
                    @if (Model.TimelineStart.HasValue && Model.TimelineEnd.HasValue)
                    {
                        var days = (Model.TimelineEnd.Value - Model.TimelineStart.Value).Days;
                        <div class="mt-2 small text-muted">Duration: @days day(s)</div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No timeline set.</p>
                }
            </div>
        </div>

        @* GitHub Config *@
        @if (!string.IsNullOrEmpty(resolvedRepoOwner) || !string.IsNullOrEmpty(resolvedRepoName) || !string.IsNullOrEmpty(Model.GitHubRepoUrl))
        {
            <div class="card mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-github me-2"></i>Repository
                </div>
                <div class="card-body small">
                    @if (!string.IsNullOrEmpty(resolvedRepoOwner) && !string.IsNullOrEmpty(resolvedRepoName))
                    {
                        <div class="mb-1"><span class="text-muted">Repo: </span><span class="fw-semibold" style="font-family:monospace;">@resolvedRepoOwner/@resolvedRepoName</span></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.GitHubRepoUrl))
                    {
                        <div class="mb-1">
                            <span class="text-muted">URL: </span>
                            <a href="@Model.GitHubRepoUrl" target="_blank" rel="noopener" class="fw-semibold">Open Repository</a>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(resolvedRepoBranch))
                    {
                        <div><span class="text-muted">Branch: </span><span class="fw-semibold" style="font-family:monospace;">@resolvedRepoBranch</span></div>
                    }
                </div>
            </div>
        }

        @* PIC *@
        <div class="card">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-people me-2"></i>Person in Charge (PIC)
            </div>
            <div class="card-body p-0">
                @if (Model.Pics.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var pic in Model.Pics)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-muted fs-5"></i>
                                <div>
                                    <div class="fw-semibold small">@pic.Employee?.FullName</div>
                                    @if (!string.IsNullOrEmpty(pic.Role))
                                    {
                                        <div class="text-muted" style="font-size:0.75rem;">@pic.Role</div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small p-3 mb-0">No PIC assigned.</p>
                }
            </div>
        </div>

        @* Linked Bugs *@
        <div class="card mt-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bug me-2"></i>Linked Bugs</span>
                <span class="badge bg-secondary">@linkedBugs.Count</span>
            </div>
            <div class="card-body p-0">
                @if (!linkedBugs.Any())
                {
                    <p class="text-muted small p-3 mb-0">No bugs linked to this project.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Bug #</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Assigned</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bug in linkedBugs)
                                {
                                    <tr>
                                        <td class="text-muted">@bug.BugNumber</td>
                                        <td>
                                            <a asp-controller="Bug" asp-action="Details" asp-route-id="@bug.Id" class="fw-semibold text-decoration-none">
                                                @bug.Title
                                            </a>
                                        </td>
                                        <td><span class="badge bg-secondary">@bug.Status</span></td>
                                        <td>
                                            @if (bug.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent)
                                            {
                                                <span>Agent (@bug.AgentStatus)</span>
                                            }
                                            else
                                            {
                                                <span>@(bug.AssignedDeveloper?.FullName ?? "Unassigned")</span>
                                            }
                                        </td>
                                        <td class="text-muted">@bug.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

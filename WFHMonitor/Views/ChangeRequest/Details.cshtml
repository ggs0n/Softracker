@model WFHMonitor.Models.ChangeRequest
@{
    ViewData["Title"] = Model.CrNumber;
    var resolvedRepoOwner = ViewBag.ResolvedGitHubOwner as string;
    var resolvedRepoName = ViewBag.ResolvedGitHubRepo as string;
    var resolvedRepoBranch = ViewBag.ResolvedGitHubBranch as string;
    var linkedBugs = ViewBag.LinkedBugs as IList<WFHMonitor.Models.BugReport> ?? new List<WFHMonitor.Models.BugReport>();
    var openClawScanAgentOptions = ViewBag.OpenClawScanAgentOptions as IList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var hasProAccess = ViewBag.HasProAccess as bool? ?? false;
    var isOpenClawEnabled = ViewBag.IsOpenClawEnabled as bool? ?? true;
    var isBugScanQueued = Model.BugScanStatus == WFHMonitor.Models.ProjectBugScanStatus.Queued;
    var isBugScanProcessing = Model.BugScanStatus == WFHMonitor.Models.ProjectBugScanStatus.InProgress;
    var isBugScanRunning = isBugScanQueued || isBugScanProcessing;
    var repositoryFeatures = Model.RepositoryFeatures.OrderBy(f => f.Name).ToList();

    var stageItems = new List<(WFHMonitor.Models.CrStage Stage, string Label)>
    {
        (WFHMonitor.Models.CrStage.Development, "Development"),
        (WFHMonitor.Models.CrStage.Testing, "Testing"),
        (WFHMonitor.Models.CrStage.Deploy, "Deploy")
    };
    var normalizedStage = Model.Stage == WFHMonitor.Models.CrStage.ProjectStart
        ? WFHMonitor.Models.CrStage.Development
        : Model.Stage == WFHMonitor.Models.CrStage.DeploymentComplete
            ? WFHMonitor.Models.CrStage.Deploy
            : Model.Stage;
    var currentStageIndex = stageItems.FindIndex(s => s.Stage == normalizedStage);
}

<style>
    .project-detail-shell {
        background: radial-gradient(circle at top left, #e5f9f3 0%, #f3f5ff 45%, #f4f6fb 100%);
        border: 1px solid #e5e9f4;
        border-radius: 18px;
        padding: 18px;
    }

    .project-detail-hero {
        background: linear-gradient(120deg, rgba(228, 247, 241, 0.96), rgba(236, 240, 255, 0.96));
        border: 1px solid #dce4f1;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 16px;
    }

    .project-detail-head {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .project-detail-kicker {
        font-size: 0.73rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748b;
        font-weight: 700;
        margin-bottom: 2px;
    }

    .project-detail-title {
        font-size: 2.15rem;
        font-weight: 800;
        color: #1f2937;
        line-height: 1.1;
    }

    .project-detail-meta {
        color: #64748b;
        font-size: 0.84rem;
        margin-left: 2px;
    }

    .project-stage-flow {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
        align-items: center;
        justify-content: center;
    }

    .project-stage-pill {
        border-radius: 999px;
        border: 1px solid #dbe3ef;
        background: #f8fafc;
        color: #64748b;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 5px 11px;
    }

    .project-stage-complete {
        background: #d1fae5;
        border-color: #a7f3d0;
        color: #047857;
    }

    .project-stage-current {
        background: #dbeafe;
        border-color: #bfdbfe;
        color: #1d4ed8;
    }

    .project-stage-arrow {
        color: #94a3b8;
        font-size: 0.73rem;
    }

    .project-detail-actions {
        display: flex;
        gap: 8px;
        align-items: start;
    }

    .project-detail-shell .card {
        border: 1px solid #e4e9f3;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
        border-radius: 14px;
    }

    .project-detail-shell .card-header {
        background: #fbfdff !important;
        border-bottom: 1px solid #edf2f8;
        color: #334155;
    }

    .project-detail-shell .list-group-item {
        border-color: #edf2f8;
    }

    .project-detail-grid {
        --bs-gutter-x: 1rem;
    }

    @@media (max-width: 991px) {
        .project-detail-title { font-size: 1.65rem; }
    }

    .project-bugscan-progress {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #334155;
    }

    .project-bugscan-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: #64748b;
        box-shadow: 0 0 0 0 rgba(100, 116, 139, 0.45);
    }

    .project-bugscan-dot.is-queued {
        background: #f59e0b;
        box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.35);
    }

    .project-bugscan-dot.is-pulsing {
        background: #3b82f6;
        animation: projectBugScanPulse 1.25s infinite;
    }

    @@keyframes projectBugScanPulse {
        0% { box-shadow: 0 0 0 0 rgba(59,130,246,0.7); }
        70% { box-shadow: 0 0 0 10px rgba(59,130,246,0); }
        100% { box-shadow: 0 0 0 0 rgba(59,130,246,0); }
    }
</style>

<div class="project-detail-shell">
    @if (ViewBag.SyncWarning != null)
    {
        <div class="alert alert-warning small mb-3">
            <i class="bi bi-exclamation-triangle me-2"></i>Auto-sync warning: @ViewBag.SyncWarning
        </div>
    }

    <section class="project-detail-hero">
        <div class="project-detail-head">
            <div>
                <div class="project-detail-kicker">@Model.CrNumber</div>
                <div class="project-detail-title">@Model.Title</div>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="project-detail-actions">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm px-3">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Delete @Model.CrNumber?')">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-outline-danger btn-sm px-3"><i class="bi bi-trash me-1"></i>Delete</button>
                    </form>
                </div>
            }
        </div>

        <div class="project-stage-flow">
            @for (var i = 0; i < stageItems.Count; i++)
            {
                var isComplete = i < currentStageIndex;
                var isCurrent = i == currentStageIndex;
                var stageClass = isCurrent ? "project-stage-current" : isComplete ? "project-stage-complete" : string.Empty;
                <span class="project-stage-pill @stageClass">@stageItems[i].Label</span>
                if (i < stageItems.Count - 1)
                {
                    <i class="bi bi-chevron-right project-stage-arrow"></i>
                }
            }
        </div>
    </section>

<div class="row g-4 project-detail-grid">
    @* Left column *@
    <div class="col-lg-8">

        @* Description *@
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-card-text me-2"></i>Description
                </div>
                <div class="card-body" style="white-space:pre-wrap;">@Model.Description</div>
            </div>
        }
        @* Additional Documents *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-paperclip me-2"></i>Additional Documents</span>
                @if (User.IsInRole("Admin"))
                {
                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#docUploadForm">
                        <i class="bi bi-upload me-1"></i>Upload Document
                    </button>
                }
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="collapse" id="docUploadForm">
                    <div class="card-body border-bottom">
                        <form asp-action="UploadDocument" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-9">
                                    <label class="form-label fw-semibold small">Document File <span class="text-danger">*</span></label>
                                    <input type="file" name="file" class="form-control form-control-sm" required />
                                    <div class="text-muted" style="font-size:0.72rem;">PDF, Word, Excel, PowerPoint, TXT - max 20 MB</div>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-upload me-1"></i>Upload
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card-body p-0">
                @if (!Model.Documents.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">No documents uploaded yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text text-muted"></i>
                                    <a href="/uploads/docs/@doc.FileName" target="_blank">@doc.OriginalFileName</a>
                                    <span class="text-muted small">@doc.UploadedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this document?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <input type="hidden" name="crId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @* Project Features *@
        @{
            var features = Model.Features.OrderBy(f => f.Name).ToList();
        }
        <div class="card mb-4" id="projectFeaturesCard">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-list-check me-2"></i>Project Features
                    <span class="badge bg-secondary ms-1">@features.Count</span>
                </span>
                <div class="d-flex gap-2">
                    <a asp-action="Features" asp-route-projectId="@Model.Id" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-grid me-1"></i>Feature View
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="CreateFeature"
                           asp-route-projectId="@Model.Id"
                           asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-plus-lg me-1"></i>Add Feature
                        </a>
                    }
                </div>
            </div>

            <div class="card-body">
                @if (features.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Feature #</th>
                                    <th>Feature</th>
                                    <th>Status</th>
                                    <th>Priority</th>
                                    <th>Stage</th>
                                    <th>Assignee</th>
                                    <th>Timeline</th>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <th class="text-end">Action</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var feature in features)
                                {
                                    var timelineText = feature.TimelineStart.HasValue || feature.TimelineEnd.HasValue
                                        ? $"{feature.TimelineStart?.ToString("dd MMM yyyy") ?? "-"} to {feature.TimelineEnd?.ToString("dd MMM yyyy") ?? "-"}"
                                        : "-";
                                    <tr>
                                        <td><span class="badge bg-light text-dark border">@feature.FeatureNumber</span></td>
                                        <td>
                                            <a asp-action="FeatureDetails"
                                               asp-route-featureId="@feature.Id"
                                               class="fw-semibold text-decoration-none d-inline-block">
                                                @feature.Name
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(feature.Description))
                                            {
                                                <div class="text-muted small">@feature.Description</div>
                                            }
                                        </td>
                                        <td><span class="badge bg-secondary">@feature.Status</span></td>
                                        <td><span class="badge bg-info text-dark">@feature.Priority</span></td>
                                        <td><span class="badge bg-light text-dark border">@feature.Stage</span></td>
                                        <td>@(feature.AssignedDeveloper?.FullName ?? "Unassigned")</td>
                                        <td class="text-muted small">@timelineText</td>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <td class="text-end">
                                                <a asp-action="EditFeature"
                                                   asp-route-featureId="@feature.Id"
                                                   asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")"
                                                   class="btn btn-sm btn-outline-warning py-0 px-2 me-1"
                                                   title="Edit feature">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="DeleteFeature" method="post" class="d-inline"
                                                      onsubmit="return confirm('Remove this feature?')">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="featureId" value="@feature.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">No features tracked yet. Use "Add Feature" to get started.</p>
                }
            </div>
        </div>

        @* Linked Bugs *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bug me-2"></i>Linked Bugs</span>
                <div class="d-flex align-items-center gap-2">
                    @if (isOpenClawEnabled)
                    {
                        @if (hasProAccess && (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer")))
                        {
                            <form asp-action="FindBugs" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2">
                                @Html.AntiForgeryToken()
                                <select name="scanAgentId" class="form-select form-select-sm" style="min-width: 120px;">
                                    @foreach (var option in openClawScanAgentOptions)
                                    {
                                        <option value="@option.Value" selected="@(option.Value == Model.BugScanAgentId ? "selected" : null)">
                                            @option.Text
                                        </option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-dark" @(isBugScanRunning ? "disabled" : null)>
                                    @if (isBugScanProcessing)
                                    {
                                        <span><i class="bi bi-arrow-repeat me-1"></i>Scanning...</span>
                                    }
                                    else if (isBugScanQueued)
                                    {
                                        <span><i class="bi bi-clock-history me-1"></i>Queued...</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-cpu me-1"></i>Find Bugs</span>
                                    }
                                </button>
                            </form>
                        }
                        else if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
                        {
                            <a asp-controller="Payment" asp-action="Index" class="btn btn-sm btn-outline-warning">
                                <i class="bi bi-stars me-1"></i>Upgrade to Pro for Find Bugs
                            </a>
                        }
                    }
                    <span class="badge bg-secondary">@linkedBugs.Count</span>
                </div>
            </div>
            @if (isOpenClawEnabled)
            {
                <div class="card-body border-bottom py-2 d-flex justify-content-between align-items-center">
                    <div class="project-bugscan-progress">
                        <span class="project-bugscan-dot @(isBugScanProcessing ? "is-pulsing" : (isBugScanQueued ? "is-queued" : ""))"></span>
                        <span>Find Bugs Status: @Model.BugScanStatus</span>
                    </div>
                    @if (Model.BugScanLastRunAt.HasValue)
                    {
                        <span class="small text-muted">Updated @Model.BugScanLastRunAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.BugScanLastMessage))
                {
                    <div class="px-3 py-2 small text-muted border-bottom">@Model.BugScanLastMessage</div>
                }
            }
            <div class="card-body p-0">
                @if (!linkedBugs.Any())
                {
                    <p class="text-muted small p-3 mb-0">No bugs linked to this project.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Bug #</th>
                                    <th>Title</th>
                                    <th>Status</th>
                                    <th>Assigned</th>
                                    <th>Created</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bug in linkedBugs)
                                {
                                    <tr>
                                        <td class="text-muted">@bug.BugNumber</td>
                                        <td>
                                            <a asp-controller="Bug" asp-action="Details" asp-route-id="@bug.Id" class="fw-semibold text-decoration-none">
                                                @bug.Title
                                            </a>
                                        </td>
                                        <td><span class="badge bg-secondary">@bug.Status</span></td>
                                        <td>
                                            @if (bug.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent)
                                            {
                                                <span>Agent (@bug.AgentStatus)</span>
                                            }
                                            else
                                            {
                                                <span>@(bug.AssignedDeveloper?.FullName ?? "Unassigned")</span>
                                            }
                                        </td>
                                        <td class="text-muted">@bug.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

    </div>

    @* Right column *@
    <div class="col-lg-4">

        @* Links *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-link-45deg me-2"></i>Links
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="small text-muted fw-semibold mb-1">Technology / Languages</div>
                    @if (!string.IsNullOrWhiteSpace(Model.TechnologyStack))
                    {
                        var technologies = Model.TechnologyStack.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var tech in technologies)
                            {
                                <span class="badge rounded-pill text-bg-light border">@tech</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">No technology data.</p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.FigmaLink))
                {
                    <a href="@Model.FigmaLink" target="_blank" class="btn btn-sm btn-outline-secondary w-100 mb-2 text-start">
                        <i class="bi bi-vector-pen me-2"></i>Open Figma Design
                        <i class="bi bi-box-arrow-up-right ms-1 float-end mt-1"></i>
                    </a>
                }
                else
                {
                    <p class="text-muted small mb-0">No Figma link.</p>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-calendar-range me-2"></i>Timeline
            </div>
            <div class="card-body">
                @if (Model.TimelineStart.HasValue || Model.TimelineEnd.HasValue)
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="text-center">
                            <div class="small text-muted">Start</div>
                            <div class="fw-semibold">@(Model.TimelineStart?.ToString("MMM dd, yyyy") ?? "—")</div>
                        </div>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <div class="text-center">
                            <div class="small text-muted">End</div>
                            <div class="fw-semibold">@(Model.TimelineEnd?.ToString("MMM dd, yyyy") ?? "—")</div>
                        </div>
                    </div>
                    @if (Model.TimelineStart.HasValue && Model.TimelineEnd.HasValue)
                    {
                        var days = (Model.TimelineEnd.Value - Model.TimelineStart.Value).Days;
                        <div class="mt-2 small text-muted">Duration: @days day(s)</div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">No timeline set.</p>
                }
            </div>
        </div>

        @* GitHub Config *@
        @if (!string.IsNullOrEmpty(resolvedRepoOwner) || !string.IsNullOrEmpty(resolvedRepoName) || !string.IsNullOrEmpty(Model.GitHubRepoUrl))
        {
            <div class="card mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-github me-2"></i>Repository
                </div>
                <div class="card-body small">
                    @if (!string.IsNullOrEmpty(resolvedRepoOwner) && !string.IsNullOrEmpty(resolvedRepoName))
                    {
                        <div class="mb-1"><span class="text-muted">Repo: </span><span class="fw-semibold" style="font-family:monospace;">@resolvedRepoOwner/@resolvedRepoName</span></div>
                    }
                    @if (!string.IsNullOrEmpty(Model.GitHubRepoUrl))
                    {
                        <div class="mb-1">
                            <span class="text-muted">URL: </span>
                            <a href="@Model.GitHubRepoUrl" target="_blank" rel="noopener" class="fw-semibold">Open Repository</a>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(resolvedRepoBranch))
                    {
                        <div><span class="text-muted">Branch: </span><span class="fw-semibold" style="font-family:monospace;">@resolvedRepoBranch</span></div>
                    }
                </div>
            </div>
        }

        @* Repository Scan Features *@
        <div class="card mb-4" id="repositoryFeaturesCard">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-github me-2"></i>Repository Scan Features
                    <span class="badge bg-secondary ms-1">@repositoryFeatures.Count</span>
                </span>
            </div>
            <div class="card-body">
                @if (repositoryFeatures.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Updated</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var feature in repositoryFeatures)
                                {
                                    <tr>
                                        <td class="fw-semibold">@feature.Name</td>
                                        <td class="text-muted small">@feature.UpdatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted fst-italic mb-0">No repository scan features yet.</p>
                }
            </div>
        </div>

        @* PIC *@
        <div class="card">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-people me-2"></i>Person in Charge (PIC)
            </div>
            <div class="card-body p-0">
                @if (Model.Pics.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var pic in Model.Pics)
                        {
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-muted fs-5"></i>
                                <div>
                                    <div class="fw-semibold small">@pic.Employee?.FullName</div>
                                    @if (!string.IsNullOrEmpty(pic.Role))
                                    {
                                        <div class="text-muted" style="font-size:0.75rem;">@pic.Role</div>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted small p-3 mb-0">No PIC assigned.</p>
                }
            </div>
        </div>

        @* GitHub Commits *@
        <div class="card mt-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-github me-2"></i>GitHub Commits
                @if (!string.IsNullOrEmpty(resolvedRepoBranch))
                {
                    <span class="badge bg-secondary ms-2 fw-normal" style="font-family:monospace;">@resolvedRepoBranch</span>
                }
            </div>
            <div class="card-body p-0">
                @if (string.IsNullOrEmpty(resolvedRepoOwner) || string.IsNullOrEmpty(resolvedRepoName) || string.IsNullOrEmpty(resolvedRepoBranch))
                {
                    <p class="text-muted fst-italic p-3 mb-0">No GitHub branch linked.</p>
                }
                else if (ViewBag.CommitError != null)
                {
                    <div class="p-3">
                        <div class="alert alert-warning mb-0 small">
                            <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.CommitError
                        </div>
                    </div>
                }
                else if (ViewBag.Commits == null || ((IList<WFHMonitor.Services.GitHubCommit>)ViewBag.Commits).Count == 0)
                {
                    <p class="text-muted fst-italic p-3 mb-0">No commits found on this branch.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var commit in (IList<WFHMonitor.Services.GitHubCommit>)ViewBag.Commits)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex align-items-start gap-2">
                                    <a href="@commit.Url" target="_blank"
                                       class="badge bg-dark text-white text-decoration-none"
                                       style="font-family:monospace; font-size:0.75rem;">@commit.Sha</a>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="small fw-semibold text-truncate" title="@commit.Message">@commit.Message</div>
                                        <div class="text-muted" style="font-size:0.72rem;">
                                            @commit.AuthorName &middot; @commit.Date.ToString("MMM dd, yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>
</div>

@section Scripts {
    @if (isOpenClawEnabled && isBugScanRunning)
    {
        <script>
            setTimeout(function () {
                window.location.reload();
            }, 7000);
        </script>
    }
}

@using Microsoft.AspNetCore.Mvc.Rendering
@model WFHMonitor.ViewModels.CreateProjectFeatureViewModel
@{
    ViewData["Title"] = "Add New Feature";
    var stageOptions = new List<SelectListItem>
    {
        new() { Value = WFHMonitor.Models.CrStage.Development.ToString(), Text = "Development" },
        new() { Value = WFHMonitor.Models.CrStage.Testing.ToString(), Text = "Testing" },
        new() { Value = WFHMonitor.Models.CrStage.Deploy.ToString(), Text = "Deploy" }
    };
}

<div class="row">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Add New Feature (Under Project)</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateFeature" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="All" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="ChangeRequestId" class="form-label fw-semibold">Related Project <span class="text-danger">*</span></label>
                        <select asp-for="ChangeRequestId" asp-items="Model.ProjectOptions" class="form-select">
                            <option value="">-- Select Project --</option>
                        </select>
                        <span asp-validation-for="ChangeRequestId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Feature Title <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Approval Workflow with Email Notification" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Describe the scope and objective of this feature..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ModuleImpacted" class="form-label fw-semibold">Affected Module</label>
                            <input asp-for="ModuleImpacted" class="form-control" placeholder="e.g. Auth, Payment, Dashboard" />
                            <span asp-validation-for="ModuleImpacted" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LinkedBugs" class="form-label fw-semibold">Linked Bugs</label>
                            <input asp-for="LinkedBugs" class="form-control" placeholder="e.g. BUG-2026-0012, BUG-2026-0019" />
                            <span asp-validation-for="LinkedBugs" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PullRequestUrl" class="form-label fw-semibold">PR Link</label>
                        <input asp-for="PullRequestUrl" class="form-control" placeholder="https://github.com/org/repo/pull/123" />
                        <span asp-validation-for="PullRequestUrl" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<WFHMonitor.Models.CrStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<WFHMonitor.Models.CrPriority>()" class="form-select"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label fw-semibold">Stage</label>
                            <select asp-for="Stage" asp-items="stageOptions" class="form-select"></select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TimelineStart" class="form-label fw-semibold">Start Date</label>
                            <input asp-for="TimelineStart" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TimelineEnd" class="form-label fw-semibold">End Date</label>
                            <input asp-for="TimelineEnd" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AssignedDeveloperId" class="form-label fw-semibold">Assigned To (Developer / Agent)</label>
                        <select asp-for="AssignedDeveloperId" asp-items="Model.DeveloperOptions" class="form-select">
                            <option value="">-- Select Developer or Agent --</option>
                        </select>
                        <span asp-validation-for="AssignedDeveloperId" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-2"></i>Create Feature
                        </button>
                        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                        {
                            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary">Cancel</a>
                        }
                        else
                        {
                            <a asp-action="Features" asp-route-projectId="@Model.ChangeRequestId" class="btn btn-outline-secondary">Cancel</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Rule</h6>
            </div>
            <div class="card-body small text-muted">
                New features must always be tied to a project. Admin can assign developer or agent ownership and project-like planning fields.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@using Microsoft.AspNetCore.Mvc.Rendering
@model WFHMonitor.ViewModels.CreateProjectFeatureViewModel
@{
    ViewData["Title"] = "Add New Feature";
    var stageOptions = new List<SelectListItem>
    {
        new() { Value = WFHMonitor.Models.CrStage.Development.ToString(), Text = "Development" },
        new() { Value = WFHMonitor.Models.CrStage.Testing.ToString(), Text = "Testing" },
        new() { Value = WFHMonitor.Models.CrStage.Deploy.ToString(), Text = "Deploy" }
    };
}

<style>
    .nf-shell{max-width:1420px;margin:0 auto}
    .nf-hero{position:relative;background:var(--bg-dark);border:1px solid rgba(16,185,129,.18);border-radius:16px;padding:32px 36px 28px;margin-bottom:26px;overflow:hidden}
    .nf-hero::before{content:'';position:absolute;top:-60px;right:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(16,185,129,.12) 0%,transparent 70%);pointer-events:none}
    .nf-hero-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25);color:#34d399;font-size:.68rem;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px}
    .nf-hero-title{font-size:1.65rem;font-weight:800;color:#f4f5f7;letter-spacing:-.02em;line-height:1.15}
    .nf-hero-sub{font-size:.78rem;color:#a1a1aa;margin-top:4px;font-weight:500}

    .nf-section{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;margin-bottom:22px;overflow:hidden;transition:box-shadow .2s ease}
    .nf-section:hover{box-shadow:0 8px 28px rgba(0,0,0,.06)}
    .nf-section-head{display:flex;align-items:center;gap:10px;padding:15px 22px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,#fafbfc,#f6f7f9)}
    .nf-section-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
    .nf-section-label{font-size:.82rem;font-weight:700;color:var(--text-primary);letter-spacing:.01em}
    .nf-section-label span{font-size:.68rem;font-weight:500;color:var(--text-muted);display:block;margin-top:1px;letter-spacing:0}
    .nf-section-body{padding:22px 24px}

    .nf-label{font-size:.76rem;font-weight:600;color:var(--text-secondary);margin-bottom:5px;display:flex;align-items:center;gap:4px}
    .nf-label .required{color:#ef4444;font-weight:700}
    .nf-input{background:#fff;border:1px solid #d1d5db;border-radius:10px;padding:10px 14px;font-size:.84rem;color:var(--text-primary);width:100%;transition:all .2s ease;font-family:inherit}
    .nf-input:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
    .nf-input::placeholder{color:#a1a1aa}
    .nf-select{background:#fff;border:1px solid #d1d5db;border-radius:10px;padding:10px 14px;font-size:.84rem;color:var(--text-primary);width:100%;transition:all .2s ease;font-family:inherit;appearance:auto}
    .nf-select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
    .nf-textarea{background:#fff;border:1px solid #d1d5db;border-radius:10px;padding:12px 14px;font-size:.84rem;color:var(--text-primary);width:100%;resize:vertical;min-height:110px;font-family:inherit;transition:all .2s ease;line-height:1.55}
    .nf-textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
    .nf-hint{font-size:.68rem;color:var(--text-muted);margin-top:4px}
    .nf-error{font-size:.7rem;color:#ef4444;margin-top:3px}
    .nf-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .nf-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}

    .nf-footer{display:flex;gap:10px;align-items:center;margin-top:8px}
    .nf-btn-create{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:11px 30px;font-size:.86rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:7px;transition:all .2s ease;letter-spacing:.01em}
    .nf-btn-create:hover{background:var(--accent-hover);transform:translateY(-1px);box-shadow:0 6px 18px rgba(16,185,129,.25)}
    .nf-btn-cancel{background:transparent;color:var(--text-muted);border:1px solid var(--border);border-radius:10px;padding:11px 24px;font-size:.86rem;font-weight:600;cursor:pointer;transition:all .2s ease;text-decoration:none;display:inline-flex;align-items:center;gap:5px}
    .nf-btn-cancel:hover{border-color:var(--text-secondary);color:var(--text-primary)}

    .nf-alert{background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:10px 16px;font-size:.8rem;color:#b91c1c;margin-bottom:16px}

    @@media(max-width:640px){.nf-row,.nf-row-3{grid-template-columns:1fr}.nf-hero{padding:22px 18px 20px}.nf-section-body{padding:16px}}
</style>

<div class="nf-shell">
    <form asp-action="CreateFeature" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        @* Hero *@
        <section class="nf-hero">
            <div class="nf-hero-badge"><i class="bi bi-plus-circle"></i> New Feature</div>
            <div class="nf-hero-title">Add New Feature</div>
            <div class="nf-hero-sub">Create a feature under a project with assignment and planning fields</div>
        </section>

        @* Validation *@
        <div asp-validation-summary="All" class="nf-alert" style="display:none"></div>

        @* Project & Feature Info *@
        <div class="nf-section">
            <div class="nf-section-head">
                <div class="nf-section-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-list-check"></i></div>
                <div class="nf-section-label">Feature Details<span>Core information about this feature</span></div>
            </div>
            <div class="nf-section-body">
                <div style="margin-bottom:16px">
                    <label asp-for="ChangeRequestId" class="nf-label">Related Project <span class="required">*</span></label>
                    <select asp-for="ChangeRequestId" asp-items="Model.ProjectOptions" class="nf-select">
                        <option value="">-- Select Project --</option>
                    </select>
                    <span asp-validation-for="ChangeRequestId" class="nf-error"></span>
                </div>

                <div style="margin-bottom:16px">
                    <label asp-for="Name" class="nf-label">Feature Title <span class="required">*</span></label>
                    <input asp-for="Name" class="nf-input" placeholder="e.g. Approval Workflow with Email Notification" />
                    <span asp-validation-for="Name" class="nf-error"></span>
                </div>

                <div style="margin-bottom:16px">
                    <label asp-for="Description" class="nf-label">Description</label>
                    <textarea asp-for="Description" class="nf-textarea" placeholder="Describe the scope and objective of this feature..."></textarea>
                    <span asp-validation-for="Description" class="nf-error"></span>
                </div>

                <div class="nf-row" style="margin-bottom:16px">
                    <div>
                        <label asp-for="ModuleImpacted" class="nf-label">Affected Module</label>
                        <input asp-for="ModuleImpacted" class="nf-input" placeholder="e.g. Auth, Payment, Dashboard" />
                        <span asp-validation-for="ModuleImpacted" class="nf-error"></span>
                    </div>
                    <div>
                        <label asp-for="LinkedBugs" class="nf-label">Linked Bugs</label>
                        <input asp-for="LinkedBugs" class="nf-input" placeholder="e.g. BUG-2026-0012, BUG-2026-0019" />
                        <span asp-validation-for="LinkedBugs" class="nf-error"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="PullRequestUrl" class="nf-label">PR Link</label>
                    <input asp-for="PullRequestUrl" class="nf-input" placeholder="https://github.com/org/repo/pull/123" />
                    <span asp-validation-for="PullRequestUrl" class="nf-error"></span>
                </div>
            </div>
        </div>

        @* Status & Timeline *@
        <div class="nf-section">
            <div class="nf-section-head">
                <div class="nf-section-icon" style="background:#e0f2fe;color:#0284c7"><i class="bi bi-calendar-range"></i></div>
                <div class="nf-section-label">Status & Timeline<span>Planning and tracking fields</span></div>
            </div>
            <div class="nf-section-body">
                <div class="nf-row-3" style="margin-bottom:16px">
                    <div>
                        <label asp-for="Status" class="nf-label">Status</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<WFHMonitor.Models.CrStatus>()" class="nf-select"></select>
                    </div>
                    <div>
                        <label asp-for="Priority" class="nf-label">Priority</label>
                        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<WFHMonitor.Models.CrPriority>()" class="nf-select"></select>
                    </div>
                    <div>
                        <label asp-for="Stage" class="nf-label">Stage</label>
                        <select asp-for="Stage" asp-items="stageOptions" class="nf-select"></select>
                    </div>
                </div>

                <div class="nf-row">
                    <div>
                        <label asp-for="TimelineStart" class="nf-label">Start Date</label>
                        <input asp-for="TimelineStart" type="date" class="nf-input" />
                    </div>
                    <div>
                        <label asp-for="TimelineEnd" class="nf-label">End Date</label>
                        <input asp-for="TimelineEnd" type="date" class="nf-input" />
                    </div>
                </div>
            </div>
        </div>

        @* Assignment *@
        <div class="nf-section">
            <div class="nf-section-head">
                <div class="nf-section-icon" style="background:#fef3c7;color:#d97706"><i class="bi bi-person-badge"></i></div>
                <div class="nf-section-label">Assignment<span>Developer or agent ownership</span></div>
            </div>
            <div class="nf-section-body">
                <label asp-for="AssignedDeveloperId" class="nf-label">Assigned To (Developer / Agent)</label>
                <select asp-for="AssignedDeveloperId" asp-items="Model.DeveloperOptions" class="nf-select">
                    <option value="">-- Select Developer or Agent --</option>
                </select>
                <span asp-validation-for="AssignedDeveloperId" class="nf-error"></span>
            </div>
        </div>

        @* Footer *@
        <div class="nf-footer">
            <button type="submit" class="nf-btn-create"><i class="bi bi-check-lg"></i> Create Feature</button>
            @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
            {
                <a href="@Model.ReturnUrl" class="nf-btn-cancel">Cancel</a>
            }
            else
            {
                <a asp-action="Features" asp-route-projectId="@Model.ChangeRequestId" class="nf-btn-cancel">Cancel</a>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var vs = document.querySelector('[data-valmsg-summary]');
            if (vs && vs.querySelector('li')) vs.style.display = 'block';
        });
    </script>
}

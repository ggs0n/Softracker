@using Microsoft.AspNetCore.Mvc.Rendering
@model WFHMonitor.ViewModels.ChangeRequestFormViewModel
@{
    ViewData["Title"] = "Edit Project";
    var stageOptions = new List<SelectListItem>
    {
        new() { Value = WFHMonitor.Models.CrStage.Development.ToString(), Text = "Development" },
        new() { Value = WFHMonitor.Models.CrStage.Testing.ToString(), Text = "Testing" },
        new() { Value = WFHMonitor.Models.CrStage.Deploy.ToString(), Text = "Deploy" }
    };
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header bg-warning">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Project</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="crForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RowVersion" />
                    <div asp-validation-summary="All" class="alert alert-danger small"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<WFHMonitor.Models.CrStatus>()" class="form-select"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold">Priority</label>
                            <select asp-for="Priority" asp-items="Html.GetEnumSelectList<WFHMonitor.Models.CrPriority>()" class="form-select"></select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Stage" class="form-label fw-semibold">Stage</label>
                        <select asp-for="Stage" asp-items="stageOptions" class="form-select"></select>
                    </div>

                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3"><i class="bi bi-link-45deg me-2 text-primary"></i>Links</h6>

                    <div class="mb-3">
                        <label asp-for="FigmaLink" class="form-label fw-semibold">
                            <i class="bi bi-vector-pen me-1 text-muted"></i>Figma Link
                        </label>
                        <input asp-for="FigmaLink" class="form-control" />
                    </div>

                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3"><i class="bi bi-calendar-range me-2 text-primary"></i>Timeline</h6>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="TimelineStart" class="form-label fw-semibold">Start Date</label>
                            <input asp-for="TimelineStart" type="date" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TimelineEnd" class="form-label fw-semibold">End Date</label>
                            <input asp-for="TimelineEnd" type="date" class="form-control" />
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="fw-bold mb-3" data-onboarding-id="github-integration-section"><i class="bi bi-github me-2 text-primary"></i>GitHub Integration</h6>

                    <div class="row g-3 mb-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Connected GitHub Repositories</label>
                            <div class="input-group">
                                <select id="connectedGitHubRepo" class="form-select">
                                    <option value="">Loading connected repositories...</option>
                                </select>
                                <button type="button" id="applyConnectedGitHubRepo" class="btn btn-outline-dark" disabled>
                                    <i class="bi bi-check2-square me-1"></i>Use Repo
                                </button>
                            </div>
                            <div id="connectedGitHubRepoStatus" class="form-text">Select a repository to auto-fill project details.</div>
                        </div>
                        <div class="col-12">
                            <label asp-for="GitHubRepoUrl" class="form-label fw-semibold">GitHub Repo URL</label>
                            <div class="input-group">
                                <input asp-for="GitHubRepoUrl" class="form-control" placeholder="https://github.com/owner/repo" />
                                <button type="button" id="importFromGitHub" class="btn btn-outline-primary">
                                    <i class="bi bi-download me-1"></i>Import Repo
                                </button>
                            </div>
                            <div class="form-text">Owner and repo fields are auto-filled from this URL.</div>
                            <div id="importStatus" class="small mt-2 d-none"></div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GitHubRepoOwner" class="form-label fw-semibold">Repo Owner</label>
                            <input asp-for="GitHubRepoOwner" class="form-control" placeholder="e.g. myorg" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="GitHubRepoName" class="form-label fw-semibold">Repo Name</label>
                            <input asp-for="GitHubRepoName" class="form-control" placeholder="e.g. myproject" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GitHubBranch" class="form-label fw-semibold">Branch</label>
                        <input asp-for="GitHubBranch" class="form-control" placeholder="e.g. feature/project-2026-0001" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="TechnologyStack" class="form-label fw-semibold">Technology / Languages</label>
                        <input asp-for="TechnologyStack" class="form-control" placeholder="e.g. C# (60%), TypeScript (40%)" />
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0"><i class="bi bi-people me-2 text-primary"></i>Person in Charge (PIC)</h6>
                        <button type="button" id="addPic" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-plus-circle me-1"></i>Add PIC
                        </button>
                    </div>
                    <div id="picContainer"></div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg me-2"></i>Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var employeeOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.EmployeeOptions.Select(o => new { value = o.Value, text = o.Text })
        ));
        var existingPics = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Pics.Select(p => new { employeeId = p.EmployeeId, role = p.Role ?? "" })
        ));
        var importUrl = '@Url.Action("ImportGitHubRepo", "ChangeRequest")';
        var repositoryCatalogUrl = '@Url.Action("GetGitHubRepositories", "ChangeRequest")';
        var connectedRepositories = [];

        function addPicRow(empId, role) {
            var idx = $('#picContainer .pic-row').length;
            var opts = employeeOptions.map(o =>
                `<option value="${o.value}" ${o.value === empId ? 'selected' : ''}>${o.text}</option>`
            ).join('');

            var row = `<div class="pic-row d-flex gap-2 mb-2 align-items-center">
                <select name="Pics[${idx}].EmployeeId" class="form-select form-select-sm" style="max-width:220px;">
                    <option value="">-- Select Employee --</option>
                    ${opts}
                </select>
                <input type="text" name="Pics[${idx}].Role" value="${role}"
                       class="form-control form-control-sm" placeholder="Role (Developer, Tester...)"
                       style="max-width:200px;" />
                <button type="button" class="btn btn-sm btn-outline-danger remove-pic">
                    <i class="bi bi-trash"></i>
                </button>
            </div>`;
            $('#picContainer').append(row);
            reindexPics();
        }

        function reindexPics() {
            $('#picContainer .pic-row').each(function(i) {
                $(this).find('select').attr('name', `Pics[${i}].EmployeeId`);
                $(this).find('input').attr('name', `Pics[${i}].Role`);
            });
        }

        function setImportStatus(message, type) {
            var cssClass = type === 'error' ? 'text-danger'
                : type === 'success' ? 'text-success'
                : 'text-muted';

            $('#importStatus')
                .removeClass('d-none text-danger text-success text-muted')
                .addClass(cssClass)
                .text(message);
        }

        function setConnectedRepoStatus(message, type) {
            var cssClass = type === 'error' ? 'text-danger'
                : type === 'success' ? 'text-success'
                : 'text-muted';

            $('#connectedGitHubRepoStatus')
                .removeClass('text-danger text-success text-muted')
                .addClass(cssClass)
                .text(message);
        }

        function humanizeRepoName(value) {
            return (value || '')
                .replace(/[-_.]+/g, ' ')
                .replace(/\s{2,}/g, ' ')
                .trim();
        }

        function fillRepoFields(repo) {
            if (!repo) return;

            if (repo.ownerLogin) $('#GitHubRepoOwner').val(repo.ownerLogin);
            if (repo.name) $('#GitHubRepoName').val(repo.name);
            if (repo.htmlUrl) $('#GitHubRepoUrl').val(repo.htmlUrl);
            if (repo.defaultBranch) $('#GitHubBranch').val(repo.defaultBranch);

            var existingTitle = ($('#Title').val() || '').toString().trim();
            if (!existingTitle && repo.name) {
                $('#Title').val(humanizeRepoName(repo.name));
            }
        }

        function renderConnectedRepositories() {
            var $select = $('#connectedGitHubRepo');
            $select.empty();

            if (!connectedRepositories.length) {
                $('<option>', { value: '', text: 'No repositories found' }).appendTo($select);
                $('#applyConnectedGitHubRepo').prop('disabled', true);
                return;
            }

            $('<option>', { value: '', text: '-- Select repository --' }).appendTo($select);

            connectedRepositories.forEach((repo, index) => {
                var label = repo.fullName || `${repo.ownerLogin}/${repo.name}`;
                if (repo.defaultBranch) label += ` [${repo.defaultBranch}]`;
                if (repo.isPrivate) label += ' (private)';
                $('<option>', { value: String(index), text: label }).appendTo($select);
            });

            $('#applyConnectedGitHubRepo').prop('disabled', false);
        }

        function trySelectExistingRepository() {
            var currentUrl = ($('#GitHubRepoUrl').val() || '').toString().trim().toLowerCase();
            var currentOwner = ($('#GitHubRepoOwner').val() || '').toString().trim().toLowerCase();
            var currentName = ($('#GitHubRepoName').val() || '').toString().trim().toLowerCase();

            var selectedIndex = connectedRepositories.findIndex(repo => {
                var repoUrl = (repo.htmlUrl || '').toLowerCase();
                var repoOwner = (repo.ownerLogin || '').toLowerCase();
                var repoName = (repo.name || '').toLowerCase();

                if (currentUrl && repoUrl && repoUrl === currentUrl) return true;
                return currentOwner && currentName && repoOwner === currentOwner && repoName === currentName;
            });

            if (selectedIndex >= 0) {
                $('#connectedGitHubRepo').val(String(selectedIndex));
            }
        }

        async function loadConnectedRepositories() {
            $('#applyConnectedGitHubRepo').prop('disabled', true);
            setConnectedRepoStatus('Loading connected repositories...', 'info');

            try {
                var response = await fetch(repositoryCatalogUrl, {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    cache: 'no-store'
                });

                var payload = await response.json().catch(() => null);
                if (!response.ok) {
                    throw new Error(payload?.message || 'Unable to load connected repositories.');
                }

                connectedRepositories = (payload?.repositories || []).map(repo => ({
                    name: (repo.name || '').toString().trim(),
                    fullName: (repo.fullName || '').toString().trim(),
                    ownerLogin: (repo.ownerLogin || '').toString().trim(),
                    htmlUrl: (repo.htmlUrl || '').toString().trim(),
                    defaultBranch: (repo.defaultBranch || '').toString().trim(),
                    isPrivate: !!repo.isPrivate
                })).filter(repo => repo.name && repo.ownerLogin && repo.htmlUrl);

                renderConnectedRepositories();
                trySelectExistingRepository();

                if (connectedRepositories.length) {
                    setConnectedRepoStatus(`Loaded ${connectedRepositories.length} repositories. Select one and click Use Repo.`, 'info');
                } else {
                    setConnectedRepoStatus('No repositories returned for the connected account.', 'info');
                }
            } catch (error) {
                connectedRepositories = [];
                renderConnectedRepositories();
                var message = error && error.message
                    ? error.message
                    : 'Unable to load connected repositories.';
                setConnectedRepoStatus(message, 'error');
            }
        }

        async function importCurrentRepository() {
            var repoUrl = ($('#GitHubRepoUrl').val() || '').toString().trim();
            var branch = ($('#GitHubBranch').val() || '').toString().trim();
            var token = $('#crForm input[name="__RequestVerificationToken"]').val();

            if (!repoUrl) {
                setImportStatus('Enter a GitHub repository URL first.', 'error');
                return false;
            }

            var $button = $('#importFromGitHub');
            $button.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Importing...');
            setImportStatus('Importing repository metadata...', 'info');

            try {
                var body = new URLSearchParams();
                body.append('repoUrl', repoUrl);
                body.append('branch', branch);
                body.append('__RequestVerificationToken', token);

                var response = await fetch(importUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                        'Accept': 'application/json'
                    },
                    body: body.toString()
                });

                var payload = await response.json().catch(() => null);
                if (!response.ok) {
                    throw new Error(payload?.message || 'Unable to import this repository.');
                }

                if (payload.title) $('#Title').val(payload.title);
                if (payload.description) $('#Description').val(payload.description);
                if (payload.gitHubRepoOwner) $('#GitHubRepoOwner').val(payload.gitHubRepoOwner);
                if (payload.gitHubRepoName) $('#GitHubRepoName').val(payload.gitHubRepoName);
                if (payload.gitHubRepoUrl) $('#GitHubRepoUrl').val(payload.gitHubRepoUrl);
                if (payload.gitHubBranch) $('#GitHubBranch').val(payload.gitHubBranch);
                $('#TechnologyStack').val(payload.technologyStack || '');
                if (payload.timelineStart) $('#TimelineStart').val(payload.timelineStart);
                if (payload.timelineEnd) $('#TimelineEnd').val(payload.timelineEnd);
                if (payload.figmaLink) $('#FigmaLink').val(payload.figmaLink);

                setImportStatus('Repository details imported successfully.', 'success');
                return true;
            } catch (error) {
                var message = error && error.message
                    ? error.message
                    : 'Unable to import this repository.';
                setImportStatus(message, 'error');
                return false;
            } finally {
                $button.prop('disabled', false).html('<i class="bi bi-download me-1"></i>Import Repo');
            }
        }

        existingPics.forEach(p => addPicRow(p.employeeId, p.role));

        $('#addPic').click(function() { addPicRow('', ''); });
        $(document).on('click', '.remove-pic', function() {
            $(this).closest('.pic-row').remove();
            reindexPics();
        });

        $('#importFromGitHub').on('click', async function() {
            await importCurrentRepository();
        });

        $('#connectedGitHubRepo').on('change', function() {
            var selectedIndex = Number($(this).val());
            if (Number.isNaN(selectedIndex) || selectedIndex < 0 || selectedIndex >= connectedRepositories.length) {
                setConnectedRepoStatus('Select a repository to auto-fill project details.', 'info');
                return;
            }

            var selectedRepo = connectedRepositories[selectedIndex];
            setConnectedRepoStatus(`Ready to use ${selectedRepo.fullName}. Click Use Repo.`, 'info');
        });

        $('#applyConnectedGitHubRepo').on('click', async function() {
            var selectedIndex = Number($('#connectedGitHubRepo').val());
            if (Number.isNaN(selectedIndex) || selectedIndex < 0 || selectedIndex >= connectedRepositories.length) {
                setConnectedRepoStatus('Choose a repository first.', 'error');
                return;
            }

            var repo = connectedRepositories[selectedIndex];
            fillRepoFields(repo);
            setConnectedRepoStatus(`Selected ${repo.fullName}. Importing metadata...`, 'success');
            await importCurrentRepository();
        });

        loadConnectedRepositories();
    </script>
}

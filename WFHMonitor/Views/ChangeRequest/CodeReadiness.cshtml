<div class="cr-shell">
    <section class="cr-hero">
        <div>
            <div class="cr-project-tag"><i class="bi bi-folder2-open"></i> @Model.Project.CrNumber</div>
            <div class="cr-project-title">@Model.Project.Title</div>
            <div class="cr-project-meta">Project code quality and release-readiness assessment</div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Project.Id" class="cr-run" style="background:#3f3f46"><i class="bi bi-gear"></i> Project Settings</a>
        }
    </section>

    <nav class="cr-tabs" aria-label="Project details sections">
        <a asp-action="Details" asp-route-id="@Model.Project.Id" class="cr-tab"><i class="bi bi-grid"></i> Overview</a>
        <a asp-action="CodeReadiness" asp-route-id="@Model.Project.Id" class="cr-tab is-active" aria-current="page"><i class="bi bi-shield-check"></i> Code Readiness</a>
    </nav>

    <section class="cr-panel">
        <div class="cr-panel-head">
            <div class="cr-panel-title"><i class="bi bi-code-square" style="color:#059669"></i> Repository Readiness</div>
            <div class="cr-scan-meta">
                <span class="cr-chip"><i class="bi bi-git"></i> @Model.Branch</span>
                @if (!string.IsNullOrWhiteSpace(Model.CommitSha))
                {
                    <span class="cr-chip"><i class="bi bi-bezier2"></i> @Model.CommitSha</span>
                }
                <span><i class="bi bi-clock"></i> Scanned @Model.ScannedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                <a asp-action="CodeReadiness" asp-route-id="@Model.Project.Id" class="cr-action"><i class="bi bi-arrow-repeat"></i> Refresh Structure</a>
                @if (Model.RepositoryConnected && canStartSourceScan)
                {
                    <form asp-action="StartCodeReadinessScan" method="post" class="cr-scan-form">
                        <input type="hidden" name="id" value="@Model.Project.Id" />
                        @if (Model.CodexAgentOptions.Count > 1)
                        {
                            <select name="scanAgentId" class="cr-agent" aria-label="Codex model">
                                @foreach (var option in Model.CodexAgentOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == Model.Project.CodeReadinessScanAgentId ? "selected" : null)">@option.Text</option>
                                }
                            </select>
                        }
                        else if (Model.CodexAgentOptions.Count == 1)
                        {
                            <input type="hidden" name="scanAgentId" value="@Model.CodexAgentOptions[0].Value" />
                        }
                        <button type="submit" class="cr-run" disabled="@(sourceScanRunning ? "disabled" : null)">
                            @if (sourceScanRunning)
                            {
                                <span class="cr-spinner" aria-hidden="true"></span><span>Scanning Source</span>
                            }
                            else
                            {
                                <i class="bi bi-stars"></i><span>Full Codex Scan</span>
                            }
                        </button>
                    </form>
                }
            </div>
        </div>

        @if (!Model.RepositoryConnected)
        {
            <div class="cr-empty">
                <i class="bi bi-github"></i>
                <div class="cr-empty-title">Connect a GitHub repository first</div>
                <div class="cr-empty-text">Code Readiness needs the selected project's repository and branch to inspect its structure.</div>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Project.Id" class="cr-edit-link">Open project settings <i class="bi bi-arrow-right ms-1"></i></a>
                }
            </div>
        }
        else
        {
            var deepStateClass = sourceScanRunning ? "is-running" : Model.DeepScanStatus == WFHMonitor.Models.CodeReadinessScanStatus.Failed ? "is-failed" : "";
            <div id="deepScanState" class="cr-deep-state @deepStateClass">
                @if (sourceScanRunning)
                {
                    <span class="cr-spinner" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi @(Model.UsedCodexSourceScan ? "bi-check-circle" : Model.DeepScanStatus == WFHMonitor.Models.CodeReadinessScanStatus.Failed ? "bi-exclamation-circle" : "bi-info-circle")"></i>
                }
                <span><strong id="deepScanStatus">@Model.DeepScanStatusText.</strong> <span id="deepScanMessage">@Model.DeepScanMessage</span></span>
            </div>
            <div class="cr-overview">
                <div class="cr-score @scoreClass">
                    <i class="bi @(Model.Score >= 85 ? "bi-check-circle" : "bi-exclamation-triangle") cr-score-icon"></i>
                    <div>
                        <div class="cr-score-label">@Model.Label</div>
                        <div class="cr-score-value">@Model.Score <span>/ 100</span></div>
                        <div class="cr-score-summary">@Model.Summary</div>
                    </div>
                </div>
                @foreach (var category in Model.Categories)
                {
                    var statusClass = category.Status == "Passed" ? "is-passed" : category.Status == "At Risk" ? "is-risk" : "";
                    <div class="cr-category" title="@category.Detail">
                        <i class="bi @category.Icon"></i>

<script>
    (() => {
        const rows = Array.from(document.querySelectorAll('[data-fix-first-row]'));
        const pagination = document.getElementById('fixFirstPagination');
        const summary = document.getElementById('fixFirstPageSummary');
        const controls = document.getElementById('fixFirstPageControls');
        const pageSize = 10;

        if (!pagination || !summary || !controls || rows.length === 0) return;

        const pageCount = Math.ceil(rows.length / pageSize);
        let currentPage = 1;

        const addButton = (label, page, options = {}) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = `cr-page-button${options.active ? ' is-active' : ''}`;
            button.textContent = label;
            button.disabled = Boolean(options.disabled);
            if (options.active) button.setAttribute('aria-current', 'page');
            button.setAttribute('aria-label', options.ariaLabel || `Go to page ${page}`);
            button.addEventListener('click', () => renderPage(page));
            controls.appendChild(button);
        };

        const renderPage = page => {
            currentPage = Math.min(Math.max(page, 1), pageCount);
            const start = (currentPage - 1) * pageSize;
            const end = Math.min(start + pageSize, rows.length);

            rows.forEach((row, index) => {
                row.hidden = index < start || index >= end;
            });

            summary.textContent = `Showing ${start + 1}–${end} of ${rows.length} findings`;
            controls.replaceChildren();
            addButton('Previous', currentPage - 1, {
                disabled: currentPage === 1,
                ariaLabel: 'Go to previous page'
            });
            for (let pageNumber = 1; pageNumber <= pageCount; pageNumber++) {
                addButton(String(pageNumber), pageNumber, { active: pageNumber === currentPage });
            }
            addButton('Next', currentPage + 1, {
                disabled: currentPage === pageCount,
                ariaLabel: 'Go to next page'
            });
        };

        pagination.hidden = pageCount <= 1;
        renderPage(1);
    })();
</script>


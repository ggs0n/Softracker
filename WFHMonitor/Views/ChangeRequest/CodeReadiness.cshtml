            const messageNode = document.getElementById('deepScanMessage');
            const terminal = new Set(['Completed', 'Failed']);
            const poll = async () => {
                try {
                    const response = await fetch(statusUrl, { headers: { 'Accept': 'application/json' } });
                    if (!response.ok) return;
                    const state = await response.json();
                    if (statusNode) statusNode.textContent = `${state.status}.`;
                    if (messageNode) messageNode.textContent = state.message || '';
                    if (terminal.has(state.status)) {
                        window.location.reload();
                        return;
                    }
                } catch (_) {
                    // A temporary polling error should not interrupt the background scan.
                }
                window.setTimeout(poll, 3000);
            };
            window.setTimeout(poll, 1500);
        })();
    </script>
}

@model WFHMonitor.ViewModels.CodeReadinessViewModel
@{
    ViewData["Title"] = $"{Model.Project.CrNumber} Code Readiness";
    var scoreClass = Model.Score >= 85 ? "is-good" : Model.Score >= 65 ? "is-warn" : "is-bad";
    var canCreateBug = User.IsInRole("Admin") || User.IsInRole("Tester");
    var canStartSourceScan = User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer");
    var sourceScanRunning = Model.DeepScanStatus is WFHMonitor.Models.CodeReadinessScanStatus.Queued or WFHMonitor.Models.CodeReadinessScanStatus.InProgress;
    var criticalFindingCount = Model.Findings.Count(item => item.Severity.Equals("Critical", StringComparison.OrdinalIgnoreCase));
    var highFindingCount = Model.Findings.Count(item => item.Severity.Equals("High", StringComparison.OrdinalIgnoreCase));
    var atRiskModuleCount = Model.RelatedModules.Count(item => item.Status.Equals("At Risk", StringComparison.OrdinalIgnoreCase));
    var implementedPatternCount = Model.DesignPatterns.Count(item => item.Status.Equals("Implemented", StringComparison.OrdinalIgnoreCase));
    var solidFailCount = Model.SolidChecks.Count(item => item.Status.Equals("Fail", StringComparison.OrdinalIgnoreCase));
    var solidWarningCount = Model.SolidChecks.Count(item => item.Status.Equals("Warning", StringComparison.OrdinalIgnoreCase));
    var owaspFailCount = Model.OwaspAssessments.Count(item => item.Status.Equals("Fail", StringComparison.OrdinalIgnoreCase));
    var owaspWarningCount = Model.OwaspAssessments.Count(item => item.Status.Equals("Warning", StringComparison.OrdinalIgnoreCase));
    var validationFailCount = Model.ValidationAndNullHandling.Count(item => item.Status.Equals("Fail", StringComparison.OrdinalIgnoreCase));
    var validationWarningCount = Model.ValidationAndNullHandling.Count(item => item.Status.Equals("Warning", StringComparison.OrdinalIgnoreCase));
    var loggingFailCount = Model.LoggingAndExceptionHandling.Count(item => item.Status.Equals("Fail", StringComparison.OrdinalIgnoreCase));
    var loggingWarningCount = Model.LoggingAndExceptionHandling.Count(item => item.Status.Equals("Warning", StringComparison.OrdinalIgnoreCase));
    var architectureFileCount = Model.ArchitectureLayers.Sum(item => item.FileCount);
}


@model WFHMonitor.Models.ProjectFeature
@{
    ViewData["Title"] = "Feature View";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var timeline = Model.TimelineStart.HasValue || Model.TimelineEnd.HasValue
        ? $"{Model.TimelineStart?.ToString("dd MMM yyyy") ?? "-"} to {Model.TimelineEnd?.ToString("dd MMM yyyy") ?? "-"}"
        : "-";
}

<div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-dark me-2">@Model.FeatureNumber</span>
            <span class="fw-semibold">@Model.Name</span>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin") || User.IsInRole("Developer"))
            {
                <a asp-action="EditFeature"
                   asp-route-featureId="@Model.Id"
                   asp-route-returnUrl="@returnUrl"
                   class="btn btn-sm btn-outline-warning">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            <a asp-action="Features"
               asp-route-projectId="@Model.ChangeRequestId"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Features
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <div class="small text-muted">Project</div>
                <div class="fw-semibold">
                    <a asp-action="Details" asp-route-id="@Model.ChangeRequestId" class="text-decoration-none">
                        @Model.ChangeRequest?.CrNumber - @Model.ChangeRequest?.Title
                    </a>
                </div>
            </div>
            <div class="col-md-6">
                <div class="small text-muted">Assigned Developer</div>
                <div class="fw-semibold">@(Model.AssignedDeveloper?.FullName ?? "Unassigned")</div>
            </div>
            <div class="col-md-4">
                <div class="small text-muted">Status</div>
                <span class="badge bg-secondary">@Model.Status</span>
            </div>
            <div class="col-md-4">
                <div class="small text-muted">Priority</div>
                <span class="badge bg-info text-dark">@Model.Priority</span>
            </div>
            <div class="col-md-4">
                <div class="small text-muted">Stage</div>
                <span class="badge bg-light text-dark border">@Model.Stage</span>
            </div>
            <div class="col-md-12">
                <div class="small text-muted">Timeline</div>
                <div class="fw-semibold">@timeline</div>
            </div>
            <div class="col-md-12">
                <div class="small text-muted">Description</div>
                <div>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
            </div>
        </div>
    </div>
</div>

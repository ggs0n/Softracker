@model List<WFHMonitor.Models.ChangeRequest>
@{ ViewData["Title"] = "Projects"; }

@{
    var statusClass = new Dictionary<string, string> {
        {"Draft","st-draft"}, {"InReview","st-review"}, {"Approved","st-approved"},
        {"InProgress","st-progress"}, {"Done","st-done"}, {"Rejected","st-rejected"}
    };
    var priorityClass = new Dictionary<string, string> {
        {"Low","pr-low"}, {"Medium","pr-medium"}, {"High","pr-high"}, {"Critical","pr-critical"}
    };
}

<style>
    .pl-shell{max-width:1420px;margin:0 auto}

    /* Hero — dark header matching Create page */
    .pl-hero{position:relative;background:var(--bg-dark);border:1px solid rgba(16,185,129,.18);border-radius:16px;padding:28px 32px 24px;margin-bottom:24px;overflow:hidden;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
    .pl-hero::before{content:'';position:absolute;top:-60px;right:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(16,185,129,.12) 0%,transparent 70%);pointer-events:none}
    .pl-hero-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25);color:#34d399;font-size:.66rem;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
    .pl-hero-title{font-size:1.6rem;font-weight:800;color:#f4f5f7;letter-spacing:-.02em;line-height:1.15}
    .pl-hero-sub{font-size:.76rem;color:#a1a1aa;margin-top:3px;font-weight:500}
    .pl-hero-actions{display:flex;align-items:center;gap:10px;flex-shrink:0;position:relative;z-index:1}
    .pl-total{font-size:.72rem;font-weight:700;border-radius:999px;padding:5px 12px;background:rgba(255,255,255,.08);color:#a1a1aa;border:1px solid rgba(255,255,255,.1)}
    .pl-btn-new{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:9px 20px;font-size:.82rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .2s ease;text-decoration:none;letter-spacing:.01em}
    .pl-btn-new:hover{background:var(--accent-hover);color:#fff;transform:translateY(-1px);box-shadow:0 6px 18px rgba(16,185,129,.25)}

    /* Project cards */
    .pl-list{display:grid;gap:16px}
    .pl-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:box-shadow .2s ease}
    .pl-card:hover{box-shadow:0 8px 28px rgba(0,0,0,.06)}
    .pl-card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 20px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,#fafbfc,#f6f7f9)}
    .pl-cr-num{font-family:Consolas,Monaco,monospace;font-size:.76rem;font-weight:700;color:var(--accent);letter-spacing:.02em}
    .pl-card-actions{display:flex;gap:5px}
    .pl-act{width:30px;height:30px;border-radius:8px;border:1px solid #d1d5db;color:#71717a;background:#fff;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;transition:all .15s ease;font-size:.8rem}
    .pl-act:hover{background:#f8fafc;color:#111827;border-color:#a1a1aa}
    .pl-act-del:hover{border-color:#fecaca;color:#dc2626;background:#fef2f2}

    .pl-card-body{display:grid;grid-template-columns:1fr 320px;gap:16px;padding:18px 20px}
    .pl-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .pl-title-link{font-size:1.25rem;font-weight:800;color:var(--text-primary);text-decoration:none;letter-spacing:-.01em;transition:color .15s ease}
    .pl-title-link:hover{color:var(--accent)}
    .pl-badges{display:flex;align-items:center;flex-wrap:wrap;gap:7px;margin:8px 0 4px}
    .pl-pill{font-size:.7rem;font-weight:700;border-radius:999px;padding:3px 10px;border:1px solid transparent}
    .st-draft{background:#eef2ff;color:#4f46e5;border-color:#c7d2fe}
    .st-review{background:#e0f2fe;color:#0369a1;border-color:#bae6fd}
    .st-approved{background:#dcfce7;color:#15803d;border-color:#bbf7d0}
    .st-progress{background:#fef3c7;color:#b45309;border-color:#fde68a}
    .st-done{background:#d1fae5;color:#047857;border-color:#a7f3d0}
    .st-rejected{background:#fee2e2;color:#b91c1c;border-color:#fecaca}
    .pr-low{background:#e8faf0;color:#0f766e;border-color:#b7f0df}
    .pr-medium{background:#e5edff;color:#1d4ed8;border-color:#bfdbfe}
    .pr-high{background:#fff4de;color:#b45309;border-color:#fde68a}
    .pr-critical{background:#ffe4e6;color:#be123c;border-color:#fecdd3}

    .pl-meta{font-size:.76rem;color:#71717a;margin-bottom:8px}
    .pl-desc{color:#71717a;font-size:.82rem;line-height:1.45;white-space:pre-wrap}

    /* Side panel */
    .pl-side{border-left:1px solid var(--border);padding-left:16px;display:grid;gap:10px;align-content:start}
    .pl-sblock{border:1px solid var(--border);border-radius:10px;padding:10px 12px;background:#fafbfc}
    .pl-stitle{font-size:.66rem;text-transform:uppercase;letter-spacing:.07em;color:#71717a;font-weight:700;margin-bottom:6px}
    .pl-stext{font-size:.78rem;color:var(--text-secondary)}
    .pl-smuted{font-size:.74rem;color:#a1a1aa}
    .pl-slink{font-size:.74rem;text-decoration:none}
    .pl-spics{display:flex;flex-wrap:wrap;gap:5px}
    .pl-spic{font-size:.7rem;background:#eef2f7;color:#71717a;border-radius:999px;padding:3px 8px}
    .pl-fprog-label{display:flex;justify-content:space-between;font-size:.72rem;color:#71717a;margin-bottom:4px}
    .pl-fprog{height:6px;background:#edf2f7;border-radius:999px;overflow:hidden}
    .pl-fprog-bar{height:100%;background:linear-gradient(90deg,#34d399,#3b82f6);border-radius:999px}
    .pl-flist{margin-top:6px;display:grid;gap:3px}
    .pl-fitem{font-size:.72rem;color:#71717a;display:flex;align-items:center;gap:5px}
    .pl-fitem i{color:#94a3b8}

    /* Empty */
    .pl-empty{border:1px dashed #d1d5db;background:#fafbfc;color:#71717a;border-radius:14px;text-align:center;padding:48px 16px}

    @@media(max-width:1199px){.pl-card-body{grid-template-columns:1fr}.pl-side{border-left:none;border-top:1px solid var(--border);padding-left:0;padding-top:12px;grid-template-columns:repeat(2,minmax(0,1fr))}}
    @@media(max-width:767px){.pl-hero{padding:20px 18px}.pl-hero-title{font-size:1.3rem}.pl-title-link{font-size:1.05rem}.pl-side{grid-template-columns:1fr}.pl-card-body{padding:14px}}
</style>

<div class="pl-shell">
    <div class="pl-hero">
        <div>
            <div class="pl-hero-badge"><i class="bi bi-grid-1x2-fill"></i> Workspace</div>
            <div class="pl-hero-title">Projects</div>
            <div class="pl-hero-sub">Track stage, ownership, and checklist progress in one view.</div>
        </div>
        <div class="pl-hero-actions">
            <span class="pl-total">@Model.Count total</span>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="pl-btn-new" data-onboarding-id="project-create-entry">
                    <i class="bi bi-plus-circle"></i> New project
                </a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="pl-empty">
            <div class="mb-2"><i class="bi bi-inboxes" style="font-size:1.6rem;color:#a1a1aa"></i></div>
            <div class="fw-semibold mb-1">No projects yet</div>
            <div class="small text-muted mb-3">Create your first project to get started.</div>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="pl-btn-new" data-onboarding-id="project-create-entry">
                    <i class="bi bi-plus-circle"></i> Create first project
                </a>
            }
        </div>
    }
    else
    {
        <div class="pl-list">
            @foreach (var cr in Model)
            {
                var sc = statusClass.GetValueOrDefault(cr.Status.ToString(), "st-draft");
                var pc = priorityClass.GetValueOrDefault(cr.Priority.ToString(), "pr-medium");
                var totalFeatures = cr.Features.Count;
                var completedFeatures = cr.Features.Count(f => f.IsCompleted);
                var featurePercent = totalFeatures == 0 ? 0 : (int)Math.Round(completedFeatures * 100.0 / totalFeatures);

                var summary = string.IsNullOrWhiteSpace(cr.Description)
                    ? null
                    : (cr.Description!.Length > 220 ? $"{cr.Description[..220]}..." : cr.Description);

                <article class="pl-card">
                    <div class="pl-card-head">
                        <span class="pl-cr-num">@cr.CrNumber</span>
                        <div class="pl-card-actions">
                            <a asp-action="Details" asp-route-id="@cr.Id" class="pl-act" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@cr.Id" class="pl-act" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@cr.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete @cr.CrNumber?')">
                                    @Html.AntiForgeryToken()
                                    <button class="pl-act pl-act-del" title="Delete" type="submit">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="pl-card-body">
                        <div>
                            <div class="pl-title-row">
                                <a asp-action="Details" asp-route-id="@cr.Id" class="pl-title-link">@cr.Title</a>
                                @if (!string.IsNullOrWhiteSpace(cr.FigmaLink))
                                {
                                    <a href="@cr.FigmaLink" target="_blank" rel="noopener" class="pl-act" title="Open Figma" style="width:26px;height:26px;font-size:.72rem">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                            </div>

                            <div class="pl-badges">
                                <span class="pl-pill @sc">@cr.Status</span>
                                <span class="pl-pill @pc">@cr.Priority</span>
                            </div>

                            <div class="pl-meta">
                                Created @cr.CreatedAt.ToString("MMM dd, yyyy") by @(cr.CreatedBy?.FullName ?? "Unknown")
                            </div>

                            @if (!string.IsNullOrWhiteSpace(summary))
                            {
                                <p class="pl-desc">@summary</p>
                            }
                        </div>

                        <aside class="pl-side">
                            <div class="pl-sblock">
                                <div class="pl-stitle">Features checklist</div>
                                @if (totalFeatures == 0)
                                {
                                    <div class="pl-smuted">No features tracked.</div>
                                }
                                else
                                {
                                    var featurePreview = cr.Features
                                        .OrderBy(f => f.Name)
                                        .Take(3)
                                        .ToList();
                                    <div class="pl-fprog-label">
                                        <span>@completedFeatures / @totalFeatures</span>
                                        <span>@featurePercent%</span>
                                    </div>
                                    <div class="pl-fprog">
                                        <div class="pl-fprog-bar" style="width:@featurePercent%"></div>
                                    </div>
                                    <div class="pl-flist">
                                        @foreach (var feature in featurePreview)
                                        {
                                            <div class="pl-fitem">
                                                <i class="bi @(feature.IsCompleted ? "bi-check-circle-fill text-success" : "bi-circle")"></i>
                                                <span>@feature.Name</span>
                                            </div>
                                        }
                                        @if (totalFeatures > featurePreview.Count)
                                        {
                                            <div class="pl-smuted">+@(totalFeatures - featurePreview.Count) more feature(s)</div>
                                        }
                                    </div>
                                }
                                <a asp-action="Features" asp-route-projectId="@cr.Id" class="pl-slink d-block mt-2">
                                    <i class="bi bi-arrow-up-right-square me-1"></i>Open feature view
                                </a>
                            </div>

                            <div class="pl-sblock">
                                <div class="pl-stitle">Timeline</div>
                                @if (cr.TimelineStart.HasValue || cr.TimelineEnd.HasValue)
                                {
                                    <div class="pl-stext">
                                        @(cr.TimelineStart?.ToString("MMM dd, yyyy") ?? "?")
                                        <i class="bi bi-arrow-right mx-1"></i>
                                        @(cr.TimelineEnd?.ToString("MMM dd, yyyy") ?? "?")
                                    </div>
                                }
                                else
                                {
                                    <div class="pl-smuted">No timeline set.</div>
                                }
                            </div>

                            <div class="pl-sblock">
                                <div class="pl-stitle">Technology / languages</div>
                                @if (!string.IsNullOrWhiteSpace(cr.TechnologyStack))
                                {
                                    <div class="pl-stext">@cr.TechnologyStack</div>
                                }
                                else
                                {
                                    <div class="pl-smuted">No technology data.</div>
                                }
                            </div>

                            <div class="pl-sblock">
                                <div class="pl-stitle">Links</div>
                                @if (!string.IsNullOrWhiteSpace(cr.GitHubRepoUrl))
                                {
                                    <a href="@cr.GitHubRepoUrl" target="_blank" rel="noopener" class="pl-slink d-block">
                                        <i class="bi bi-github me-1"></i>Open repository
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(cr.FigmaLink))
                                {
                                    <a href="@cr.FigmaLink" target="_blank" rel="noopener" class="pl-slink d-block">
                                        <i class="bi bi-vector-pen me-1"></i>Open Figma
                                    </a>
                                }
                                @if (string.IsNullOrWhiteSpace(cr.GitHubRepoUrl) && string.IsNullOrWhiteSpace(cr.FigmaLink))
                                {
                                    <div class="pl-smuted">No links attached.</div>
                                }
                            </div>

                            <div class="pl-sblock">
                                <div class="pl-stitle">Person in charge</div>
                                @if (cr.Pics.Any())
                                {
                                    <div class="pl-spics">
                                        @foreach (var pic in cr.Pics.Take(3))
                                        {
                                            <span class="pl-spic">@pic.Employee?.FullName</span>
                                        }
                                        @if (cr.Pics.Count > 3)
                                        {
                                            <span class="pl-spic">+@(cr.Pics.Count - 3)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="pl-smuted">No PIC assigned.</div>
                                }
                            </div>
                        </aside>
                    </div>
                </article>
            }
        </div>
    }
</div>

@model List<WFHMonitor.Models.ChangeRequest>
@{ ViewData["Title"] = "Projects"; }

@{
    var statCls = new Dictionary<string, string> {
        {"Draft","dp-badge-slate"}, {"InReview","dp-badge-sky"}, {"Approved","dp-badge-indigo"},
        {"InProgress","dp-badge-amber"}, {"Done","dp-badge-green"}, {"Rejected","dp-badge-red"}
    };
    var prioCls = new Dictionary<string, string> {
        {"Low","dp-badge-green"}, {"Medium","dp-badge-indigo"}, {"High","dp-badge-amber"}, {"Critical","dp-badge-red"}
    };
}

<div class="mod-header">
    <div class="mod-header-left">
        <h1 class="mod-title"><i class="bi bi-file-earmark-diff" style="color:#818cf8"></i> Projects</h1>
        <p class="mod-subtitle">All projects across the team</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="dp-btn-primary">
            <i class="bi bi-plus-circle"></i> New Project
        </a>
    }
</div>

<div class="dp" style="--dp-color:#6366f1">
    <div class="dp-header">
        <div class="dp-header-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
            <i class="bi bi-folder2-open"></i>
        </div>
        <span class="dp-header-title">All Projects</span>
        <span class="dp-header-count">@Model.Count total</span>
    </div>

    @if (!Model.Any())
    {
        <div class="dp-empty">
            <i class="bi bi-file-earmark-diff"></i>
            No projects yet
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="dp-btn-primary mt-2"><i class="bi bi-plus-circle"></i> Create First Project</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="dp-table">
                <thead>
                    <tr>
                        <th>Project #</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>GitHub</th>
                        <th>PIC</th>
                        <th>Timeline</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cr in Model)
                    {
                        var sc = statCls.GetValueOrDefault(cr.Status.ToString(), "dp-badge-slate");
                        var pc = prioCls.GetValueOrDefault(cr.Priority.ToString(), "dp-badge-slate");
                        <tr>
                            <td class="dp-cell-mono">@cr.CrNumber</td>
                            <td class="dp-cell-title">
                                <a asp-action="Details" asp-route-id="@cr.Id">@cr.Title</a>
                                @if (!string.IsNullOrEmpty(cr.FigmaLink))
                                {
                                    <a href="@cr.FigmaLink" target="_blank" class="ms-2 dp-cell-muted" title="Figma">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                            </td>
                            <td><span class="dp-badge @sc">@cr.Status</span></td>
                            <td><span class="dp-badge @pc">@cr.Priority</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(cr.GitHubRepoUrl))
                                {
                                    <a href="@cr.GitHubRepoUrl" target="_blank" rel="noopener" class="dp-btn" title="Open repo">
                                        <i class="bi bi-github"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="dp-cell-muted">—</span>
                                }
                            </td>
                            <td>
                                @foreach (var pic in cr.Pics.Take(3))
                                {
                                    <span class="dp-badge dp-badge-slate me-1">@pic.Employee?.FullName</span>
                                }
                                @if (cr.Pics.Count > 3)
                                {
                                    <span class="dp-cell-muted">+@(cr.Pics.Count - 3)</span>
                                }
                            </td>
                            <td class="dp-cell-muted" style="font-size:0.75rem;white-space:nowrap">
                                @if (cr.TimelineStart.HasValue || cr.TimelineEnd.HasValue)
                                {
                                    @(cr.TimelineStart?.ToString("MMM dd") ?? "?")<span class="mx-1" style="color:#334155">→</span>@(cr.TimelineEnd?.ToString("MMM dd") ?? "?")
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@cr.Id" class="dp-btn" title="View">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@cr.Id" class="dp-btn dp-btn-warn" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@cr.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete @cr.CrNumber?')">
                                            @Html.AntiForgeryToken()
                                            <button class="dp-btn dp-btn-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

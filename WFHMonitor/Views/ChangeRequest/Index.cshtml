@model List<WFHMonitor.Models.ChangeRequest>
@{
    ViewData["Title"] = "Projects";

    var statusClsMap = new Dictionary<string, string> {
        {"Draft","pl-st-draft"}, {"InReview","pl-st-review"}, {"Approved","pl-st-approved"},
        {"InProgress","pl-st-progress"}, {"Done","pl-st-done"}, {"Rejected","pl-st-rejected"}
    };
    var priorityClsMap = new Dictionary<string, string> {
        {"Low","pl-pr-low"}, {"Medium","pl-pr-medium"}, {"High","pl-pr-high"}, {"Critical","pl-pr-critical"}
    };
}

<style>
    .pl-shell{max-width:1420px;margin:0 auto}

    .pl-hero{position:relative;background:var(--bg-dark);border:1px solid rgba(16,185,129,.18);border-radius:16px;padding:28px 32px 24px;margin-bottom:20px;overflow:hidden;display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap}
    .pl-hero::before{content:'';position:absolute;top:-60px;right:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(16,185,129,.12) 0%,transparent 70%);pointer-events:none}
    .pl-hero-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(16,185,129,.12);border:1px solid rgba(16,185,129,.25);color:#34d399;font-size:.66rem;font-weight:700;padding:3px 10px;border-radius:999px;letter-spacing:.06em;text-transform:uppercase;margin-bottom:6px}
    .pl-hero-title{font-size:1.6rem;font-weight:800;color:#f4f5f7;letter-spacing:-.02em;line-height:1.15}
    .pl-hero-sub{font-size:.76rem;color:#a1a1aa;margin-top:3px;font-weight:500}
    .pl-hero-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;position:relative;z-index:1}
    .pl-total{font-size:.72rem;font-weight:700;border-radius:999px;padding:5px 12px;background:rgba(255,255,255,.08);color:#a1a1aa;border:1px solid rgba(255,255,255,.1)}
    .pl-btn-new{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:9px 20px;font-size:.82rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .2s ease;text-decoration:none;letter-spacing:.01em}
    .pl-btn-new:hover{background:var(--accent-hover);color:#fff;transform:translateY(-1px);box-shadow:0 6px 18px rgba(16,185,129,.25)}
    .pl-filter-btn{background:rgba(255,255,255,.08);color:#a1a1aa;border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:7px 11px;font-size:.76rem;font-weight:600;display:inline-flex;align-items:center;gap:5px;text-decoration:none;transition:all .15s ease}
    .pl-filter-btn:hover{background:rgba(255,255,255,.14);color:#f4f5f7}

    .pl-filters{display:grid;grid-template-columns:minmax(280px,1fr) 170px 170px auto;gap:10px;align-items:center;margin-bottom:14px}
    .pl-input,.pl-select{background:#fff;border:1px solid #d1d5db;border-radius:10px;padding:10px 12px;font-size:.82rem;color:var(--text-primary);font-family:inherit}
    .pl-input:focus,.pl-select:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-bg)}
    .pl-filter-clear{border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--text-secondary);padding:10px 12px;font-size:.8rem;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;transition:all .15s ease}
    .pl-filter-clear:hover{border-color:#a1a1aa;color:var(--text-primary)}

    .pl-section{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;overflow:hidden;transition:box-shadow .2s ease}
    .pl-section:hover{box-shadow:0 8px 28px rgba(0,0,0,.06)}
    .pl-section-head{display:flex;align-items:center;gap:10px;padding:14px 20px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,#fafbfc,#f6f7f9)}
    .pl-section-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
    .pl-section-label{font-size:.82rem;font-weight:700;color:var(--text-primary);letter-spacing:.01em}
    .pl-badge-count{font-size:.66rem;font-weight:700;border-radius:999px;padding:2px 8px;background:#eef2f7;color:#71717a;margin-left:4px}

    .pl-table{width:100%;border-collapse:collapse;font-size:.82rem}
    .pl-table th{font-size:.7rem;font-weight:700;color:#71717a;text-transform:uppercase;letter-spacing:.04em;padding:10px 12px;border-bottom:2px solid var(--border);background:#fafbfc}
    .pl-table td{padding:10px 12px;border-bottom:1px solid var(--border);color:var(--text-secondary);vertical-align:middle}
    .pl-table tr:last-child td{border-bottom:none}
    .pl-table tr:hover td{background:#fafbfc}
    .pl-cr-num{font-family:Consolas,Monaco,monospace;font-size:.74rem;font-weight:700;color:var(--accent)}
    .pl-title-link{font-weight:600;text-decoration:none;color:var(--text-primary);transition:color .15s ease}
    .pl-title-link:hover{color:var(--accent)}
    .pl-title-sub{font-size:.74rem;color:#a1a1aa;margin-top:2px}
    .pl-muted{font-size:.78rem;color:#a1a1aa}

    .pl-pill{font-size:.7rem;font-weight:700;border-radius:999px;padding:3px 10px;border:1px solid transparent;display:inline-block}
    .pl-st-draft{background:#eef2ff;color:#4f46e5;border-color:#c7d2fe}
    .pl-st-review{background:#e0f2fe;color:#0369a1;border-color:#bae6fd}
    .pl-st-approved{background:#dcfce7;color:#15803d;border-color:#bbf7d0}
    .pl-st-progress{background:#fef3c7;color:#b45309;border-color:#fde68a}
    .pl-st-done{background:#d1fae5;color:#047857;border-color:#a7f3d0}
    .pl-st-rejected{background:#fee2e2;color:#b91c1c;border-color:#fecaca}
    .pl-pr-low{background:#ecfdf5;color:#047857;border-color:#a7f3d0}
    .pl-pr-medium{background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}
    .pl-pr-high{background:#fff7ed;color:#c2410c;border-color:#fed7aa}
    .pl-pr-critical{background:#fef2f2;color:#b91c1c;border-color:#fecaca}

    .pl-feat-progress{min-width:140px}
    .pl-feat-label{display:flex;justify-content:space-between;font-size:.72rem;color:#71717a;margin-bottom:4px}
    .pl-feat-track{height:6px;background:#edf2f7;border-radius:999px;overflow:hidden}
    .pl-feat-fill{height:100%;background:linear-gradient(90deg,#34d399,#3b82f6);border-radius:999px}

    .pl-act{width:30px;height:30px;border-radius:8px;border:1px solid #d1d5db;color:#71717a;background:#fff;display:inline-flex;align-items:center;justify-content:center;text-decoration:none;transition:all .15s ease;font-size:.8rem;cursor:pointer}
    .pl-act:hover{background:#f8fafc;color:#111827;border-color:#a1a1aa}
    .pl-act-del:hover{border-color:#fecaca;color:#dc2626;background:#fef2f2}

    .pl-empty{padding:40px 20px;text-align:center;color:#a1a1aa;font-size:.88rem}
    .pl-empty i{font-size:2rem;display:block;margin-bottom:10px;opacity:.5}
    .pl-filter-empty{display:none;padding:20px;text-align:center;color:#a1a1aa;font-size:.82rem}

    @@media(max-width:991px){
        .pl-hero{padding:22px 18px 20px}
        .pl-hero-title{font-size:1.3rem}
        .pl-filters{grid-template-columns:1fr 1fr}
    }
    @@media(max-width:640px){
        .pl-filters{grid-template-columns:1fr}
    }
</style>

<div class="pl-shell">
    <section class="pl-hero">
        <div style="position:relative;z-index:1">
            <div class="pl-hero-badge"><i class="bi bi-grid-1x2-fill"></i> Workspace</div>
            <div class="pl-hero-title">Projects</div>
            <div class="pl-hero-sub">All projects in your workspace.</div>
        </div>
        <div class="pl-hero-actions">
            <a asp-action="Index" class="pl-filter-btn" title="Refresh">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
            <span class="pl-total"><span id="pl-visible-count">@Model.Count</span> total</span>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="pl-btn-new" data-onboarding-id="project-create-entry">
                    <i class="bi bi-plus-circle"></i> New project
                </a>
            }
        </div>
    </section>

    @if (!Model.Any())
    {
        <div class="pl-section">
            <div class="pl-empty">
                <i class="bi bi-inboxes"></i>
                No projects yet.
            </div>
        </div>
    }
    else
    {
        <div class="pl-filters">
            <input id="pl-search" type="text" class="pl-input" placeholder="Search projects..." />
            <select id="pl-status" class="pl-select">
                <option value="">All status</option>
                @foreach (var statusValue in Enum.GetValues<WFHMonitor.Models.CrStatus>())
                {
                    <option value="@statusValue">@statusValue</option>
                }
            </select>
            <select id="pl-priority" class="pl-select">
                <option value="">All priority</option>
                @foreach (var priorityValue in Enum.GetValues<WFHMonitor.Models.CrPriority>())
                {
                    <option value="@priorityValue">@priorityValue</option>
                }
            </select>
            <button id="pl-clear" type="button" class="pl-filter-clear"><i class="bi bi-x-circle"></i> Clear</button>
        </div>

        <div class="pl-section">
            <div class="pl-section-head">
                <div class="pl-section-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-kanban"></i></div>
                <div class="pl-section-label">All projects <span class="pl-badge-count" id="pl-badge-count">@Model.Count</span></div>
            </div>

            <div style="overflow-x:auto">
                <table class="pl-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Project</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Timeline</th>
                            <th>Features</th>
                            <th style="text-align:right">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="pl-rows">
                        @foreach (var cr in Model)
                        {
                            var statusKey = cr.Status.ToString();
                            var priorityKey = cr.Priority.ToString();
                            var statusClass = statusClsMap.GetValueOrDefault(statusKey, "pl-st-draft");
                            var priorityClass = priorityClsMap.GetValueOrDefault(priorityKey, "pl-pr-medium");
                            var timeline = cr.TimelineStart.HasValue || cr.TimelineEnd.HasValue
                                ? $"{cr.TimelineStart?.ToString("MMM dd")} to {cr.TimelineEnd?.ToString("MMM dd")}"
                                : "Not set";
                            var totalFeatures = cr.Features.Count;
                            var completedFeatures = cr.Features.Count(f => f.IsCompleted);
                            var featurePercent = totalFeatures == 0 ? 0 : (int)Math.Round(completedFeatures * 100.0 / totalFeatures);

                            <tr class="pl-row"
                                data-search="@($"{cr.CrNumber} {cr.Title} {cr.Description}").ToLowerInvariant()"
                                data-status="@statusKey"
                                data-priority="@priorityKey">
                                <td><span class="pl-cr-num">@cr.CrNumber</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@cr.Id" class="pl-title-link">@cr.Title</a>
                                    <div class="pl-title-sub">Created @cr.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </td>
                                <td><span class="pl-pill @statusClass">@cr.Status</span></td>
                                <td><span class="pl-pill @priorityClass">@cr.Priority</span></td>
                                <td><span class="pl-muted">@timeline</span></td>
                                <td>
                                    @if (totalFeatures == 0)
                                    {
                                        <span class="pl-muted">No data</span>
                                    }
                                    else
                                    {
                                        <div class="pl-feat-progress">
                                            <div class="pl-feat-label">
                                                <span>@completedFeatures/@totalFeatures</span>
                                                <span>@featurePercent%</span>
                                            </div>
                                            <div class="pl-feat-track">
                                                <div class="pl-feat-fill" style="width:@featurePercent%"></div>
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td style="text-align:right;white-space:nowrap">
                                    <a asp-action="Details" asp-route-id="@cr.Id" class="pl-act" title="View" style="margin-right:4px">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Features" asp-route-projectId="@cr.Id" class="pl-act" title="Open features" style="margin-right:4px">
                                        <i class="bi bi-list-check"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@cr.Id" class="pl-act" title="Edit" style="margin-right:4px">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@cr.Id" method="post" class="d-inline" onsubmit="return confirm('Delete @cr.CrNumber?')">
                                            @Html.AntiForgeryToken()
                                            <button class="pl-act pl-act-del" title="Delete" type="submit"><i class="bi bi-trash"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="pl-filter-empty" class="pl-filter-empty">No projects match the current filters.</div>
        </div>
    }
</div>

<script>
    (function () {
        var searchInput = document.getElementById('pl-search');
        var statusSelect = document.getElementById('pl-status');
        var prioritySelect = document.getElementById('pl-priority');
        var clearButton = document.getElementById('pl-clear');
        var rows = Array.prototype.slice.call(document.querySelectorAll('.pl-row'));
        var visibleCount = document.getElementById('pl-visible-count');
        var badgeCount = document.getElementById('pl-badge-count');
        var emptyState = document.getElementById('pl-filter-empty');

        if (!searchInput || !statusSelect || !prioritySelect || !clearButton || rows.length === 0)
            return;

        function applyFilters() {
            var search = (searchInput.value || '').toLowerCase().trim();
            var status = (statusSelect.value || '').trim();
            var priority = (prioritySelect.value || '').trim();
            var count = 0;

            rows.forEach(function (row) {
                var rowSearch = (row.getAttribute('data-search') || '');
                var rowStatus = (row.getAttribute('data-status') || '');
                var rowPriority = (row.getAttribute('data-priority') || '');

                var matchesSearch = search === '' || rowSearch.indexOf(search) >= 0;
                var matchesStatus = status === '' || rowStatus === status;
                var matchesPriority = priority === '' || rowPriority === priority;
                var visible = matchesSearch && matchesStatus && matchesPriority;

                row.style.display = visible ? '' : 'none';
                if (visible) count++;
            });

            if (visibleCount) visibleCount.textContent = String(count);
            if (badgeCount) badgeCount.textContent = String(count);
            if (emptyState) emptyState.style.display = count === 0 ? 'block' : 'none';
        }

        searchInput.addEventListener('input', applyFilters);
        statusSelect.addEventListener('change', applyFilters);
        prioritySelect.addEventListener('change', applyFilters);
        clearButton.addEventListener('click', function () {
            searchInput.value = '';
            statusSelect.value = '';
            prioritySelect.value = '';
            applyFilters();
        });
    })();
</script>

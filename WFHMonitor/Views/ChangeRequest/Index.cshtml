@model List<WFHMonitor.Models.ChangeRequest>
@{ ViewData["Title"] = "Projects"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-muted mb-0 small">All projects across the team</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-2"></i>New Project
        </a>
    }
</div>

@{
    var statColors = new Dictionary<string, string> {
        {"Draft","secondary"}, {"InReview","info"}, {"Approved","primary"},
        {"InProgress","warning"}, {"Done","success"}, {"Rejected","danger"}
    };
    var prioColors = new Dictionary<string, string> {
        {"Low","success"}, {"Medium","primary"}, {"High","warning"}, {"Critical","danger"}
    };
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-file-earmark-diff text-muted" style="font-size:3.5rem;"></i>
            <p class="mt-3 text-muted">No projects yet.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary mt-1">
                    <i class="bi bi-plus-circle me-2"></i>Create First Project
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Project #</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>GitHub</th>
                        <th>PIC</th>
                        <th>Timeline</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cr in Model)
                    {
                        var sColor = statColors.GetValueOrDefault(cr.Status.ToString(), "secondary");
                        var pColor = prioColors.GetValueOrDefault(cr.Priority.ToString(), "secondary");
                        <tr>
                            <td>
                                <span class="fw-semibold text-muted small">@cr.CrNumber</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@cr.Id" class="fw-semibold text-dark text-decoration-none">
                                    @cr.Title
                                </a>
                                @if (!string.IsNullOrEmpty(cr.FigmaLink))
                                {
                                    <a href="@cr.FigmaLink" target="_blank" class="ms-2 text-muted small" title="Figma">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                }
                            </td>
                            <td><span class="badge bg-@sColor">@cr.Status</span></td>
                            <td><span class="badge bg-@pColor">@cr.Priority</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(cr.GitHubRepoUrl))
                                {
                                    <a href="@cr.GitHubRepoUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-dark">
                                        <i class="bi bi-github me-1"></i>Open
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @foreach (var pic in cr.Pics.Take(3))
                                {
                                    <span class="badge bg-light text-dark border me-1 small">
                                        @pic.Employee?.FullName
                                    </span>
                                }
                                @if (cr.Pics.Count > 3)
                                {
                                    <span class="text-muted small">+@(cr.Pics.Count - 3) more</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @if (cr.TimelineStart.HasValue || cr.TimelineEnd.HasValue)
                                {
                                    @(cr.TimelineStart?.ToString("MMM dd") ?? "?")
                                    <span class="mx-1">→</span>
                                    @(cr.TimelineEnd?.ToString("MMM dd") ?? "?")
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@cr.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@cr.Id" class="btn btn-sm btn-outline-warning me-1">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@cr.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete @cr.CrNumber?')">
                                        @Html.AntiForgeryToken()
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

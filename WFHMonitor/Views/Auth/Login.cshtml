@model LoginViewModel
@{ ViewData["Title"] = "Login"; Layout = null; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - Softracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --bg-dark: #18181b;
            --accent: #10b981;
            --accent-hover: #059669;
            --radius: 14px;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            -webkit-font-smoothing: antialiased;
            background: var(--bg-dark);
            position: relative;
            overflow: hidden;
        }

        /* ambient gradient orbs */
        body::before {
            content: '';
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(16,185,129,0.12) 0%, transparent 70%);
            top: -200px;
            right: -150px;
            pointer-events: none;
        }
        body::after {
            content: '';
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 70%);
            bottom: -200px;
            left: -100px;
            pointer-events: none;
        }

        /* noise overlay */
        .noise {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
        }

        .login-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 400px;
            padding: 0 20px;
        }

        .brand {
            text-align: center;
            margin-bottom: 32px;
        }

        .brand-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 48px;
            height: 48px;
            background: var(--accent);
            border-radius: 12px;
            font-size: 1.3rem;
            color: #fff;
            margin-bottom: 14px;
            box-shadow: 0 0 24px rgba(16,185,129,0.3);
        }

        .brand h1 {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: -0.04em;
            color: #fafafa;
            margin: 0 0 4px;
        }

        .brand p {
            font-size: 0.82rem;
            color: #71717a;
            margin: 0;
        }

        .login-card {
            background: #1f1f23;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: var(--radius);
            padding: 32px 28px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }

        .login-card .form-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: #a1a1aa;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        .login-card .form-control {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            color: #e4e4e7;
            padding: 10px 14px;
            font-size: 0.9rem;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .login-card .form-control::placeholder {
            color: #52525b;
        }

        .login-card .form-control:focus {
            background: rgba(255,255,255,0.06);
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(16,185,129,0.12);
            color: #fafafa;
        }

        .login-card .input-group-text {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            border-right: none;
            color: #71717a;
            padding: 10px 12px;
        }

        .login-card .input-group .form-control {
            border-left: none;
        }

        .login-card .input-group:focus-within .input-group-text {
            border-color: var(--accent);
            color: var(--accent);
        }

        .login-card .form-check-input {
            background-color: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.12);
        }

        .login-card .form-check-input:checked {
            background-color: var(--accent);
            border-color: var(--accent);
        }

        .login-card .form-check-label {
            color: #a1a1aa;
            font-size: 0.84rem;
        }

        .btn-sign-in {
            width: 100%;
            padding: 11px 20px;
            background: var(--accent);
            border: none;
            border-radius: 8px;
            color: #fff;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-sign-in:hover {
            background: var(--accent-hover);
            box-shadow: 0 4px 16px rgba(16,185,129,0.3);
            transform: translateY(-1px);
        }

        .btn-sign-in:active {
            transform: scale(0.98) translateY(0);
        }

        .btn-register-link {
            display: inline-flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            margin-top: 10px;
            padding: 10px 20px;
            border: 1px solid rgba(255,255,255,0.14);
            border-radius: 8px;
            color: #d4d4d8;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.86rem;
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .btn-register-link:hover {
            border-color: rgba(255,255,255,0.24);
            background: rgba(255,255,255,0.04);
            color: #fafafa;
        }

        .login-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 0.76rem;
            color: #52525b;
        }

        .alert-danger {
            background: rgba(239,68,68,0.1);
            border: 1px solid rgba(239,68,68,0.2);
            color: #fca5a5;
            border-radius: 8px;
            font-size: 0.82rem;
        }

        .text-danger {
            color: #fca5a5 !important;
            font-size: 0.76rem;
        }

        /* entry animation */
        .login-container {
            animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <div class="noise"></div>

    <div class="login-container">
        <div class="brand">
            <div class="brand-icon"><img src="/images/cat1.jpg" style="width:48px;height:48px;object-fit:contain;border-radius:10px" /></div>
            <h1>Softracker</h1>
            <p>Track your web development in our command center</p>
        </div>

        <div class="login-card">
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="All" class="alert alert-danger small d-none" id="valSummary"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@company.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
                </div>

                <button type="submit" class="btn-sign-in">
                    Sign in
                </button>

                <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="btn-register-link">
                    Create account
                </a>
            </form>
        </div>

        <div class="login-footer">
            Use your authorized account credentials to sign in.
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @{ var hasErrors = !ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0; }
    @if (hasErrors)
    {
        <script>document.getElementById('valSummary').classList.remove('d-none');</script>
    }
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>

@model AdminDashboardViewModel
@{ ViewData["Title"] = "Admin Dashboard"; }

@{
    var bugResolutionPercent = Model.TotalBugs == 0 ? 100 : (int)Math.Round(Model.CompleteBugs * 100.0 / Model.TotalBugs);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1" style="font-size:1.25rem; font-weight:800; letter-spacing:-0.03em; color:var(--text-primary);">
            Dashboard
        </h2>
        <p class="mb-0" style="font-size:0.8rem; color:var(--text-muted);">
            @Model.Today.ToString("dddd, MMMM dd yyyy")
        </p>
    </div>
</div>

@* Summary Stats — no generic 4-card row, use asymmetric 2-col zig-zag *@
<div class="row g-3 mb-4 stagger">
    <div class="col-sm-6 col-lg-3">
        <div class="dash-stat dash-stat-blue">
            <div class="dash-stat-icon"><i class="bi bi-people"></i></div>
            <div class="dash-stat-value">@Model.TotalEmployees</div>
            <div class="dash-stat-label">Team members</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-stat dash-stat-emerald">
            <div class="dash-stat-icon"><i class="bi bi-check-circle"></i></div>
            <div class="dash-stat-value">@Model.TasksDoneTodayCount</div>
            <div class="dash-stat-label">Tasks done today</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-stat dash-stat-amber">
            <div class="dash-stat-icon"><i class="bi bi-slash-circle"></i></div>
            <div class="dash-stat-value">@Model.BlockedTasks.Count</div>
            <div class="dash-stat-label">Blocked tasks</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="dash-stat dash-stat-rose">
            <div class="dash-stat-icon"><i class="bi bi-bug"></i></div>
            <div class="dash-stat-value" style="font-variant-numeric:tabular-nums">@Model.OpenBugs<span style="font-size:0.9rem;font-weight:500;color:inherit;opacity:0.5">/@Model.TotalBugs</span></div>
            <div class="dash-stat-label">Open bugs</div>
        </div>
    </div>
</div>

@* Project Overview — refined table *@
@if (Model.Projects.Any())
{
    <div class="project-table mb-4 animate-in" style="background:var(--bg-surface)">
        <div class="d-flex justify-content-between align-items-center px-3 py-2" style="border-bottom:1px solid var(--border-subtle)">
            <h6 class="mb-0 d-flex align-items-center gap-2" style="font-size:0.85rem; font-weight:700; letter-spacing:-0.01em">
                <i class="bi bi-folder2-open" style="color:var(--accent)"></i> Project overview
            </h6>
            <span style="font-size:0.68rem; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em">
                @Model.Projects.Count project(s)
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Project</th>
                        <th>Status</th>
                        <th>Stage</th>
                        <th style="min-width:180px">Task progress</th>
                        <th>Features</th>
                        <th>Bugs</th>
                        <th>Timeline</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Projects)
                    {
                        var progressColor = p.TaskCompletionPercent == 100 ? "bg-success"
                            : p.TaskCompletionPercent >= 50 ? "bg-primary"
                            : p.TaskCompletionPercent > 0 ? "bg-warning" : "bg-secondary";

                        var statusBadge = p.Status switch
                        {
                            CrStatus.Done => "bg-success",
                            CrStatus.InProgress => "bg-primary",
                            CrStatus.InReview => "bg-info",
                            CrStatus.Approved => "bg-info",
                            CrStatus.Rejected => "bg-danger",
                            _ => "bg-secondary"
                        };

                        var priorityBadge = p.Priority switch
                        {
                            CrPriority.Critical => "bg-danger",
                            CrPriority.High => "bg-warning text-dark",
                            CrPriority.Medium => "bg-info text-dark",
                            _ => "bg-light text-dark border"
                        };

                        <tr>
                            <td>
                                <div>
                                    <a asp-controller="ChangeRequest" asp-action="Details" asp-route-id="@p.Id"
                                       class="fw-semibold text-decoration-none" style="color:var(--text-primary)">@p.Title</a>
                                </div>
                                <small style="color:var(--text-muted); font-family:var(--font-mono); font-size:0.72rem">@p.CrNumber</small>
                                <span class="badge @priorityBadge ms-1" style="font-size:0.6rem">@p.Priority</span>
                            </td>
                            <td><span class="badge @statusBadge">@p.Status</span></td>
                            <td><span style="color:var(--text-secondary); font-size:0.82rem">@p.Stage</span></td>
                            <td>
                                @if (p.TotalTasks > 0)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px">
                                            <div class="progress-bar @progressColor" role="progressbar"
                                                 style="width:@(p.TaskCompletionPercent)%; border-radius:999px"></div>
                                        </div>
                                        <small class="text-nowrap fw-semibold" style="font-variant-numeric:tabular-nums; font-size:0.78rem">@p.TaskCompletionPercent%</small>
                                    </div>
                                    <small style="color:var(--text-muted); font-size:0.72rem">@p.DoneTasks/@p.TotalTasks done</small>
                                    @if (p.BlockedTasks > 0)
                                    {
                                        <small class="text-danger ms-1" style="font-size:0.72rem">(@p.BlockedTasks blocked)</small>
                                    }
                                }
                                else
                                {
                                    <small style="color:var(--text-muted); font-style:italic">No tasks</small>
                                }
                            </td>
                            <td>
                                @if (p.TotalFeatures > 0)
                                {
                                    var fColor = p.FeatureCompletionPercent == 100 ? "bg-success"
                                        : p.FeatureCompletionPercent >= 50 ? "bg-primary"
                                        : p.FeatureCompletionPercent > 0 ? "bg-warning" : "bg-secondary";
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:5px; min-width:60px">
                                            <div class="progress-bar @fColor" role="progressbar"
                                                 style="width:@(p.FeatureCompletionPercent)%; border-radius:999px"></div>
                                        </div>
                                        <small class="text-nowrap" style="font-variant-numeric:tabular-nums; font-size:0.75rem">@p.CompletedFeatures/@p.TotalFeatures</small>
                                    </div>
                                }
                                else
                                {
                                    <small style="color:var(--text-muted)">-</small>
                                }
                            </td>
                            <td>
                                @if (p.TotalBugs > 0)
                                {
                                    <span class="badge bg-danger" style="font-size:0.65rem">@p.OpenBugs open</span>
                                    <span class="badge bg-success" style="font-size:0.65rem">@p.CompleteBugs fixed</span>
                                }
                                else
                                {
                                    <small style="color:var(--text-muted)">-</small>
                                }
                            </td>
                            <td>
                                @if (p.TimelineStart.HasValue && p.TimelineEnd.HasValue)
                                {
                                    <small style="font-size:0.78rem">@p.TimelineStart.Value.ToString("dd MMM") - @p.TimelineEnd.Value.ToString("dd MMM yy")</small>
                                    @if (p.IsOverdue)
                                    {
                                        <br /><span class="badge bg-danger" style="font-size:0.6rem">Overdue</span>
                                    }
                                    else if (p.DaysRemaining.HasValue && p.DaysRemaining.Value >= 0 && p.Status != CrStatus.Done)
                                    {
                                        <br /><small style="color:var(--text-muted); font-size:0.72rem">@p.DaysRemaining days left</small>
                                    }
                                }
                                else
                                {
                                    <small style="color:var(--text-muted)">-</small>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* Tasks & Blocked — side by side instead of stacked *@
<div class="row g-3">
    <div class="col-lg-6">
        <div class="task-list-section animate-in">
            <div class="task-list-header success">
                <i class="bi bi-check-circle"></i>
                Tasks completed today
                @if (Model.TasksDoneToday.Any())
                {
                    <span class="ms-auto badge rounded-pill" style="background:rgba(5,150,105,0.12); color:#059669; font-size:0.65rem">@Model.TasksDoneToday.Count()</span>
                }
            </div>
            @if (Model.TasksDoneToday.Any())
            {
                @foreach (var task in Model.TasksDoneToday)
                {
                    <div class="task-list-item">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check2" style="color:var(--color-success)"></i>
                            <span>@task.Title</span>
                        </div>
                        @if (task.Assignee != null)
                        {
                            <span style="font-size:0.72rem; color:var(--text-muted); font-weight:500">@task.Assignee.FullName</span>
                        }
                    </div>
                }
            }
            else
            {
                <div class="task-list-empty">
                    <i class="bi bi-inbox" style="font-size:1.5rem; opacity:0.25; display:block; margin-bottom:6px"></i>
                    No tasks completed today
                </div>
            }
        </div>
    </div>

    <div class="col-lg-6">
        <div class="task-list-section animate-in" style="animation-delay:80ms">
            <div class="task-list-header danger">
                <i class="bi bi-slash-circle"></i>
                Blocked tasks
                @if (Model.BlockedTasks.Any())
                {
                    <span class="ms-auto badge rounded-pill" style="background:rgba(220,38,38,0.1); color:#dc2626; font-size:0.65rem">@Model.BlockedTasks.Count</span>
                }
            </div>
            @if (Model.BlockedTasks.Any())
            {
                @foreach (var task in Model.BlockedTasks)
                {
                    <div class="task-list-item">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-slash-circle" style="color:var(--color-danger)"></i>
                            <span>@task.Title</span>
                        </div>
                        @if (task.Assignee != null)
                        {
                            <span style="font-size:0.72rem; color:var(--text-muted); font-weight:500">@task.Assignee.FullName</span>
                        }
                    </div>
                }
            }
            else
            {
                <div class="task-list-empty">
                    <i class="bi bi-shield-check" style="font-size:1.5rem; opacity:0.25; display:block; margin-bottom:6px"></i>
                    No blocked tasks
                </div>
            }
        </div>
    </div>
</div>

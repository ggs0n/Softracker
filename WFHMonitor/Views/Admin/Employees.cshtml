@model AdminEmployeesViewModel
@{ ViewData["Title"] = "Employees"; }

<div class="mod-header mb-4">
    <div class="mod-header-left">
        <h1 class="mod-title"><i class="bi bi-people-fill" style="color:#818cf8"></i> Employees</h1>
        <p class="mod-subtitle">Manage team members and access</p>
    </div>
</div>

<div class="row g-4">
    @* Employee list *@
    <div class="col-lg-7">
        <div class="dp" style="--dp-color:#6366f1">
            <div class="dp-header">
                <div class="dp-header-icon" style="background:rgba(99,102,241,0.15);color:#818cf8">
                    <i class="bi bi-people-fill"></i>
                </div>
                <span class="dp-header-title">Team Members</span>
                <span class="dp-header-count">@Model.Employees.Count() registered</span>
            </div>

            @if (!Model.Employees.Any())
            {
                <div class="dp-empty">
                    <i class="bi bi-person-x"></i>
                    No employees registered yet
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="dp-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Employees)
                            {
                                var roleCls = item.Role switch {
                                    "Admin"     => "dp-badge-red",
                                    "Developer" => "dp-badge-indigo",
                                    "Tester"    => "dp-badge-sky",
                                    "Agent"     => "dp-badge-green",
                                    _           => "dp-badge-slate"
                                };
                                <tr>
                                    <td style="color:#e2e8f0;font-weight:600">@item.Employee.FullName</td>
                                    <td class="dp-cell-muted">@item.Employee.Email</td>
                                    <td><span class="dp-badge @roleCls">@item.Role</span></td>
                                    <td class="text-end">
                                        <form asp-action="DeleteEmployee" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete @item.Employee.FullName? This cannot be undone.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@item.Employee.Id" />
                                            <button type="submit" class="dp-btn dp-btn-danger" title="Delete employee">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* Add Employee form *@
    <div class="col-lg-5">
        <div class="dp-form-panel">
            <div class="dp-header" style="background:rgba(231,76,111,0.08);border-bottom:1px solid rgba(255,255,255,0.06)">
                <div class="dp-header-icon" style="background:rgba(231,76,111,0.15);color:#f472b6">
                    <i class="bi bi-person-plus-fill"></i>
                </div>
                <span class="dp-header-title">Add Employee</span>
            </div>
            <div class="dp-form-body">
                <form asp-action="AddEmployee" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.FullName" class="dp-form-label">Full Name</label>
                        <input asp-for="NewEmployee.FullName" class="form-control dp-form-control" placeholder="John Doe" />
                        <span asp-validation-for="NewEmployee.FullName" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEmployee.Email" class="dp-form-label">Email</label>
                        <input asp-for="NewEmployee.Email" class="form-control dp-form-control" placeholder="user@company.com" />
                        <span asp-validation-for="NewEmployee.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEmployee.Role" class="dp-form-label">Role</label>
                        <select asp-for="NewEmployee.Role" class="form-select dp-form-select">
                            <option value="Employee">Employee</option>
                            <option value="Developer">Developer</option>
                            <option value="Tester">Tester</option>
                            <option value="Agent">Agent</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewEmployee.Password" class="dp-form-label">Password</label>
                        <input asp-for="NewEmployee.Password" type="password" autocomplete="new-password" class="form-control dp-form-control" />
                        <span asp-validation-for="NewEmployee.Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="NewEmployee.ConfirmPassword" class="dp-form-label">Confirm Password</label>
                        <input asp-for="NewEmployee.ConfirmPassword" type="password" autocomplete="new-password" class="form-control dp-form-control" />
                        <span asp-validation-for="NewEmployee.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="dp-btn-primary w-100" style="background:#e74c6f;justify-content:center">
                        <i class="bi bi-person-check"></i> Register Employee
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<WFHMonitor.ViewModels.DailyTaskReport>
@{ Layout = null; }

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Task Report - @ViewBag.CompanyName</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
            font-size: 12px;
            color: #18181b;
            padding: 32px 40px;
            line-height: 1.5;
        }

        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #10b981;
            padding-bottom: 16px;
            margin-bottom: 24px;
        }
        .report-title { font-size: 20px; font-weight: 800; color: #18181b; letter-spacing: -0.02em; }
        .report-subtitle { font-size: 11px; color: #71717a; margin-top: 2px; }
        .report-meta { text-align: right; font-size: 10px; color: #71717a; }
        .report-meta strong { color: #18181b; }

        .summary-bar {
            display: flex;
            gap: 24px;
            background: #f4f5f7;
            border: 1px solid #e4e4e7;
            border-radius: 8px;
            padding: 12px 20px;
            margin-bottom: 24px;
        }
        .summary-item { }
        .summary-value { font-size: 18px; font-weight: 800; color: #10b981; }
        .summary-label { font-size: 10px; color: #71717a; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600; }

        .day-section { margin-bottom: 20px; page-break-inside: avoid; }
        .day-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
            border-bottom: 1px solid #e4e4e7;
            padding-bottom: 6px;
        }
        .day-name { font-size: 13px; font-weight: 700; color: #18181b; }
        .day-date { font-size: 10px; color: #71717a; }
        .day-count {
            font-size: 9px; font-weight: 700; padding: 1px 7px; border-radius: 999px;
            background: rgba(16,185,129,0.1); color: #10b981;
        }
        .day-count.empty { background: rgba(161,161,170,0.1); color: #a1a1aa; }

        .task-table { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
        .task-table th {
            text-align: left; font-size: 9px; font-weight: 700; color: #71717a;
            text-transform: uppercase; letter-spacing: 0.05em;
            padding: 4px 8px; border-bottom: 1px solid #e4e4e7;
        }
        .task-table td {
            padding: 5px 8px; font-size: 11px; border-bottom: 1px solid #f4f5f7;
        }
        .type-badge {
            display: inline-block; font-size: 8px; font-weight: 700; padding: 1px 6px;
            border-radius: 4px; text-transform: uppercase; letter-spacing: 0.04em;
        }
        .type-task { background: rgba(34,197,94,0.1); color: #22c55e; }
        .type-bug { background: rgba(239,68,68,0.1); color: #ef4444; }
        .type-feature { background: rgba(139,92,246,0.1); color: #8b5cf6; }
        .task-table tr:last-child td { border-bottom: none; }
        .task-title { font-weight: 600; }
        .task-project { font-size: 10px; color: #10b981; font-weight: 600; }
        .task-assignee { font-size: 10px; color: #71717a; }

        .no-tasks { font-size: 10px; color: #a1a1aa; font-style: italic; padding: 4px 8px; }

        .report-footer {
            margin-top: 32px;
            padding-top: 12px;
            border-top: 1px solid #e4e4e7;
            font-size: 9px;
            color: #a1a1aa;
            text-align: center;
        }

        .btn-print {
            position: fixed; top: 16px; right: 16px;
            background: #10b981; color: #fff; border: none; border-radius: 8px;
            padding: 10px 24px; font-size: 13px; font-weight: 700; cursor: pointer;
            box-shadow: 0 4px 12px rgba(16,185,129,0.3);
            z-index: 1000;
        }
        .btn-print:hover { background: #059669; }

        @@media print {
            .btn-print { display: none; }
            body { padding: 16px 24px; }
        }
    </style>
</head>
<body>
    <button class="btn-print" onclick="window.print()">
        <span style="margin-right:4px">&#128438;</span> Print / Save PDF
    </button>

    <div class="report-header">
        <div>
            <div class="report-title">Task Completion Report</div>
            <div class="report-subtitle">@ViewBag.CompanyName - Last @ViewBag.ReportDays Days</div>
        </div>
        <div class="report-meta">
            <div>Generated: <strong>@((DateTime)ViewBag.GeneratedAt).ToString("MMM dd, yyyy HH:mm") UTC</strong></div>
            <div>Period: <strong>@Model.Last()?.Date.ToString("MMM dd") - @Model.First()?.Date.ToString("MMM dd, yyyy")</strong></div>
        </div>
    </div>

    <div class="summary-bar">
        <div class="summary-item">
            <div class="summary-value">@ViewBag.TotalTasksDone</div>
            <div class="summary-label">Total Tasks Done</div>
        </div>
        <div class="summary-item">
            <div class="summary-value">@ViewBag.ReportDays</div>
            <div class="summary-label">Days Covered</div>
        </div>
        <div class="summary-item">
            @{
                var totalTasks = (int)ViewBag.TotalTasksDone;
                var reportDays = (int)ViewBag.ReportDays;
                var avg = reportDays > 0 ? Math.Round((double)totalTasks / reportDays, 1) : 0;
            }
            <div class="summary-value">@avg</div>
            <div class="summary-label">Avg / Day</div>
        </div>
    </div>

    @foreach (var day in Model)
    {
        var isToday = day.Date == DateTime.UtcNow.Date;
        var dayLabel = isToday ? "Today" : day.Date == DateTime.UtcNow.Date.AddDays(-1) ? "Yesterday" : day.Date.ToString("dddd");
        <div class="day-section">
            <div class="day-header">
                <span class="day-name">@dayLabel</span>
                <span class="day-date">@day.Date.ToString("MMMM dd, yyyy")</span>
                <span class="day-count @(day.TotalCount == 0 ? "empty" : "")">@day.TotalCount task@(day.TotalCount != 1 ? "s" : "")</span>
            </div>
            @if (day.Tasks.Any())
            {
                <table class="task-table">
                    <thead>
                        <tr>
                            <th style="width:4%">#</th>
                            <th style="width:8%">Type</th>
                            <th style="width:40%">Title</th>
                            <th style="width:24%">Project</th>
                            <th style="width:24%">Assignee</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var idx = 0; }
                        @foreach (var task in day.Tasks)
                        {
                            idx++;
                            var badgeClass = task.ItemType == "Bug" ? "type-bug" : task.ItemType == "Feature" ? "type-feature" : "type-task";
                            <tr>
                                <td style="color:#a1a1aa">@idx</td>
                                <td><span class="type-badge @badgeClass">@task.ItemType</span></td>
                                <td>
                                    <span class="task-title">@task.Title</span>
                                    @if (!string.IsNullOrEmpty(task.ItemNumber))
                                    {
                                        <span style="font-size:9px;color:#a1a1aa;margin-left:4px">@task.ItemNumber</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(task.ProjectCrNumber))
                                    {
                                        <span class="task-project">@task.ProjectCrNumber</span>
                                    }
                                    @if (!string.IsNullOrEmpty(task.ProjectTitle))
                                    {
                                        <span style="font-size:10px;color:#52525b"> @task.ProjectTitle</span>
                                    }
                                </td>
                                <td class="task-assignee">@(task.AssigneeName ?? "Unassigned")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="no-tasks">No tasks completed on this day</div>
            }
        </div>
    }

    <div class="report-footer">
        adib - Task Completion Report - Generated automatically
    </div>
</body>
</html>

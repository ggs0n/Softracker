@model WFHMonitor.ViewModels.DeveloperSummaryViewModel
@{ ViewData["Title"] = "Developer Summary"; }

<div class="mod-header mb-4">
    <div class="mod-header-left">
        <h1 class="mod-title"><i class="bi bi-clipboard-data" style="color:#818cf8"></i> Developer Summary</h1>
        <p class="mod-subtitle">Your performance metrics and work overview</p>
    </div>
</div>

@*Stat cards *@
<div class="dp-stat-grid mb-4">
    <div class="dp-stat-card" style="--sc-color:#f87171;--sc-bg:rgba(239,68,68,0.12)">
        <div class="dp-stat-icon"><i class="bi bi-bug-fill"></i></div>
        <div class="dp-stat-value">@Model.AssignedBugCount</div>
        <div class="dp-stat-label">Assigned Bugs</div>
    </div>
    <div class="dp-stat-card" style="--sc-color:#38bdf8;--sc-bg:rgba(14,165,233,0.12)">
        <div class="dp-stat-icon"><i class="bi bi-file-earmark-diff"></i></div>
        <div class="dp-stat-value">@Model.AssignedChangeRequestCount</div>
        <div class="dp-stat-label">Assigned Projects</div>
    </div>
    <div class="dp-stat-card" style="--sc-color:#818cf8;--sc-bg:rgba(99,102,241,0.15)">
        <div class="dp-stat-icon"><i class="bi bi-git"></i></div>
        <div class="dp-stat-value">@Model.LinkedBranchCount</div>
        <div class="dp-stat-label">GitHub Branches</div>
    </div>
    <div class="dp-stat-card" style="--sc-color:#fbbf24;--sc-bg:rgba(234,179,8,0.12)">
        <div class="dp-stat-icon"><i class="bi bi-trophy-fill"></i></div>
        <div class="dp-stat-value">@Model.TotalXpPoints</div>
        <div class="dp-stat-label">Total XP Points</div>
    </div>
    <div class="dp-stat-card" style="--sc-color:#34d399;--sc-bg:rgba(16,185,129,0.12)">
        <div class="dp-stat-icon"><i class="bi bi-git"></i></div>
        <div class="dp-stat-value">@Model.RecentCommitCount</div>
        <div class="dp-stat-label">Recent Commits</div>
    </div>
</div>

@*XP Table *@
<div class="dp mb-4" style="--dp-color:#fbbf24">
    <div class="dp-header">
        <div class="dp-header-icon" style="background:rgba(234,179,8,0.12);color:#fbbf24">
            <i class="bi bi-stars"></i>
        </div>
        <span class="dp-header-title">XP Breakdown</span>
        <span class="dp-header-count">@Model.TotalXpPoints pts total</span>
    </div>
    <div class="table-responsive">
        <table class="dp-table">
            <thead>
                <tr>
                    <th>Action</th>
                    <th class="text-center">Count</th>
                    <th class="text-end">Points</th>
                </tr>
            </thead>
            <tbody>
                <tr><td style="color:#cbd5e1">Bug fixed <span class="dp-cell-muted">(+20)</span></td><td class="text-center dp-cell-muted">@Model.BugFixedCount</td><td class="text-end dp-xp-plus">+@Model.BugFixedPoints</td></tr>
                <tr><td style="color:#cbd5e1">Critical bug fixed <span class="dp-cell-muted">(+40)</span></td><td class="text-center dp-cell-muted">@Model.CriticalBugFixedCount</td><td class="text-end dp-xp-plus">+@Model.CriticalBugFixedPoints</td></tr>
                <tr><td style="color:#cbd5e1">Project delivered on time <span class="dp-cell-muted">(+30)</span></td><td class="text-center dp-cell-muted">@Model.CrDeliveredOnTimeCount</td><td class="text-end dp-xp-plus">+@Model.CrDeliveredOnTimePoints</td></tr>
                <tr><td style="color:#cbd5e1">Task completed before due date <span class="dp-cell-muted">(+15)</span></td><td class="text-center dp-cell-muted">@Model.TaskCompletedBeforeDueDateCount</td><td class="text-end dp-xp-plus">+@Model.TaskCompletedBeforeDueDatePoints</td></tr>
                <tr><td style="color:#cbd5e1">Reopened bug penalty <span class="dp-cell-muted">(-10)</span></td><td class="text-center dp-cell-muted">@Model.ReopenedBugPenaltyCount</td><td class="text-end dp-xp-minus">-@Model.ReopenedBugPenaltyPoints</td></tr>
                <tr><td style="color:#cbd5e1">Failed SLA penalty <span class="dp-cell-muted">(-15)</span></td><td class="text-center dp-cell-muted">@Model.FailedSlaPenaltyCount</td><td class="text-end dp-xp-minus">-@Model.FailedSlaPenaltyPoints</td></tr>
            </tbody>
            <tfoot>
                <tr style="border-top:1px solid rgba(255,255,255,0.1)">
                    <td colspan="2" class="text-end" style="color:#94a3b8;font-weight:700;font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;padding:10px 16px">Total XP</td>
                    <td class="text-end" style="color:#fbbf24;font-weight:800;font-size:1.1rem;padding:10px 16px">@Model.TotalXpPoints</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="row g-3 mb-3">
    @*Assigned Bugs *@
    <div class="col-lg-6">
        <div class="dp h-100" style="--dp-color:#ef4444">
            <div class="dp-header">
                <div class="dp-header-icon" style="background:rgba(239,68,68,0.12);color:#f87171"><i class="bi bi-bug-fill"></i></div>
                <span class="dp-header-title">Assigned Bugs</span>
                <span class="dp-header-count">@Model.AssignedBugs.Count()</span>
            </div>
            @if (!Model.AssignedBugs.Any())
            {
                <div class="dp-empty"><i class="bi bi-bug"></i>No bugs assigned</div>
            }
            else
            {
                @foreach (var bug in Model.AssignedBugs)
                {
                    <div class="dp-list-row">
                        <div class="flex-grow-1 min-width-0">
                            <div class="dp-cell-title" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                <a asp-controller="Bug" asp-action="Details" asp-route-id="@bug.Id" style="color:inherit;text-decoration:none">
                                    @bug.BugNumber — @bug.Title
                                </a>
                            </div>
                            <div class="dp-cell-muted mt-1">Updated @bug.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                        <span class="dp-badge dp-badge-slate ms-2">@bug.Status</span>
                    </div>
                }
            }
        </div>
    </div>

    @*Assigned Projects *@
    <div class="col-lg-6">
        <div class="dp h-100" style="--dp-color:#6366f1">
            <div class="dp-header">
                <div class="dp-header-icon" style="background:rgba(99,102,241,0.15);color:#818cf8"><i class="bi bi-file-earmark-diff"></i></div>
                <span class="dp-header-title">Assigned Projects</span>
                <span class="dp-header-count">@Model.AssignedChangeRequests.Count()</span>
            </div>
            @if (!Model.AssignedChangeRequests.Any())
            {
                <div class="dp-empty"><i class="bi bi-file-earmark-diff"></i>No projects assigned</div>
            }
            else
            {
                @foreach (var cr in Model.AssignedChangeRequests)
                {
                    <div class="dp-list-row">
                        <div class="flex-grow-1 min-width-0">
                            <div class="dp-cell-title" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                <a asp-controller="ChangeRequest" asp-action="Details" asp-route-id="@cr.Id" style="color:inherit;text-decoration:none">
                                    @cr.CrNumber — @cr.Title
                                </a>
                            </div>
                            <div class="dp-cell-muted mt-1">Updated @cr.UpdatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                        </div>
                        <span class="dp-badge dp-badge-slate ms-2">@cr.Status</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="row g-3">
    @*GitHub Branches *@
    <div class="col-lg-6">
        <div class="dp h-100" style="--dp-color:#818cf8">
            <div class="dp-header">
                <div class="dp-header-icon" style="background:rgba(99,102,241,0.15);color:#818cf8"><i class="bi bi-diagram-3"></i></div>
                <span class="dp-header-title">GitHub Branches</span>
                <span class="dp-header-count" style="font-size:0.6rem">@Model.DeveloperEmail</span>
            </div>
            @if (!Model.Branches.Any())
            {
                <div class="dp-empty"><i class="bi bi-github"></i>No linked branches</div>
            }
            else
            {
                @foreach (var branch in Model.Branches)
                {
                    <div class="dp-list-row">
                        <div class="flex-grow-1 min-width-0">
                            <div style="color:#e2e8f0;font-weight:600;font-size:0.82rem">@branch.CrNumber</div>
                            <div class="dp-cell-muted">@branch.Repo</div>
                        </div>
                        <span class="dp-badge dp-badge-indigo" style="font-family:monospace">@branch.Branch</span>
                    </div>
                }
            }
        </div>
    </div>

    @*Recent Commits *@
    <div class="col-lg-6">
        <div class="dp h-100" style="--dp-color:#34d399">
            <div class="dp-header">
                <div class="dp-header-icon" style="background:rgba(16,185,129,0.12);color:#34d399"><i class="bi bi-clock-history"></i></div>
                <span class="dp-header-title">Recent Commits</span>
                <span class="dp-header-count" style="font-size:0.6rem">@Model.DeveloperEmail</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.GitHubError))
            {
                <div style="padding:16px">
                    <div style="background:rgba(234,179,8,0.1);border:1px solid rgba(234,179,8,0.2);border-radius:8px;padding:10px 14px;color:#fbbf24;font-size:0.78rem">
                        <i class="bi bi-exclamation-triangle me-2"></i>@Model.GitHubError
                    </div>
                </div>
            }
            else if (!Model.RecentCommits.Any())
            {
                <div class="dp-empty"><i class="bi bi-git"></i>No recent commits found</div>
            }
            else
            {
                @foreach (var commit in Model.RecentCommits)
                {
                    <div class="dp-list-row align-items-start">
                        <div class="flex-grow-1 min-width-0">
                            <div class="dp-cell-title" style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                <a href="@commit.Url" target="_blank" style="color:inherit;text-decoration:none">@commit.Message</a>
                            </div>
                            <div class="dp-cell-muted mt-1">@commit.CrNumber · @commit.Repo · @commit.Branch</div>
                        </div>
                        <div class="text-end ms-2 flex-shrink-0">
                            <span class="dp-badge dp-badge-indigo" style="font-family:monospace">@commit.Sha</span>
                            <div class="dp-cell-muted mt-1" style="font-size:0.63rem">@commit.Date.ToString("MMM dd HH:mm")</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

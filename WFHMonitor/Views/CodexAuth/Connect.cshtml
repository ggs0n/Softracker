@using System.Text.Json
@{
    Layout = null;
    var returnUrl = (string?)ViewBag.ReturnUrl ?? "/";
    var loginAttempted = (bool?)ViewBag.LoginAttempted ?? false;
    var loginStarted = (bool?)ViewBag.LoginStarted ?? false;
    var message = (string?)ViewBag.Message ?? "Preparing the Codex sign-in flow...";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Connect Codex</title>
    <style>
        :root { color-scheme: light; font-family: Inter, "Segoe UI", sans-serif; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #f3f5f8; color: #172033; }
        main { width: min(460px, calc(100% - 32px)); padding: 32px; border: 1px solid #dce2ea; border-radius: 18px; background: white; box-shadow: 0 18px 45px rgba(30, 48, 80, .12); }
        .icon { width: 52px; height: 52px; display: grid; place-items: center; margin-bottom: 18px; border-radius: 14px; background: #111827; color: white; font-size: 25px; }
        h1 { margin: 0 0 10px; font-size: 25px; }
        p { margin: 0 0 22px; color: #58657a; line-height: 1.55; }
        .status { padding: 13px 15px; margin-bottom: 20px; border-radius: 10px; background: #eef3ff; color: #29467e; }
        .status.error { background: #fff0f0; color: #9b2525; }
        .status.success { background: #eaf8ef; color: #176b39; }
        .actions { display: flex; gap: 10px; flex-wrap: wrap; }
        button, a { appearance: none; padding: 10px 16px; border: 0; border-radius: 9px; background: #111827; color: white; cursor: pointer; font: inherit; text-decoration: none; }
        a.secondary { background: #e9edf3; color: #263247; }
        .spinner { width: 16px; height: 16px; display: inline-block; margin-right: 8px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; vertical-align: -3px; animation: spin .8s linear infinite; }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <main>
        <div class="icon">&lt;/&gt;</div>
        <h1>Connect Codex</h1>
        <p>Complete the ChatGPT authorization window opened by Codex. This page will detect the connection automatically.</p>

        <div id="status" class="status @(loginAttempted && !loginStarted ? "error" : string.Empty)">
            @if (!loginAttempted || loginStarted)
            {
                <span class="spinner" aria-hidden="true"></span>
            }
            <span id="statusText">@message</span>
        </div>

        @if (!loginAttempted)
        {
            <form id="connectForm" asp-controller="CodexAuth" asp-action="Connect" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <noscript><button type="submit">Start Codex sign-in</button></noscript>
            </form>
        }
        else if (!loginStarted)
        {
            <div class="actions">
                <a asp-controller="CodexAuth" asp-action="Connect" asp-route-returnUrl="@returnUrl">Try again</a>
                <a class="secondary" href="@returnUrl">Return to Softracker</a>
            </div>
        }
        else
        {
            <div class="actions">
                <a class="secondary" href="@returnUrl">Return to Softracker</a>
            </div>
        }
    </main>

    <script>
        (() => {
            const loginAttempted = @Json.Serialize(loginAttempted);
            const loginStarted = @Json.Serialize(loginStarted);
            const returnUrl = @Html.Raw(JsonSerializer.Serialize(returnUrl));
            const statusUrl = @Html.Raw(JsonSerializer.Serialize(Url.Action("Status", "CodexAuth") ?? "/CodexAuth/Status"));

            if (!loginAttempted) {
                document.getElementById("connectForm")?.requestSubmit();
                return;
            }

            if (!loginStarted) return;

            const statusBox = document.getElementById("status");
            const statusText = document.getElementById("statusText");
            let attempts = 0;

            const poll = async () => {
                attempts++;
                try {
                    const response = await fetch(statusUrl, { credentials: "same-origin", cache: "no-store" });
                    if (response.ok) {
                        const result = await response.json();
                        if (result.authenticated) {
                            statusBox.className = "status success";
                            statusBox.querySelector(".spinner")?.remove();
                            statusText.textContent = "Codex connected successfully. Returning to Softracker...";
                            try { window.opener?.location.reload(); } catch { }
                            setTimeout(() => {
                                window.close();
                                if (!window.closed) window.location.assign(returnUrl);
                            }, 1200);
                            return;
                        }
                        statusText.textContent = result.message || "Waiting for Codex authorization...";
                    }
                } catch {
                    statusText.textContent = "Waiting for the local application...";
                }

                if (attempts < 200) setTimeout(poll, 1500);
                else statusText.textContent = "Authorization timed out. Return to Softracker and try again.";
            };

            setTimeout(poll, 1200);
        })();
    </script>
</body>
</html>

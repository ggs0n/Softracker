@model WFHMonitor.Models.BugReport
@{
    ViewData["Title"] = Model.Title;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="text-muted small">@Model.BugNumber</div>
        <h2 class="mb-1">@Model.Title</h2>
        <div class="d-flex gap-2">
            <span class="badge bg-secondary">@Model.Status</span>
            <span class="text-muted small">Created @Model.CreatedAt.ToString("MMM dd, yyyy") by @Model.CreatedBy?.FullName</span>
        </div>
        @{
            var bugStages = new List<(WFHMonitor.Models.BugStatus Status, string Label)>
            {
                (WFHMonitor.Models.BugStatus.New, "New"),
                (WFHMonitor.Models.BugStatus.Testing, "Testing"),
                (WFHMonitor.Models.BugStatus.Complete, "Complete")
            };
            var bugStageIndex = bugStages.FindIndex(s => s.Status == Model.Status);
        }
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mt-2 text-center">
            @for (var i = 0; i < bugStages.Count; i++)
            {
                var isComplete = i < bugStageIndex;
                var isCurrent = i == bugStageIndex;
                var badgeClass = isCurrent ? "bg-primary" : isComplete ? "bg-success" : "bg-light text-muted border";
                <span class="badge @badgeClass fs-6 px-3 py-2">@bugStages[i].Label</span>
                if (i < bugStages.Count - 1)
                {
                    <i class="bi bi-chevron-right text-muted"></i>
                }
            }
        </div>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Delete this bug?')">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            </form>
        </div>
    }
    else if (User.IsInRole("Developer") &&
             Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Developer &&
             Model.AssignedDeveloperId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
    {
        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <select name="status" class="form-select form-select-sm" style="max-width:160px;">
                <option value="New" selected="@(Model.Status == WFHMonitor.Models.BugStatus.New ? "selected" : null)">New</option>
                <option value="Testing" selected="@(Model.Status == WFHMonitor.Models.BugStatus.Testing ? "selected" : null)">Testing</option>
            </select>
            <button type="submit" class="btn btn-sm btn-primary">Update</button>
        </form>
    }
</div>

<div class="row g-4">
    <div class="col-lg-8">
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="bi bi-card-text me-2"></i>Description
                </div>
                <div class="card-body" style="white-space:pre-wrap;">@Model.Description</div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-diagram-3 me-2"></i>Workflow
            </div>
            <div class="card-body" style="white-space:pre-wrap;">
                @(string.IsNullOrEmpty(Model.Workflow) ? "Not provided." : Model.Workflow)
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-list-check me-2"></i>Steps To Reproduce
            </div>
            <div class="card-body" style="white-space:pre-wrap;">
                @(string.IsNullOrEmpty(Model.StepsToReproduce) ? "Not provided." : Model.StepsToReproduce)
            </div>
        </div>

        @* Screenshots *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-images me-2"></i>Screenshots</span>
                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                {
                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#bugScreenshotUpload">
                        <i class="bi bi-upload me-1"></i>Upload Screenshot
                    </button>
                }
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
            {
                <div class="collapse" id="bugScreenshotUpload">
                    <div class="card-body border-bottom">
                        <form asp-action="UploadScreenshot" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-9">
                                    <label class="form-label fw-semibold small">Screenshot File <span class="text-danger">*</span></label>
                                    <input type="file" name="file" accept="image/*" class="form-control form-control-sm" required />
                                    <div class="text-muted" style="font-size:0.72rem;">JPG, PNG, GIF, WEBP - max 10 MB</div>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-upload me-1"></i>Upload
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card-body @(!Model.Screenshots.Any() ? "" : "p-0")">
                @if (!Model.Screenshots.Any())
                {
                    <p class="text-muted fst-italic mb-0">No screenshots uploaded yet.</p>
                }
                else
                {
                    <div class="row g-0">
                        @foreach (var img in Model.Screenshots)
                        {
                            <div class="col-md-6 col-lg-4 p-2">
                                <div class="card h-100 border">
                                    <a href="/uploads/bugs/screenshots/@img.FileName" target="_blank">
                                        <img src="/uploads/bugs/screenshots/@img.FileName"
                                             class="card-img-top img-fluid"
                                             style="height:auto; object-fit:contain; cursor:zoom-in; background:#f8f9fa;"
                                             alt="@img.OriginalFileName" />
                                    </a>
                                    <div class="card-body py-2 px-3">
                                        <p class="card-text small mb-0">@img.OriginalFileName</p>
                                    </div>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                                    {
                                        <div class="card-footer p-1 text-end bg-transparent border-top">
                                            <form asp-action="DeleteScreenshot" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this screenshot?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="screenshotId" value="@img.Id" />
                                                <input type="hidden" name="bugId" value="@Model.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Documents *@
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="bi bi-paperclip me-2"></i>Supporting Documents</span>
                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                {
                    <button class="btn btn-sm btn-outline-primary" type="button"
                            data-bs-toggle="collapse" data-bs-target="#bugDocUpload">
                        <i class="bi bi-upload me-1"></i>Upload Document
                    </button>
                }
            </div>

            @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
            {
                <div class="collapse" id="bugDocUpload">
                    <div class="card-body border-bottom">
                        <form asp-action="UploadDocument" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                            <div class="row g-2 align-items-end">
                                <div class="col-md-9">
                                    <label class="form-label fw-semibold small">Document File <span class="text-danger">*</span></label>
                                    <input type="file" name="file" class="form-control form-control-sm" required />
                                    <div class="text-muted" style="font-size:0.72rem;">PDF, Word, Excel, PowerPoint, TXT - max 20 MB</div>
                                </div>
                                <div class="col-md-3">
                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-upload me-1"></i>Upload
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <div class="card-body p-0">
                @if (!Model.Documents.Any())
                {
                    <p class="text-muted fst-italic p-3 mb-0">No documents uploaded yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var doc in Model.Documents)
                        {
                            <li class="list-group-item d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-file-earmark-text text-muted"></i>
                                    <a href="/uploads/bugs/docs/@doc.FileName" target="_blank">@doc.OriginalFileName</a>
                                    <span class="text-muted small">@doc.UploadedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                                {
                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this document?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <input type="hidden" name="bugId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-4">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-person-badge me-2"></i>Assignment
            </div>
            <div class="card-body">
                <div class="small text-muted">Assignment Target</div>
                <div class="fw-semibold">@Model.AssigneeType</div>
                @if (Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent)
                {
                    <div class="small text-muted mt-3">Agent Status</div>
                    <div class="fw-semibold">@Model.AgentStatus</div>
                }
                <div class="small text-muted">Assigned Developer</div>
                <div class="fw-semibold">@(Model.AssignedDeveloper?.FullName ?? "Unassigned")</div>
                <div class="small text-muted mt-3">Project</div>
                <div class="fw-semibold">
                    @if (Model.ChangeRequest != null)
                    {
                        <a asp-controller="ChangeRequest" asp-action="Details" asp-route-id="@Model.ChangeRequest.Id">
                            @Model.ChangeRequest.CrNumber - @Model.ChangeRequest.Title
                        </a>
                    }
                    else
                    {
                        <span>@(string.IsNullOrEmpty(Model.ChangeRequestReferenceText) ? "Not specified" : Model.ChangeRequestReferenceText)</span>
                    }
                </div>
                <div class="small text-muted mt-3">Module Impacted</div>
                <div class="fw-semibold">@(string.IsNullOrEmpty(Model.ModuleImpacted) ? "Not specified" : Model.ModuleImpacted)</div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light fw-semibold">
                <i class="bi bi-activity me-2"></i>Tracker
            </div>
            <div class="card-body p-0">
                @if (Model.Activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in Model.Activities.OrderByDescending(x => x.CreatedAt))
                        {
                            <li class="list-group-item">
                                <div class="small text-muted">@a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                <div class="fw-semibold">@a.Action</div>
                                @if (a.OldStatus.HasValue || a.NewStatus.HasValue)
                                {
                                    <div class="small">Status: @(a.OldStatus?.ToString() ?? "-") → @(a.NewStatus?.ToString() ?? "-")</div>
                                }
                                @if (a.OldAssignedDeveloperId != a.NewAssignedDeveloperId)
                                {
                                    <div class="small">Assigned: @(a.OldAssignedDeveloper?.FullName ?? "Unassigned") → @(a.NewAssignedDeveloper?.FullName ?? "Unassigned")</div>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted fst-italic p-3 mb-0">No activity yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-2"></i>Back to List
    </a>
</div>

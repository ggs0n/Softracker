@model WFHMonitor.Models.BugReport
@{
    ViewData["Title"] = Model.Title;
    var openClawFixAgentOptions = ViewBag.OpenClawFixAgentOptions as IList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var appAgentOptions = ViewBag.AgentUserOptions as IList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var hasProAccess = ViewBag.HasProAccess as bool? ?? false;
    var isOpenClawEnabled = ViewBag.IsOpenClawEnabled as bool? ?? true;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var canEditPrLink = (User.IsInRole("Admin") || User.IsInRole("Tester")) ||
        (!string.IsNullOrWhiteSpace(currentUserId) &&
         string.Equals(Model.AssignedDeveloperId, currentUserId, StringComparison.Ordinal) &&
         (User.IsInRole("Developer") || User.IsInRole("Agent")));
    var isAgentQueued = Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent &&
        Model.AgentStatus == WFHMonitor.Models.BugAgentStatus.Queued;
    var isAgentProcessing = Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent &&
        Model.AgentStatus == WFHMonitor.Models.BugAgentStatus.InProgress;

    var bugStages = new List<(WFHMonitor.Models.BugStatus Status, string Label)>
    {
        (WFHMonitor.Models.BugStatus.New, "New"),
        (WFHMonitor.Models.BugStatus.Testing, "Testing"),
        (WFHMonitor.Models.BugStatus.Complete, "Complete")
    };
    var bugStageIndex = bugStages.FindIndex(s => s.Status == Model.Status);

    var statusClsMap = new Dictionary<string, string> {
        {"New","bd-st-new"}, {"Testing","bd-st-testing"}, {"Complete","bd-st-complete"}
    };
    var stKey = Model.Status.ToString();
}

<style>
    .bd-shell{max-width:1420px;margin:0 auto}

    /* Hero */
    .bd-hero{position:relative;background:var(--bg-dark);border:1px solid rgba(239,68,68,.18);border-radius:16px;padding:28px 32px 24px;margin-bottom:24px;overflow:hidden}
    .bd-hero::before{content:'';position:absolute;top:-60px;right:-40px;width:220px;height:220px;background:radial-gradient(circle,rgba(239,68,68,.1) 0%,transparent 70%);pointer-events:none}
    .bd-hero-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;flex-wrap:wrap;position:relative;z-index:1}
    .bd-hero-badge{display:inline-flex;align-items:center;gap:5px;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);color:#f87171;font-size:.66rem;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
    .bd-hero-title{font-size:1.65rem;font-weight:800;color:#f4f5f7;letter-spacing:-.02em;line-height:1.15}
    .bd-hero-meta{display:flex;align-items:center;gap:8px;margin-top:6px;flex-wrap:wrap}
    .bd-pill{font-size:.7rem;font-weight:700;border-radius:999px;padding:3px 10px;border:1px solid transparent;display:inline-block}
    .bd-st-new{background:rgba(239,68,68,.15);color:#fca5a5;border-color:rgba(239,68,68,.3)}
    .bd-st-testing{background:rgba(59,130,246,.15);color:#93c5fd;border-color:rgba(59,130,246,.3)}
    .bd-st-complete{background:rgba(16,185,129,.15);color:#6ee7b7;border-color:rgba(16,185,129,.3)}
    .bd-hero-date{font-size:.74rem;color:#71717a}
    .bd-hero-actions{display:flex;gap:8px;align-items:center;flex-shrink:0}
    .bd-btn-edit{background:rgba(251,191,36,.15);color:#fbbf24;border:1px solid rgba(251,191,36,.3);border-radius:10px;padding:8px 18px;font-size:.8rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:6px;transition:all .2s ease;text-decoration:none}
    .bd-btn-edit:hover{background:rgba(251,191,36,.25);color:#fbbf24;transform:translateY(-1px)}
    .bd-btn-del{background:rgba(239,68,68,.1);color:#f87171;border:1px solid rgba(239,68,68,.25);border-radius:10px;padding:8px 16px;font-size:.8rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .2s ease}
    .bd-btn-del:hover{background:rgba(239,68,68,.2);color:#f87171;transform:translateY(-1px)}
    .bd-btn-pr{background:rgba(251,191,36,.12);color:#fbbf24;border:1px solid rgba(251,191,36,.25);border-radius:10px;padding:6px 14px;font-size:.76rem;font-weight:700;display:inline-flex;align-items:center;gap:5px;text-decoration:none;transition:all .15s ease}
    .bd-btn-pr:hover{background:rgba(251,191,36,.2);color:#fbbf24}

    /* Stage flow */
    .bd-stage-flow{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px;align-items:center;position:relative;z-index:1}
    .bd-stage{font-size:.72rem;font-weight:700;border-radius:999px;padding:5px 13px;border:1px solid rgba(255,255,255,.1);background:rgba(255,255,255,.06);color:#71717a;transition:all .2s ease;cursor:default}
    .bd-stage-done{background:rgba(16,185,129,.15);border-color:rgba(16,185,129,.3);color:#34d399}
    .bd-stage-now{background:rgba(59,130,246,.15);border-color:rgba(59,130,246,.3);color:#60a5fa}
    .bd-stage-arrow{color:#52525b;font-size:.68rem}
    .bd-stage-btn{border:0;background:transparent;padding:0;line-height:1;cursor:pointer}
    .bd-stage-btn:hover .bd-stage{opacity:.8}

    /* Grid */
    .bd-grid{display:grid;grid-template-columns:1fr 340px;gap:20px}

    /* Section cards */
    .bd-section{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;margin-bottom:20px;overflow:hidden;transition:box-shadow .2s ease}
    .bd-section:hover{box-shadow:0 8px 28px rgba(0,0,0,.06)}
    .bd-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 20px;border-bottom:1px solid var(--border);background:linear-gradient(180deg,#fafbfc,#f6f7f9)}
    .bd-section-left{display:flex;align-items:center;gap:10px}
    .bd-section-icon{width:32px;height:32px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0}
    .bd-section-label{font-size:.82rem;font-weight:700;color:var(--text-primary);letter-spacing:.01em}
    .bd-section-body{padding:18px 20px}
    .bd-section-body-flush{padding:0}

    .bd-desc{color:#52525b;font-size:.86rem;line-height:1.6;white-space:pre-wrap}
    .bd-empty{font-size:.8rem;color:#a1a1aa;font-style:italic}

    /* Screenshots */
    .bd-ss-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:12px}
    .bd-ss-card{border:1px solid var(--border);border-radius:10px;overflow:hidden;background:#fafbfc;transition:box-shadow .2s ease}
    .bd-ss-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.06)}
    .bd-ss-card img{width:100%;height:160px;object-fit:contain;background:#f4f5f6;cursor:zoom-in;display:block}
    .bd-ss-footer{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-top:1px solid var(--border)}
    .bd-ss-name{font-size:.74rem;color:#71717a;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

    /* Upload area */
    .bd-upload-area{border:1px dashed #d1d5db;border-radius:10px;padding:14px 16px;background:#fafbfc}
    .bd-upload-btn{background:#ef4444;color:#fff;border:none;border-radius:8px;padding:7px 16px;font-size:.78rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .2s ease}
    .bd-upload-btn:hover{background:#dc2626}
    .bd-btn-outline{border:1px solid #d1d5db;border-radius:8px;padding:6px 14px;font-size:.76rem;font-weight:600;color:#52525b;background:#fff;display:inline-flex;align-items:center;gap:5px;text-decoration:none;transition:all .15s ease;cursor:pointer}
    .bd-btn-outline:hover{border-color:#a1a1aa;color:#111827;background:#f8fafc}

    /* Doc list */
    .bd-doc-item{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--border)}
    .bd-doc-item:last-child{border-bottom:none}
    .bd-doc-link{font-size:.82rem;font-weight:600;text-decoration:none;color:var(--text-primary);transition:color .15s ease}
    .bd-doc-link:hover{color:#ef4444}
    .bd-doc-date{font-size:.7rem;color:#a1a1aa}

    /* Right blocks */
    .bd-sblock{border:1px solid var(--border);border-radius:10px;padding:12px 14px;background:#fafbfc;margin-bottom:10px}
    .bd-sblock:last-child{margin-bottom:0}
    .bd-stitle{font-size:.66rem;text-transform:uppercase;letter-spacing:.07em;color:#a1a1aa;font-weight:700;margin-bottom:4px}
    .bd-svalue{font-size:.82rem;font-weight:600;color:var(--text-primary)}
    .bd-slink{font-size:.78rem;text-decoration:none;color:#ef4444;transition:color .15s ease;display:flex;align-items:center;gap:5px}
    .bd-slink:hover{color:#dc2626}

    /* Agent dot */
    .bd-agent-dot{width:10px;height:10px;border-radius:999px;display:inline-block;flex-shrink:0;background:#71717a}
    .bd-agent-dot.is-pulsing{background:#3b82f6;animation:bdPulse 1.25s infinite}
    .bd-agent-dot.is-queued{background:#f59e0b}
    @@keyframes bdPulse{0%{box-shadow:0 0 0 0 rgba(59,130,246,.7)}70%{box-shadow:0 0 0 10px rgba(59,130,246,0)}100%{box-shadow:0 0 0 0 rgba(59,130,246,0)}}

    .bd-act{width:28px;height:28px;border-radius:6px;border:1px solid #d1d5db;color:#71717a;background:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem;cursor:pointer;transition:all .15s ease}
    .bd-act:hover{border-color:#fecaca;color:#dc2626;background:#fef2f2}

    .bd-scan-select{background:#fff;border:1px solid #d1d5db;border-radius:8px;padding:7px 10px;font-size:.78rem;color:var(--text-primary);font-family:inherit;width:100%}
    .bd-scan-select:focus{outline:none;border-color:#ef4444;box-shadow:0 0 0 3px rgba(239,68,68,.12)}
    .bd-scan-btn{background:var(--bg-dark);color:#e4e4e7;border:1px solid rgba(255,255,255,.1);border-radius:8px;padding:8px 16px;font-size:.78rem;font-weight:700;cursor:pointer;display:inline-flex;align-items:center;gap:5px;transition:all .15s ease;width:100%;justify-content:center}
    .bd-scan-btn:hover{background:#27272a;color:#f4f5f7}

    /* Activity */
    .bd-activity{padding:10px 14px;border-bottom:1px solid var(--border)}
    .bd-activity:last-child{border-bottom:none}
    .bd-activity-date{font-size:.7rem;color:#a1a1aa}
    .bd-activity-action{font-size:.82rem;font-weight:600;color:var(--text-primary)}
    .bd-activity-detail{font-size:.76rem;color:#71717a}

    /* Dev status update */
    .bd-dev-status{display:flex;align-items:center;gap:6px}
    .bd-dev-select{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:8px;padding:4px 8px;font-size:.74rem;color:#e4e4e7;font-family:inherit}
    .bd-dev-select option{background:#18181b;color:#e4e4e7}
    .bd-dev-btn{background:rgba(59,130,246,.15);color:#60a5fa;border:1px solid rgba(59,130,246,.3);border-radius:8px;padding:4px 12px;font-size:.74rem;font-weight:700;cursor:pointer;transition:all .15s ease}
    .bd-dev-btn:hover{background:rgba(59,130,246,.25)}

    /* Back */
    .bd-backlink{background:transparent;color:#a1a1aa;border:1px solid var(--border);border-radius:10px;padding:9px 20px;font-size:.82rem;font-weight:600;cursor:pointer;transition:all .2s ease;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
    .bd-backlink:hover{border-color:var(--text-secondary);color:var(--text-primary)}

    @@media(max-width:991px){.bd-grid{grid-template-columns:1fr}.bd-hero-title{font-size:1.35rem}.bd-hero{padding:22px 18px 20px}}
</style>

<div class="bd-shell">

    @* Hero *@
    <section class="bd-hero">
        <div class="bd-hero-top">
            <div>
                <div class="bd-hero-badge"><i class="bi bi-bug-fill"></i> @Model.BugNumber</div>
                <div class="bd-hero-title">@Model.Title</div>
                <div class="bd-hero-meta">
                    <span class="bd-pill @(statusClsMap.ContainsKey(stKey) ? statusClsMap[stKey] : "")">@Model.Status</span>
                    <span class="bd-hero-date">Created @Model.CreatedAt.ToString("MMM dd, yyyy") by @Model.CreatedBy?.FullName</span>
                </div>
            </div>
            <div class="bd-hero-actions">
                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="bd-btn-edit"><i class="bi bi-pencil"></i> Edit</a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Delete this bug?')">
                        @Html.AntiForgeryToken()
                        <button class="bd-btn-del"><i class="bi bi-trash"></i> Delete</button>
                    </form>
                }
                else if (canEditPrLink)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="bd-btn-pr"><i class="bi bi-link-45deg"></i> Edit PR Link</a>
                    @if (User.IsInRole("Developer") &&
                         Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Developer &&
                         string.Equals(Model.AssignedDeveloperId, currentUserId, StringComparison.Ordinal))
                    {
                        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="bd-dev-status">
                            @Html.AntiForgeryToken()
                            <select name="status" class="bd-dev-select">
                                <option value="New" selected="@(Model.Status == WFHMonitor.Models.BugStatus.New ? "selected" : null)">New</option>
                                <option value="Testing" selected="@(Model.Status == WFHMonitor.Models.BugStatus.Testing ? "selected" : null)">Testing</option>
                            </select>
                            <button type="submit" class="bd-dev-btn">Update</button>
                        </form>
                    }
                }
            </div>
        </div>
        <div class="bd-stage-flow">
            @for (var i = 0; i < bugStages.Count; i++)
            {
                var isComplete = i < bugStageIndex;
                var isCurrent = i == bugStageIndex;
                var cls = isCurrent ? "bd-stage-now" : isComplete ? "bd-stage-done" : "";
                if (User.IsInRole("Admin"))
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" style="margin:0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="status" value="@bugStages[i].Status" />
                        <button type="submit" class="bd-stage-btn" title="Set status to @bugStages[i].Label">
                            <span class="bd-stage @cls">@bugStages[i].Label</span>
                        </button>
                    </form>
                }
                else
                {
                    <span class="bd-stage @cls">@bugStages[i].Label</span>
                }
                if (i < bugStages.Count - 1)
                {
                    <i class="bi bi-chevron-right bd-stage-arrow"></i>
                }
            }
        </div>
    </section>

    @* Grid *@
    <div class="bd-grid">

        @* Left Column *@
        <div>

            @* Description *@
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="bd-section">
                    <div class="bd-section-head">
                        <div class="bd-section-left">
                            <div class="bd-section-icon" style="background:#eef2ff;color:#6366f1"><i class="bi bi-card-text"></i></div>
                            <div class="bd-section-label">Description</div>
                        </div>
                    </div>
                    <div class="bd-section-body">
                        <div class="bd-desc">@Model.Description</div>
                    </div>
                </div>
            }

            @* Workflow *@
            <div class="bd-section">
                <div class="bd-section-head">
                    <div class="bd-section-left">
                        <div class="bd-section-icon" style="background:#e0f2fe;color:#0284c7"><i class="bi bi-diagram-3"></i></div>
                        <div class="bd-section-label">Workflow</div>
                    </div>
                </div>
                <div class="bd-section-body">
                    <div class="bd-desc">@(string.IsNullOrEmpty(Model.Workflow) ? "Not provided." : Model.Workflow)</div>
                </div>
            </div>

            @* Steps to Reproduce *@
            <div class="bd-section">
                <div class="bd-section-head">
                    <div class="bd-section-left">
                        <div class="bd-section-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-list-check"></i></div>
                        <div class="bd-section-label">Steps To Reproduce</div>
                    </div>
                </div>
                <div class="bd-section-body">
                    <div class="bd-desc">@(string.IsNullOrEmpty(Model.StepsToReproduce) ? "Not provided." : Model.StepsToReproduce)</div>
                </div>
            </div>

            @* Screenshots *@
            <div class="bd-section">
                <div class="bd-section-head">
                    <div class="bd-section-left">
                        <div class="bd-section-icon" style="background:#fce7f3;color:#db2777"><i class="bi bi-images"></i></div>
                        <div class="bd-section-label">Screenshots</div>
                    </div>
                    @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                    {
                        <button class="bd-btn-outline" type="button" data-bs-toggle="collapse" data-bs-target="#bugScreenshotUpload">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                    }
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                {
                    <div class="collapse" id="bugScreenshotUpload">
                        <div class="bd-section-body" style="border-bottom:1px solid var(--border)">
                            <form asp-action="UploadScreenshot" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                                <div class="bd-upload-area">
                                    <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
                                        <div style="flex:1;min-width:200px">
                                            <label style="font-size:.74rem;font-weight:600;color:#52525b;margin-bottom:4px;display:block">Screenshot File <span style="color:#ef4444">*</span></label>
                                            <input type="file" name="file" accept="image/*" class="form-control form-control-sm" style="border:1px solid #d1d5db;border-radius:8px;font-size:.8rem" required />
                                            <div style="font-size:.68rem;color:#a1a1aa;margin-top:3px">JPG, PNG, GIF, WEBP — max 10 MB</div>
                                        </div>
                                        <button type="submit" class="bd-upload-btn"><i class="bi bi-upload"></i> Upload</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                <div class="bd-section-body">
                    @if (!Model.Screenshots.Any())
                    {
                        <span class="bd-empty">No screenshots uploaded yet.</span>
                    }
                    else
                    {
                        <div class="bd-ss-grid">
                            @foreach (var img in Model.Screenshots)
                            {
                                <div class="bd-ss-card">
                                    <a href="/uploads/bugs/screenshots/@img.FileName" target="_blank">
                                        <img src="/uploads/bugs/screenshots/@img.FileName" alt="@img.OriginalFileName" />
                                    </a>
                                    <div class="bd-ss-footer">
                                        <span class="bd-ss-name" title="@img.OriginalFileName">@img.OriginalFileName</span>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                                        {
                                            <form asp-action="DeleteScreenshot" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this screenshot?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="screenshotId" value="@img.Id" />
                                                <input type="hidden" name="bugId" value="@Model.Id" />
                                                <button type="submit" class="bd-act"><i class="bi bi-trash"></i></button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Documents *@
            <div class="bd-section">
                <div class="bd-section-head">
                    <div class="bd-section-left">
                        <div class="bd-section-icon" style="background:#fef3c7;color:#d97706"><i class="bi bi-paperclip"></i></div>
                        <div class="bd-section-label">Supporting Documents</div>
                    </div>
                    @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                    {
                        <button class="bd-btn-outline" type="button" data-bs-toggle="collapse" data-bs-target="#bugDocUpload">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                    }
                </div>
                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                {
                    <div class="collapse" id="bugDocUpload">
                        <div class="bd-section-body" style="border-bottom:1px solid var(--border)">
                            <form asp-action="UploadDocument" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@Url.Action("Details", new { id = Model.Id })" />
                                <div class="bd-upload-area">
                                    <div style="display:flex;gap:10px;align-items:end;flex-wrap:wrap">
                                        <div style="flex:1;min-width:200px">
                                            <label style="font-size:.74rem;font-weight:600;color:#52525b;margin-bottom:4px;display:block">Document File <span style="color:#ef4444">*</span></label>
                                            <input type="file" name="file" class="form-control form-control-sm" style="border:1px solid #d1d5db;border-radius:8px;font-size:.8rem" required />
                                            <div style="font-size:.68rem;color:#a1a1aa;margin-top:3px">PDF, Word, Excel, PowerPoint, TXT — max 20 MB</div>
                                        </div>
                                        <button type="submit" class="bd-upload-btn"><i class="bi bi-upload"></i> Upload</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }
                <div class="bd-section-body-flush">
                    @if (!Model.Documents.Any())
                    {
                        <div style="padding:14px 20px"><span class="bd-empty">No documents uploaded yet.</span></div>
                    }
                    else
                    {
                        @foreach (var doc in Model.Documents)
                        {
                            <div class="bd-doc-item">
                                <div style="display:flex;align-items:center;gap:8px">
                                    <i class="bi bi-file-earmark-text" style="color:#a1a1aa"></i>
                                    <a href="/uploads/bugs/docs/@doc.FileName" target="_blank" class="bd-doc-link">@doc.OriginalFileName</a>
                                    <span class="bd-doc-date">@doc.UploadedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                                @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                                {
                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this document?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="documentId" value="@doc.Id" />
                                        <input type="hidden" name="bugId" value="@Model.Id" />
                                        <button type="submit" class="bd-act"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        @* Right Column *@
        <div>

            @* Assignment *@
            <div class="bd-section">
                <div class="bd-section-head">
                    <div class="bd-section-left">
                        <div class="bd-section-icon" style="background:#dcfce7;color:#16a34a"><i class="bi bi-person-badge"></i></div>
                        <div class="bd-section-label">Assignment</div>
                    </div>
                </div>
                <div class="bd-section-body">
                    <div class="bd-sblock">
                        <div class="bd-stitle">Assignment Target</div>
                        <div class="bd-svalue">@Model.AssigneeType</div>
                    </div>
                    @if (Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent)
                    {
                        <div class="bd-sblock">
                            <div class="bd-stitle">Agent Status</div>
                            <div style="display:flex;align-items:center;gap:8px">
                                <span class="bd-agent-dot @(isAgentProcessing ? "is-pulsing" : (isAgentQueued ? "is-queued" : ""))"></span>
                                <span class="bd-svalue">@Model.AgentStatus</span>
                            </div>
                        </div>
                    }
                    <div class="bd-sblock">
                        <div class="bd-stitle">@(Model.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent ? "Assigned Agent" : "Assigned Developer")</div>
                        <div class="bd-svalue">@(Model.AssignedDeveloper?.FullName ?? "Unassigned")</div>
                    </div>
                    <div class="bd-sblock">
                        <div class="bd-stitle">Project</div>
                        @if (Model.ChangeRequest != null)
                        {
                            <a asp-controller="ChangeRequest" asp-action="Details" asp-route-id="@Model.ChangeRequest.Id" class="bd-slink">
                                <i class="bi bi-folder2-open"></i> @Model.ChangeRequest.CrNumber — @Model.ChangeRequest.Title
                            </a>
                        }
                        else
                        {
                            <div class="bd-svalue">@(string.IsNullOrEmpty(Model.ChangeRequestReferenceText) ? "Not specified" : Model.ChangeRequestReferenceText)</div>
                        }
                    </div>
                    <div class="bd-sblock">
                        <div class="bd-stitle">Module Impacted</div>
                        <div class="bd-svalue">@(string.IsNullOrEmpty(Model.ModuleImpacted) ? "Not specified" : Model.ModuleImpacted)</div>
                    </div>
                    <div class="bd-sblock">
                        <div class="bd-stitle">Pull Request</div>
                        @if (!string.IsNullOrWhiteSpace(Model.PullRequestUrl))
                        {
                            <a href="@Model.PullRequestUrl" target="_blank" rel="noopener noreferrer" class="bd-slink">
                                <i class="bi bi-git"></i> View Pull Request
                            </a>
                        }
                        else
                        {
                            <span class="bd-empty">Not added yet.</span>
                        }
                    </div>
                </div>
            </div>

            @* OpenClaw Fix Agent *@
            @if (isOpenClawEnabled)
            {
                @if (hasProAccess && (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer")))
                {
                    <div class="bd-section">
                        <div class="bd-section-head">
                            <div class="bd-section-left">
                                <div class="bd-section-icon" style="background:#ede9fe;color:#7c3aed"><i class="bi bi-cpu"></i></div>
                                <div class="bd-section-label">OpenClaw Agent</div>
                            </div>
                        </div>
                        <div class="bd-section-body">
                            <form asp-action="FixWithAgent" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div style="margin-bottom:10px">
                                    <div class="bd-stitle">Fix Agent</div>
                                    <select name="fixAgentId" class="bd-scan-select">
                                        @foreach (var option in openClawFixAgentOptions)
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    </select>
                                </div>
                                <div style="margin-bottom:12px">
                                    <div class="bd-stitle">Assign To App Agent</div>
                                    <select name="assignedAgentId" class="bd-scan-select">
                                        @foreach (var option in appAgentOptions)
                                        {
                                            <option value="@option.Value">@option.Text</option>
                                        }
                                    </select>
                                </div>
                                <button type="submit" class="bd-scan-btn">
                                    @if (isAgentProcessing)
                                    {
                                        <span><i class="bi bi-arrow-repeat"></i> Agent Processing...</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-wrench-adjustable-circle"></i> Fix Bug (OpenClaw)</span>
                                    }
                                </button>
                                <div style="font-size:.7rem;color:#a1a1aa;margin-top:8px">Manual trigger. Click to queue fix with selected agent.</div>
                            </form>
                        </div>
                    </div>
                }
                else if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
                {
                    <div class="bd-section">
                        <div class="bd-section-head">
                            <div class="bd-section-left">
                                <div class="bd-section-icon" style="background:#ede9fe;color:#7c3aed"><i class="bi bi-cpu"></i></div>
                                <div class="bd-section-label">OpenClaw Agent</div>
                            </div>
                        </div>
                        <div class="bd-section-body" style="text-align:center">
                            <a asp-controller="Payment" asp-action="Index" style="background:rgba(217,119,6,.12);color:#d97706;border:1px solid rgba(217,119,6,.3);border-radius:10px;padding:10px 20px;font-size:.8rem;font-weight:700;display:inline-flex;align-items:center;gap:6px;text-decoration:none;transition:all .2s ease">
                                <i class="bi bi-stars"></i> Upgrade to Pro
                            </a>
                        </div>
                    </div>
                }
            }

            @* Tracker *@
            <div class="bd-section">
                <div class="bd-section-head">
                    <div class="bd-section-left">
                        <div class="bd-section-icon" style="background:#f3f4f6;color:#374151"><i class="bi bi-activity"></i></div>
                        <div class="bd-section-label">Tracker</div>
                    </div>
                </div>
                <div class="bd-section-body-flush">
                    @if (Model.Activities.Any())
                    {
                        @foreach (var a in Model.Activities.OrderByDescending(x => x.CreatedAt))
                        {
                            <div class="bd-activity">
                                <div class="bd-activity-date">@a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                                <div class="bd-activity-action">@a.Action</div>
                                @if (a.OldStatus.HasValue || a.NewStatus.HasValue)
                                {
                                    <div class="bd-activity-detail">Status: @(a.OldStatus?.ToString() ?? "-") → @(a.NewStatus?.ToString() ?? "-")</div>
                                }
                                @if (a.OldAssignedDeveloperId != a.NewAssignedDeveloperId)
                                {
                                    <div class="bd-activity-detail">Assigned: @(a.OldAssignedDeveloper?.FullName ?? "Unassigned") → @(a.NewAssignedDeveloper?.FullName ?? "Unassigned")</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div style="padding:14px 20px"><span class="bd-empty">No activity yet.</span></div>
                    }
                </div>
            </div>

        </div>
    </div>

    @* Back *@
    <div style="margin-top:16px">
        <a asp-action="Index" class="bd-backlink"><i class="bi bi-arrow-left"></i> Back to List</a>
    </div>
</div>

@model List<WFHMonitor.Models.BugReport>
@{ ViewData["Title"] = "Bugs"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0"><i class="bi bi-bug me-2"></i>Bug Tracker</h5>
    @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
    {
        <a asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-circle me-1"></i>New Bug
        </a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Bug #</th>
                    <th>Title</th>
                    <th>Project</th>
                    <th>Status</th>
                    <th>Assigned</th>
                    <th>Created</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bug in Model)
                {
                    <tr>
                        <td class="text-muted">@bug.BugNumber</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@bug.Id" class="fw-semibold">@bug.Title</a>
                        </td>
                        <td>
                            @if (bug.ChangeRequest != null)
                            {
                                <span>@bug.ChangeRequest.CrNumber - @bug.ChangeRequest.Title</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(bug.ChangeRequestReferenceText))
                            {
                                <span>@bug.ChangeRequestReferenceText</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary">@bug.Status</span>
                        </td>
                        <td>
                            @if (bug.AssigneeType == WFHMonitor.Models.BugAssigneeType.Agent)
                            {
                                <span>Agent (@bug.AgentStatus)</span>
                            }
                            else
                            {
                                <span>@(bug.AssignedDeveloper?.FullName ?? "Unassigned")</span>
                            }
                        </td>
                        <td class="text-muted">@bug.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@bug.Id" class="btn btn-sm btn-outline-primary me-1" title="View bug" aria-label="View bug">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (User.IsInRole("Admin") || User.IsInRole("Tester"))
                            {
                                <a asp-action="Edit" asp-route-id="@bug.Id" class="btn btn-sm btn-outline-warning me-1" title="Edit bug" aria-label="Edit bug">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@bug.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete @bug.BugNumber?')">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" title="Delete bug" aria-label="Delete bug">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">No bugs yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

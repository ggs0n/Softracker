@* Edit Test Case Modal *@
<div class="modal fade" id="editTestCaseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;border:1px solid var(--border)">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />
                <div class="modal-header" style="border-bottom:1px solid var(--border);padding:16px 20px">
                    <h6 class="modal-title fw-bold" style="font-size:.9rem"><i class="bi bi-pencil-square me-2" style="color:#f59e0b"></i>Edit Test Case</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding:20px">
                    <div class="mb-3">
                        <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Name *</label>
                        <input name="Name" id="editName" class="form-control" required style="font-size:.84rem" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Description</label>
                        <textarea name="Description" id="editDescription" class="form-control" rows="3" style="font-size:.84rem"></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Module</label>
                            <input name="Module" id="editModule" class="form-control" style="font-size:.84rem" />
                        </div>
                        <div class="col-6">
                            <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Category</label>
                            <select name="Category" id="editCategory" class="form-select" style="font-size:.84rem">
                                @foreach (var cat in Enum.GetValues<WFHMonitor.Models.TestCaseCategory>())
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4">
                            <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Status</label>
                            <select name="Status" id="editStatus" class="form-select" style="font-size:.84rem">
                                @foreach (var st in Enum.GetValues<WFHMonitor.Models.TestCaseStatus>())
                                {
                                    <option value="@st">@st</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Environment</label>
                            <select name="Environment" id="editEnvironment" class="form-select" style="font-size:.84rem">
                                @foreach (var env in Enum.GetValues<WFHMonitor.Models.TestCaseEnvironment>())
                                {
                                    <option value="@env">@env</option>
                                }
                            </select>
                        </div>
                        <div class="col-4">
                            <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Project</label>
                            <select name="ChangeRequestId" id="editProjectId" class="form-select" style="font-size:.84rem">
                                <option value="">-- None --</option>
                                @foreach (var p in Model.Projects)
                                {
                                    <option value="@p.Id">@p.CrNumber — @p.Title</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--border);padding:12px 20px">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm" style="background:#f59e0b;color:#18181b;font-weight:600">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, name, desc, module, status, category, env, projectId, bugId) {
            document.getElementById('editId').value = id;
            document.getElementById('editName').value = name;
            document.getElementById('editDescription').value = desc.replace(/\\n/g, '\n');
            document.getElementById('editModule').value = module;
            document.getElementById('editStatus').value = status;
            document.getElementById('editCategory').value = category;
            document.getElementById('editEnvironment').value = env;
            document.getElementById('editProjectId').value = projectId;
            new bootstrap.Modal(document.getElementById('editTestCaseModal')).show();
        }
    </script>
}


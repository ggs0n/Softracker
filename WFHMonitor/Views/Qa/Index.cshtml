                                {
                                    <option value="@p.Id">@p.CrNumber — @p.Title</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--border);padding:12px 20px">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm" style="background:#3b82f6;color:#fff;font-weight:600">Create Test Case</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Generate Modal *@
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:14px;border:1px solid var(--border)">
            <form asp-action="GenerateFlow" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header" style="border-bottom:1px solid var(--border);padding:16px 20px">
                    <h6 class="modal-title fw-bold" style="font-size:.9rem"><i class="bi bi-cpu me-2" style="color:#3b82f6"></i>Generate Flow</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" style="padding:20px">
                    <div class="mb-3">
                        <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Project</label>
                        <select name="projectId" class="form-select" required style="font-size:.84rem">
                            <option value="">Select project...</option>
                            @foreach (var p in Model.Projects)
                            {
                                <option value="@p.Id" selected="@(Model.FilterProjectId == p.Id ? "selected" : null)">@p.CrNumber - @p.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size:.76rem;font-weight:600;color:var(--text-secondary)">Codex Agent</label>
                        <select name="scanAgentId" class="form-select" style="font-size:.84rem">
                            @if (Model.CodexScanAgentOptions.Any())
                            {
                                @foreach (var option in Model.CodexScanAgentOptions)
                                {
                                    <option value="@option.Value" selected="@(option.Value == Model.SelectedScanAgentId ? "selected" : null)">@option.Text</option>
                                }
                            }
                            else
                            {
                                <option value="">Default Codex model</option>
                            }
                        </select>
                    </div>
                    <div class="qa-flow-option qa-flow-option-reco">
                        <label class="qa-flow-radio">
                            <input type="radio" name="mode" value="generate_and_scan" checked />
                            <span style="font-size:.78rem;color:var(--text-primary)">
                                <strong>Generate + auto-scan all</strong> (Recommended)
                                <span style="display:block;color:var(--text-muted);font-size:.7rem;margin-top:2px">Creates test cases, then runs project-wide Codex bug scan automatically.</span>
                            </span>
                        </label>
                    </div>
                    <div class="qa-flow-option">
                        <label class="qa-flow-radio">
                            <input type="radio" name="mode" value="generate_only" />
                            <span style="font-size:.78rem;color:var(--text-primary)">
                                <strong>Generate only</strong>
                                <span style="display:block;color:var(--text-muted);font-size:.7rem;margin-top:2px">Creates test cases only. No scan will run.</span>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="modal-footer" style="border-top:1px solid var(--border);padding:12px 20px">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm" style="background:#3b82f6;color:#fff;font-weight:600">Run Generate Flow</button>
                </div>
            </form>
        </div>
    </div>
</div>

        const homeX=desk?(desk.chairX??desk.x):mapX(a.workLeftPct);
        const homeZ=desk?(desk.chairZ??desk.z):mapZ(a.workTopPct);
        const targetX=homeX;
        const targetZ=homeZ;
        actors.push({
            t:'agent',id:a.id,team:a.team,n:a.name,s:a.taskSummary,c:rgb(a.color||'#22d3ee'),
            x:skipIntro?targetX:ix,z:skipIntro?targetZ:iz,ix,iz,tx:targetX,tz:targetZ,w:!!a.isWorking,
            st:now+i*90,d:1400,p:phase(a.id||String(i)),
            homeX,homeZ,
            idleMode:'desk',
            nextSwitchAt:now+randMs(idleWanderMinMs,idleWanderMaxMs),moving:false

    });
    employees.forEach((e,i)=>{
        const desk=deskByEmployee.get(e.id);
        const ex=desk?(desk.chairX??desk.x):mapX(e.leftPct);
        const ez=desk?(desk.chairZ??desk.z):mapZ(e.topPct);
        actors.push({t:'emp',id:e.id,n:e.name,s:e.role,team:e.team,c:rgb(e.color||'#60a5fa'),
            x:ex,z:ez,tx:ex,tz:ez,homeX:ex,homeZ:ez,w:false,p:phase(e.id||`e-${i}`),
            idleMode:'desk',nextSwitchAt:now+randMs(idleWanderMinMs,idleWanderMaxMs),moving:false});
    });
    actors.push({t:'ceo',id:'ceo',n:payload.ceo?.name||'CEO',s:'CEO',team:'Management',c:rgb('#f59e0b'),

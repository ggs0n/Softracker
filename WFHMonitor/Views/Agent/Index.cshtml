function layout(){
    furniture.length=0;
    deskByAgent.clear();
    deskByEmployee.clear();

    const deskSlots=curTmpl==='small'?layoutSmall():layoutBig();

    let slotIndex=0;
    const resolveDeskSlot=()=>{
        const overflow=slotIndex-deskSlots.length;
        const s=deskSlots[slotIndex]??{x:3+(overflow%4)*3.2,z:5+Math.floor(overflow/4)*2.2};
        slotIndex++;
        return s;
    };
    const placeDesk=(id,label,colorIdx,mapRef)=>{
        const s=resolveDeskSlot();
        mapRef.set(id,{x:s.x,z:s.z,chairX:s.x-.28,chairZ:s.z+.84});
        furniture.push(
            {k:'desk',x:s.x-1.05,z:s.z-.7,w:2.1,d:1.3,h:1.08,dep:s.x+s.z,ci:colorIdx%4,l:label},
            {k:'chair',x:s.x-.42,z:s.z+.72,w:.84,d:.56,h:.65,dep:s.x+s.z+.5}
        );
    };

    agents.forEach((a,idx)=>placeDesk(a.id,a.workspace||`Desk A${idx+1}`,idx,deskByAgent));
    employees.forEach((e,idx)=>placeDesk(e.id,`Desk E${idx+1}`,(idx+2),deskByEmployee));

    for(let i=0;i<3;i++){
        const s=deskSlots[slotIndex+i];
        if(!s)break;
        furniture.push(
            {k:'desk',x:s.x-1.05,z:s.z-.7,w:2.1,d:1.3,h:1.08,dep:s.x+s.z,ci:(i+1)%4,l:`Open ${i+1}`},
            {k:'chair',x:s.x-.42,z:s.z+.72,w:.84,d:.56,h:.65,dep:s.x+s.z+.5}
        );
    }
}

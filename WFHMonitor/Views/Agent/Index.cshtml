        w:false,p:phase('ceo'),idleMode:'desk',nextSwitchAt:now+randMs(idleWanderMinMs,idleWanderMaxMs),moving:false});
}
function nameTag(x,y,t,b){const w=Math.max(38,Math.min(120,t.length*6.7+18)),h=16,tx=x-w/2,ty=y-6;ctx.fillStyle='rgba(3,7,18,.86)';ctx.strokeStyle='rgba(148,163,184,.45)';if(ctx.roundRect){ctx.beginPath();ctx.roundRect(tx,ty,w,h,6);ctx.fill();ctx.stroke();}else{ctx.fillRect(tx,ty,w,h);ctx.strokeRect(tx,ty,w,h);}ctx.fillStyle='#f8fafc';ctx.font='700 10px Inter,sans-serif';ctx.textAlign='left';ctx.fillText(t,tx+8,ty+11.5);ctx.beginPath();ctx.arc(tx+w-8,ty+8,3.4,0,Math.PI*2);ctx.fillStyle=b?'#4ade80':'#64748b';ctx.fill();}
function drawActor(a,t){
    let bob=.015;
    if(a.t==='agent')bob+=Math.sin(t*(a.w?4.1:2.2)+a.p)*(a.w?.03:.01);
    else if(a.t==='emp')bob+=Math.sin(t*2.0+a.p)*.01;
    else bob+=Math.sin(t*1.6+a.p)*.02;

    const sc=a.t==='emp'?1.55:a.t==='ceo'?1.85:1.7;
    const isWalking=!!a.moving;
    const gait=Math.sin(t*(isWalking?5.8:2.0)+a.p);
    const stride=((isWalking?0.06:0.015)*sc*gait);
    const armSwing=((isWalking?0.05:0.015)*sc*gait);
    const lean=((isWalking?0.008:0.003)*sc*gait);

    // Minecraft-like palette
    const skinTop='#f7d7b3',skinMid='#eebf93',skinSide='#d8a377';
    const hairTop='#5b3a28',hairMid='#3b2519',hairSide='#2a1b12';
    const shirtC=shirtColorFor(a);
    const shirtTop=css(bright(shirtC,.08),1),shirtMid=css(shirtC,1),shirtSide=css(dark(shirtC,.25),1);
    const pantsTop='#1e3a8a',pantsMid='#1e40af',pantsSide='#1e3a8a';

    // Proportions
    const legW=.16*sc,legD=.16*sc,legGap=.03*sc,legH=.46*sc;
    const torsoW=.34*sc,torsoD=.17*sc,torsoH=.62*sc;
    const armW=.14*sc,armD=.14*sc,armH=.56*sc;
    const headW=.34*sc,headD=.34*sc,headH=.34*sc;
    const shoeH=.08*sc;
    const yShoe=0+bob;
    const yLeg=yShoe+shoeH;
    const yTorso=yLeg+legH;
    const yArm=yTorso+.02*sc;
    const yHead=yTorso+torsoH+.03*sc;
    const yHair=yHead+headH-.04*sc;

    const teamGlow=(teamSection(a.team)==='right')?'rgba(16,185,129,.34)':'rgba(56,189,248,.34)';
    const rp=iso(a.x,.03,a.z);
    ctx.beginPath();ctx.arc(rp.x,rp.y,12+Math.abs(Math.sin(t*5+a.p))*3,0,Math.PI*2);ctx.strokeStyle=teamGlow;ctx.lineWidth=2.1;ctx.stroke();

    // shoes
    prism(a.x-legGap-legW-.01*sc,a.z-legD/2+stride-.01*sc,legW+.02*sc,legD+.03*sc,shoeH,{top:'#111827',left:'#0b1220',right:'#1f2937'},'rgba(30,41,59,.42)',yShoe);
    prism(a.x+legGap-.01*sc,a.z-legD/2-stride-.01*sc,legW+.02*sc,legD+.03*sc,shoeH,{top:'#111827',left:'#0b1220',right:'#1f2937'},'rgba(30,41,59,.42)',yShoe);
    // legs
    prism(a.x-legGap-legW,a.z-legD/2+stride,legW,legD,legH,{top:pantsTop,left:pantsMid,right:pantsSide},'rgba(30,41,59,.42)',yLeg);
    prism(a.x+legGap,a.z-legD/2-stride,legW,legD,legH,{top:pantsTop,left:pantsMid,right:pantsSide},'rgba(30,41,59,.42)',yLeg);

    // torso + arms
    prism(a.x-torsoW/2+lean,a.z-torsoD/2,torsoW,torsoD,torsoH,{top:shirtTop,left:shirtMid,right:shirtSide},'rgba(30,41,59,.42)',yTorso);
    prism(a.x-torsoW/2-armW+lean,a.z-armD/2+armSwing,armW,armD,armH,{top:shirtTop,left:shirtMid,right:shirtSide},'rgba(30,41,59,.42)',yArm);
    prism(a.x+torsoW/2+lean,a.z-armD/2-armSwing,armW,armD,armH,{top:shirtTop,left:shirtMid,right:shirtSide},'rgba(30,41,59,.42)',yArm);

    // hands
    prism(a.x-torsoW/2-armW+lean,a.z-armD/2+armSwing,armW*.9,armD*.9,.16*sc,{top:skinTop,left:skinMid,right:skinSide},'rgba(148,163,184,.32)',yArm-.14*sc);
    prism(a.x+torsoW/2+lean,a.z-armD/2-armSwing,armW*.9,armD*.9,.16*sc,{top:skinTop,left:skinMid,right:skinSide},'rgba(148,163,184,.32)',yArm-.14*sc);

    // cube head + hair cap
    prism(a.x-headW/2+lean,a.z-headD/2,headW,headD,headH,{top:skinTop,left:skinMid,right:skinSide},'rgba(148,163,184,.36)',yHead);
    prism(a.x-headW/2+lean,a.z-headD/2,headW,headD*.88,.08*sc,{top:hairTop,left:hairMid,right:hairSide},'rgba(30,41,59,.24)',yHair);

    // simple pixel-eyes
    const eyeL=iso(a.x-headW*.18+lean,yHead+headH*.55,a.z+headD*.22);
    const eyeR=iso(a.x+headW*.18+lean,yHead+headH*.55,a.z+headD*.22);
    ctx.fillStyle='rgba(15,23,42,.95)';
    ctx.fillRect(eyeL.x-1.2,eyeL.y-1.2,2.2,2.2);
    ctx.fillRect(eyeR.x-1.2,eyeR.y-1.2,2.2,2.2);

    const np=iso(a.x+lean,yHead+headH+.18*sc,a.z);
    nameTag(np.x,np.y,a.n,!!a.w);
    const ip=iso(a.x+lean,yHead+headH*.42,a.z);
    ctx.fillStyle=a.t==='ceo'?'#78350f':'#0f172a';
    ctx.font=`700 ${Math.max(8,Math.floor(8.2*sc))}px Inter,sans-serif`;
    ctx.textAlign='center';
    ctx.fillText(initials(a.n),ip.x,ip.y+2.5);
}
function switchTemplate(tmpl){
    if(tmpl===curTmpl)return;
    curTmpl=tmpl;
    localStorage.setItem('softracker.officeTmpl',tmpl);
    Object.assign(room,roomConfigs[tmpl]||roomConfigs.big);
    refreshIdleSpots();
    resize();layout();buildActors();
    if(tmplSmallBtn)tmplSmallBtn.classList.toggle('active',tmpl==='small');
    if(tmplBigBtn)tmplBigBtn.classList.toggle('active',tmpl==='big');
}
if(tmplSmallBtn){tmplSmallBtn.addEventListener('click',()=>switchTemplate('small'));tmplSmallBtn.classList.toggle('active',curTmpl==='small');}
if(tmplBigBtn){tmplBigBtn.addEventListener('click',()=>switchTemplate('big'));tmplBigBtn.classList.toggle('active',curTmpl==='big');}
resize();layout();buildActors();window.addEventListener('resize',resize);
let raf=0,lastMs=Date.now();function frame(){
    raf=requestAnimationFrame(frame);
    const ms=Date.now(),dt=Math.max(0.001,Math.min(0.05,(ms-lastMs)/1000)),wt=(ms-epoch)/1000;
    lastMs=ms;

    roomDraw();
    [...furniture].sort((a,b)=>(a.dep||0)-(b.dep||0)).forEach(drawFurniture);

    actors.forEach(a=>{
        // Agent intro animation
        if(a.t==='agent'&&!skipIntro&&ms>=a.st){
            const p=Math.min((ms-a.st)/a.d,1),e=ease(p);
            a.x=lerp(a.ix,a.tx,e);
            a.z=lerp(a.iz,a.tz,e);
            return;
        }

        // Assigned task: stay/return to own desk, never wander.
        if(a.w){
            a.idleMode='desk';
            a.tx=a.homeX;
            a.tz=a.homeZ;
        }

        // Movement towards target
        if(a.tx!=null&&a.tz!=null){
            const dx=a.tx-a.x,dz=a.tz-a.z,dist=Math.hypot(dx,dz);
            const spd=a.t==='ceo'?0.8:a.t==='emp'?0.9:1.02;
            if(dist>0.04){
                const step=Math.min(dist,spd*dt);
                a.x+=dx/dist*step;
                a.z+=dz/dist*step;
                a.moving=true;
                return;
            }
        }

        a.moving=false;
        if(a.w)return;

        // Idle wander for agents, employees, and CEO
        if(a.nextSwitchAt!=null&&ms>=a.nextSwitchAt){
            const next=pickNextIdleDestination(a);
            a.idleMode=next.mode;
            a.tx=next.x;
            a.tz=next.z;
            a.nextSwitchAt=ms+randMs(idleWanderMinMs,idleWanderMaxMs);
        }
    });

    [...actors].sort((a,b)=>(a.x+a.z)-(b.x+b.z)).forEach(a=>drawActor(a,wt));
}
frame();
const save={keySeed,epochMs:epoch,introDone:true};try{sessionStorage.setItem(stateKey,JSON.stringify(save))}catch(_){}
window.addEventListener('beforeunload',()=>{try{sessionStorage.setItem(stateKey,JSON.stringify(save))}catch(_){}cancelAnimationFrame(raf);});
const mytEl=document.getElementById('mytClock');
function tickMYT(){const d=new Date();const myt=new Date(d.getTime()+d.getTimezoneOffset()*60000+8*3600000);const hh=String(myt.getHours()).padStart(2,'0'),mm=String(myt.getMinutes()).padStart(2,'0'),ss=String(myt.getSeconds()).padStart(2,'0');if(mytEl)mytEl.textContent=`${hh}:${mm}:${ss}`;}
tickMYT();setInterval(tickMYT,1000);
})();
</script>

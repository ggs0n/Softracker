@using System.Text.Json
@model WFHMonitor.ViewModels.AgentDashboardViewModel
@{
    ViewData["Title"] = "Agent Office";
    var scenePayload = new
    {
        ceo = new { name = Model.CeoName },
        agents = Model.Agents.Select(a => new
        {
            id = a.UserId,
            name = a.Name,
            team = a.TeamName,
            isWorking = a.IsWorking,
            isOnline = a.IsOnline,
            taskCount = a.ActiveTaskCount,
            taskSummary = a.TaskSummary,
            color = a.AccentColor,
            idleLeftPct = a.IdleLeftPct,
            idleTopPct = a.IdleTopPct,
            workLeftPct = a.WorkLeftPct,
            workTopPct = a.WorkTopPct,
            workspace = a.WorkspaceName
        }),
        employees = Model.Employees.Select(e => new
        {
            id = e.UserId,
            name = e.Name,
            role = e.Role,
            team = e.TeamName,
            isOnline = e.IsOnline,
            color = e.AccentColor,
            leftPct = e.LeftPct,
            topPct = e.TopPct
        })
    };
    var onlineAgentCount = Model.Agents.Count(a => a.IsOnline);
    var onlineEmployeeCount = Model.Employees.Count(e => e.IsOnline);
}

<style>
    .office-shell{display:grid;grid-template-columns:minmax(0,1fr)320px;gap:16px}
    .office-stage-wrap{background:linear-gradient(160deg,#120a06,#2b1c14);border:1px solid rgba(251,191,36,.2);border-radius:16px;overflow:hidden;box-shadow:0 20px 46px rgba(0,0,0,.45)}
    .office-hud{padding:10px 14px;border-bottom:1px solid rgba(251,191,36,.2);display:flex;justify-content:space-between;align-items:center;gap:10px;color:#f9c993;font-size:.78rem;background:linear-gradient(180deg,rgba(59,32,20,.66),rgba(29,18,13,.66))}
    .office-hud strong{color:#fde4c4;font-size:.9rem;letter-spacing:.08em;text-transform:uppercase}
    .office-tmpl-bar{display:flex;gap:6px;align-items:center}
    .office-tmpl-bar span{font-size:.65rem;text-transform:uppercase;letter-spacing:.06em;color:#fdba74;font-weight:600;margin-right:2px}
    .office-tmpl-btn{border:1px solid rgba(251,191,36,.25);background:rgba(30,24,18,.6);color:#f9c993;font-size:.68rem;font-weight:600;padding:4px 12px;border-radius:8px;cursor:pointer;transition:all .2s ease;display:inline-flex;align-items:center;gap:5px}
    .office-tmpl-btn:hover{background:rgba(251,191,36,.12);border-color:rgba(251,191,36,.45)}
    .office-tmpl-btn.active{background:rgba(251,191,36,.18);border-color:#f59e0b;color:#fde4c4;box-shadow:0 0 10px rgba(245,158,11,.2)}
    .office-tmpl-btn i{font-size:.72rem}
    .office-clock{display:flex;align-items:center;gap:6px;font-size:.72rem;color:#fde4c4;font-weight:700;letter-spacing:.04em;font-variant-numeric:tabular-nums}
    .office-clock i{color:#fdba74;font-size:.7rem}
    .office-clock .clock-label{font-size:.55rem;text-transform:uppercase;letter-spacing:.06em;color:#fdba74;font-weight:600}
    .office-scene{position:relative;height:760px;background:radial-gradient(circle at 50% 0%,#28150c 0%,#130a07 62%,#090603 100%)}
    #office3dCanvas{width:100%;height:100%;display:block}
    .office-chip-strip{position:absolute;top:12px;left:14px;right:180px;display:flex;gap:8px;overflow-x:auto}
    .office-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(12,10,9,.74);border:1px solid rgba(113,113,122,.45);border-radius:999px;padding:4px 10px;color:#f8fafc;font-size:.62rem}
    .office-chip-dot{width:8px;height:8px;border-radius:50%}
    .office-chip-dot.busy{background:#4ade80;box-shadow:0 0 6px rgba(74,222,128,.8)}
    .office-chip-dot.idle{background:#64748b}
    .office-status-card{position:absolute;top:12px;right:14px;border-radius:14px;border:1px solid rgba(20,184,166,.35);background:linear-gradient(170deg,rgba(6,78,59,.75),rgba(6,95,70,.55));color:#ecfeff;padding:8px 10px;font-size:.66rem}
    .office-side-rail{position:absolute;right:8px;top:180px;display:flex;flex-direction:column;gap:8px}
    .office-side-tab{writing-mode:vertical-rl;transform:rotate(180deg);font-size:.56rem;letter-spacing:.08em;text-transform:uppercase;color:#e2e8f0;border:1px solid rgba(148,163,184,.35);border-radius:9px;padding:8px 5px;background:rgba(3,7,18,.66)}
    .office-fallback{position:absolute;inset:0;display:none;align-items:center;justify-content:center;color:#fde4c4;font-size:.85rem;background:rgba(15,10,7,.9);text-align:center;padding:16px}
    .office-fallback.show{display:flex}
    .office-panel{background:linear-gradient(165deg,#130f0b,#1d1712);border:1px solid rgba(251,191,36,.2);border-radius:16px;padding:14px;color:#f3f4f6}
    .office-panel-title{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:#fdba74;font-weight:700;margin-bottom:8px}
    .office-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:12px}
    .office-stat{background:rgba(30,24,18,.7);border:1px solid rgba(251,191,36,.24);border-radius:10px;padding:8px}
    .office-stat-value{font-size:1.08rem;line-height:1;font-weight:800;color:#fff7ed}
    .office-stat-label{font-size:.62rem;text-transform:uppercase;letter-spacing:.06em;color:#fdba74;margin-top:3px}
    .agent-list{max-height:640px;overflow:auto;padding-right:4px}
    .agent-list-item{border:1px solid rgba(251,191,36,.24);border-radius:10px;background:rgba(26,19,14,.7);padding:8px 9px;margin-bottom:8px}
    .agent-list-name{font-size:.72rem;font-weight:700;color:#fff7ed;display:flex;justify-content:space-between}
    .agent-list-team{font-size:.58rem;color:#fdba74;margin-top:2px}
    .agent-list-task{margin-top:5px;font-size:.6rem;color:#fed7aa;line-height:1.35}
    .agent-status{font-size:.56rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;padding:1px 6px;border-radius:999px}
    .agent-status.working{color:#bbf7d0;background:rgba(22,101,52,.45);border:1px solid rgba(74,222,128,.5)}
    .agent-status.idle{color:#cbd5e1;background:rgba(51,65,85,.5);border:1px solid rgba(100,116,139,.5)}
    .agent-online-dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:3px;vertical-align:middle}
    .agent-online-dot.on{background:#22c55e;box-shadow:0 0 6px rgba(34,197,94,.5)}
    .agent-online-dot.off{background:#475569}
    @@media (max-width:1400px){.office-shell{grid-template-columns:1fr}}
    @@media (max-width:767px){.office-scene{height:620px}.agent-list{max-height:none}.office-side-rail,.office-status-card{display:none}.office-chip-strip{right:12px;top:54px}}
</style>

<div class="office-shell">
    <div class="office-stage-wrap">
        <div class="office-hud">
            <div><strong>@Model.CeoName HQ</strong><span class="ms-2">Isometric live office view</span></div>
            <div class="office-clock"><i class="bi bi-clock"></i><span class="clock-label">MYT</span><span id="mytClock">--:--:--</span></div>
            <div class="office-tmpl-bar">
                <span>Template:</span>
                <button type="button" class="office-tmpl-btn" data-tmpl="small" id="tmplSmall"><i class="bi bi-house-door"></i> Small</button>
                <button type="button" class="office-tmpl-btn" data-tmpl="big" id="tmplBig"><i class="bi bi-building"></i> Big</button>
            </div>
        </div>
        <div class="office-scene">
            <canvas id="office3dCanvas"></canvas>
            <div class="office-chip-strip">
                @foreach (var agent in Model.Agents)
                {
                    <span class="office-chip"><span class="agent-online-dot @(agent.IsOnline ? "on" : "off")"></span><span class="office-chip-dot @(agent.IsWorking ? "busy" : "idle")"></span><span>@agent.Name</span><span style="opacity:.7">(@agent.TeamName)</span></span>
                }
            </div>
            <div class="office-status-card">
                <div style="text-transform:uppercase;letter-spacing:.08em;font-weight:700;color:#99f6e4;font-size:.55rem">Standup Board</div>
                <div>Gathering in meeting room...</div>
                <div style="color:#99f6e4">@Model.WorkingAgentCount / @Math.Max(Model.AgentCount, 1) active</div>
            </div>
            <div class="office-side-rail">
                <span class="office-side-tab">Open Hub</span>
                <span class="office-side-tab">Marketplace</span>
                <span class="office-side-tab">Analytics</span>
            </div>
            <div id="officeFallback" class="office-fallback">3D engine failed to initialize in this browser. Please refresh and ensure Canvas is enabled.</div>
        </div>
    </div>

    <div class="office-panel">
        <div class="office-panel-title">Office Summary</div>
        <div class="office-stats">
            <div class="office-stat"><div class="office-stat-value">@Model.TeamCount</div><div class="office-stat-label">Teams</div></div>
            <div class="office-stat"><div class="office-stat-value">@Model.AgentCount</div><div class="office-stat-label">Agents</div></div>
            <div class="office-stat"><div class="office-stat-value">@Model.WorkingAgentCount</div><div class="office-stat-label">Working</div></div>
            <div class="office-stat"><div class="office-stat-value" style="color:#22c55e">@onlineAgentCount</div><div class="office-stat-label">Online</div></div>
            <div class="office-stat"><div class="office-stat-value">@Model.EmployeeCount</div><div class="office-stat-label">Employees</div></div>
        </div>
        <div class="office-panel-title">Agent Assignments</div>
        <div class="agent-list">
            @if (!Model.Agents.Any())
            {
                <div class="agent-list-item"><div class="agent-list-name">No agents found</div><div class="agent-list-task">Add users with Agent role to populate this office.</div></div>
            }
            else
            {
                @foreach (var agent in Model.Agents)
                {
                    <div class="agent-list-item">
                        <div class="agent-list-name"><span class="agent-online-dot @(agent.IsOnline ? "on" : "off")"></span><span>@agent.Name</span><span class="agent-status @(agent.IsWorking ? "working" : "idle")">@(agent.IsWorking ? "Working" : "Idle")</span></div>
                        <div class="agent-list-team">@agent.TeamName - @agent.WorkspaceName · <span style="font-size:.6rem;color:@(agent.IsOnline ? "#22c55e" : "#64748b")">@(agent.IsOnline ? "Online" : "Offline")</span></div>
                        <div class="agent-list-task">@agent.TaskSummary</div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script id="officeSceneData" type="application/json">@Html.Raw(JsonSerializer.Serialize(scenePayload))</script>
@section Scripts {
<script>
(() => {
const canvas=document.getElementById('office3dCanvas'),fallback=document.getElementById('officeFallback'),dataNode=document.getElementById('officeSceneData');
if(!canvas||!dataNode)return;const ctx=canvas.getContext('2d');if(!ctx){fallback?.classList.add('show');return;}
const payload=JSON.parse(dataNode.textContent||'{}'),agents=Array.isArray(payload.agents)?payload.agents:[],employees=Array.isArray(payload.employees)?payload.employees:[];
const keySeed=agents.map(a=>`${a.id}:${a.isWorking?1:0}:${a.taskCount}`).join('|');
const stateKey='softracker.office3d.iso.state.v8';let saved=null;try{saved=JSON.parse(sessionStorage.getItem(stateKey)||'null')}catch(_){}
const now=Date.now(),match=!!saved&&saved.keySeed===keySeed,epoch=match&&typeof saved.epochMs==='number'?saved.epochMs:now,skipIntro=match&&saved.introDone===true;
let curTmpl=localStorage.getItem('softracker.officeTmpl')||'big';
const tmplSmallBtn=document.getElementById('tmplSmall'),tmplBigBtn=document.getElementById('tmplBig');
const roomConfigs={big:{w:38,d:24,wallH:4.2},small:{w:22,d:16,wallH:3.6}};
const room=Object.assign({},roomConfigs[curTmpl]||roomConfigs.big),view={w:1200,h:760,ox:0,oy:0,tw:0,th:0,elev:0};
const clamp=(v,min,max)=>Math.max(min,Math.min(max,v)),lerp=(a,b,t)=>a+(b-a)*t,ease=t=>1-Math.pow(1-t,3);
const mapX=p=>2+clamp((p||0)/100,0,1)*(room.w-4),mapZ=p=>2+clamp((p||0)/100,0,1)*(room.d-4);
const rgb=h=>{const c=String(h||'').replace('#','');if(c.length!==6)return{r:54,g:211,b:153};const n=parseInt(c,16);return{r:(n>>16)&255,g:(n>>8)&255,b:n&255}};
const css=(c,a)=>`rgba(${c.r},${c.g},${c.b},${a})`,bright=(c,a)=>({r:clamp(Math.round(c.r+(255-c.r)*a),0,255),g:clamp(Math.round(c.g+(255-c.g)*a),0,255),b:clamp(Math.round(c.b+(255-c.b)*a),0,255)}),dark=(c,a)=>({r:clamp(Math.round(c.r*(1-a)),0,255),g:clamp(Math.round(c.g*(1-a)),0,255),b:clamp(Math.round(c.b*(1-a)),0,255)});
const phase=s=>{let h=0;for(let i=0;i<s.length;i++){h=((h<<5)-h)+s.charCodeAt(i);h|=0;}return Math.abs(h%628)/100;};
const textHash=s=>{let h=0;const t=String(s||'avatar');for(let i=0;i<t.length;i++){h=((h<<5)-h)+t.charCodeAt(i);h|=0;}return Math.abs(h);};
const hslToRgb=(h,s,l)=>{const c=(1-Math.abs(2*l-1))*s,x=c*(1-Math.abs((h/60)%2-1)),m=l-c/2;let r=0,g=0,b=0;if(h<60){r=c;g=x;}else if(h<120){r=x;g=c;}else if(h<180){g=c;b=x;}else if(h<240){g=x;b=c;}else if(h<300){r=x;b=c;}else{r=c;b=x;}return{r:Math.round((r+m)*255),g:Math.round((g+m)*255),b:Math.round((b+m)*255)};};
const shirtColorFor=a=>{const seed=textHash(`${a.id||a.n||'avatar'}:${a.team||''}:${a.t||''}`),h=seed%360,s=(66+(seed%18))/100,l=(42+((seed>>3)%12))/100;return hslToRgb(h,s,l);};
const initials=n=>{if(!n)return'?';const p=String(n).trim().split(/\\s+/).slice(0,2);if(!p.length)return'?';if(p.length===1)return p[0][0].toUpperCase();return (p[0][0]+p[1][0]).toUpperCase();};
const teamSection=(name)=>{const t=String(name||'').toLowerCase();if(t.includes('team 1')||t.includes('team1'))return'left';if(t.includes('team 2')||t.includes('team2'))return'right';return'left';};
const randMs=(min,max)=>Math.floor(min+Math.random()*(max-min+1));
const idleWanderMinMs=10000,idleWanderMaxMs=30000;
const idleSpotConfigs={
    big:{
        pantry:[{x:29.8,z:18.0},{x:31.0,z:18.8},{x:32.2,z:18.1},{x:30.8,z:19.5}],
        gaming:[{x:29.2,z:21.2},{x:31.0,z:21.6},{x:33.0,z:21.1},{x:31.8,z:22.3}],
        extra:[{x:11.7,z:3.4},{x:15.3,z:9.4},{x:23.4,z:11.4},{x:26.4,z:14.6},{x:18.2,z:18.2}]
    },
    small:{
        pantry:[{x:17.2,z:13.2},{x:18.4,z:13.8},{x:19.0,z:12.8},{x:17.8,z:14.4}],
        gaming:[{x:2.0,z:13.0},{x:3.4,z:13.6},{x:1.8,z:14.4},{x:4.2,z:12.8}],
        extra:[{x:7.5,z:7.5},{x:11.0,z:10.0},{x:5.0,z:12.0},{x:13.0,z:6.5},{x:9.0,z:13.5}]
    }
};
let pantrySpots=idleSpotConfigs[curTmpl].pantry;
let gamingSpots=idleSpotConfigs[curTmpl].gaming;
let idleWalkSpots=[...pantrySpots,...gamingSpots,...idleSpotConfigs[curTmpl].extra];
function refreshIdleSpots(){
    const cfg=idleSpotConfigs[curTmpl]||idleSpotConfigs.big;
    pantrySpots=cfg.pantry;gamingSpots=cfg.gaming;
    idleWalkSpots=[...pantrySpots,...gamingSpots,...cfg.extra];
}
let ceoSeat={x:30.9,z:4.35};
const pickRandomSpot=spots=>spots[Math.floor(Math.random()*spots.length)];
const pickNextIdleDestination=agent=>{
    if(Math.random()<0.32)return{mode:'desk',x:agent.homeX,z:agent.homeZ};
    const nextSpot=pickRandomSpot(idleWalkSpots);
    return{mode:'wander',x:nextSpot.x,z:nextSpot.z};
};
function resize(){const dpr=Math.min(window.devicePixelRatio||1,2),w=canvas.clientWidth,h=canvas.clientHeight;if(!w||!h)return;canvas.width=Math.floor(w*dpr);canvas.height=Math.floor(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);view.w=w;view.h=h;const mx=110,my=124,base=Math.min((w-mx*2)/(room.w+room.d),(h-my*2)/(room.w+room.d)*2);view.tw=Math.max(10,base*1.13);view.th=view.tw*.52;view.elev=view.th*1.75;view.ox=w/2;view.oy=120;}
const iso=(x,y,z)=>({x:view.ox+(x-z)*view.tw,y:view.oy+(x+z)*view.th-y*view.elev});
function poly(points,fill,stroke){if(!points.length)return;ctx.beginPath();ctx.moveTo(points[0].x,points[0].y);for(let i=1;i<points.length;i++)ctx.lineTo(points[i].x,points[i].y);ctx.closePath();if(fill){ctx.fillStyle=fill;ctx.fill();}if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=1;ctx.stroke();}}
function prism(x,z,w,d,h,pal,stroke,y0=0){const y1=y0+h,a=iso(x,y1,z),b=iso(x+w,y1,z),c=iso(x+w,y1,z+d),dp=iso(x,y1,z+d),b0=iso(x+w,y0,z),c0=iso(x+w,y0,z+d),d0=iso(x,y0,z+d);poly([dp,c,c0,d0],pal.left,stroke);poly([b,c,c0,b0],pal.right,stroke);poly([a,b,c,dp],pal.top,stroke);}
function roomDrawBase(){
    ctx.fillStyle='#100905';
    ctx.fillRect(0,0,view.w,view.h);
    const A=iso(0,0,0),B=iso(room.w,0,0),C=iso(room.w,0,room.d),D=iso(0,0,room.d);
    poly([A,B,C,D],'#e9e4d4','rgba(133,126,111,.6)');
    // Floor grid
    ctx.strokeStyle='rgba(193,186,168,.35)';
    const gx=Math.max(8,Math.round(room.w/2)),gz=Math.max(6,Math.round(room.d/1.4));
    for(let i=1;i<gx;i++){const t=(room.w/gx)*i,p1=iso(t,.01,0),p2=iso(t,.01,room.d);ctx.beginPath();ctx.moveTo(p1.x,p1.y);ctx.lineTo(p2.x,p2.y);ctx.stroke();}
    for(let i=1;i<gz;i++){const t=(room.d/gz)*i,p1=iso(0,.01,t),p2=iso(room.w,.01,t);ctx.beginPath();ctx.moveTo(p1.x,p1.y);ctx.lineTo(p2.x,p2.y);ctx.stroke();}
    // Walls
    const nw=iso(0,0,0),ne=iso(room.w,0,0),se=iso(room.w,0,room.d),sw=iso(0,0,room.d),nwt=iso(0,room.wallH,0),net=iso(room.w,room.wallH,0),set=iso(room.w,room.wallH,room.d),swt=iso(0,room.wallH,room.d);
    poly([nw,ne,net,nwt],'#a7a8af','rgba(113,113,122,.65)');
    poly([nw,sw,swt,nwt],'#8f9098','rgba(113,113,122,.6)');
    poly([ne,se,set,net],'#9ea0a8','rgba(113,113,122,.6)');
}
function roomDrawBig(){
    roomDrawBase();
    // Zone overlays
    poly([iso(1,.01,7),iso(6.7,.01,7),iso(6.7,.01,13.2),iso(1,.01,13.2)],'rgba(30,58,138,.10)','rgba(59,130,246,.25)');
    poly([iso(28.4,.01,2.1),iso(35.1,.01,2.1),iso(35.1,.01,5.8),iso(28.4,.01,5.8)],'rgba(14,165,233,.10)','rgba(14,165,233,.28)');
    poly([iso(27.5,.01,16.8),iso(34.3,.01,16.8),iso(34.3,.01,20.2),iso(27.5,.01,20.2)],'rgba(245,158,11,.08)','rgba(245,158,11,.28)');
    poly([iso(27.5,.01,20.3),iso(34.3,.01,20.3),iso(34.3,.01,23.2),iso(27.5,.01,23.2)],'rgba(124,58,237,.08)','rgba(139,92,246,.28)');
    ctx.font='700 10px Inter,sans-serif';ctx.textAlign='center';
    const lb=(x,z,c,t)=>{const p=iso(x,.03,z);ctx.fillStyle=c;ctx.fillText(t,p.x,p.y);};
    lb(3.7,10.4,'rgba(59,130,246,.9)','SERVER ROOM');lb(11.5,3,'rgba(71,85,105,.9)','MEETING');
    lb(31.8,3.2,'rgba(14,165,233,.95)','CEO SECTION');lb(30,7.5,'rgba(16,185,129,.9)','OPS DESK');
    lb(31.2,18.5,'rgba(234,179,8,.95)','PANTRY');lb(31.2,21.8,'rgba(167,139,250,.95)','GAMING');
}
function roomDrawSmall(){
    roomDrawBase();
    // Small office zones: CEO corner, pantry nook, gaming nook, workspace
    poly([iso(16,.01,1),iso(21,.01,1),iso(21,.01,4.5),iso(16,.01,4.5)],'rgba(14,165,233,.10)','rgba(14,165,233,.28)');
    poly([iso(16,.01,12),iso(21,.01,12),iso(21,.01,15),iso(16,.01,15)],'rgba(245,158,11,.08)','rgba(245,158,11,.28)');
    poly([iso(1,.01,1),iso(5.5,.01,1),iso(5.5,.01,4.5),iso(1,.01,4.5)],'rgba(71,85,105,.10)','rgba(100,116,139,.25)');
    poly([iso(1,.01,12),iso(6,.01,12),iso(6,.01,15.2),iso(1,.01,15.2)],'rgba(124,58,237,.08)','rgba(139,92,246,.28)');
    ctx.font='700 9px Inter,sans-serif';ctx.textAlign='center';
    const lb=(x,z,c,t)=>{const p=iso(x,.03,z);ctx.fillStyle=c;ctx.fillText(t,p.x,p.y);};
    lb(18.5,2.8,'rgba(14,165,233,.95)','CEO');lb(18.5,13.5,'rgba(234,179,8,.95)','PANTRY');
    lb(3.2,2.8,'rgba(71,85,105,.9)','MEETING');lb(11,8,'rgba(16,185,129,.9)','WORKSPACE');
    lb(3.5,13.6,'rgba(167,139,250,.95)','GAMING');

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Softracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act  = ViewContext.RouteData.Values["action"]?.ToString();

    <aside class="sidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon"><i class="bi bi-display"></i></div>
            <span>Softracker</span>
        </a>

        <div class="sidebar-section-label">Main</div>
        <ul class="sidebar-nav">
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Admin" asp-action="Index"
                       class="@(ctrl == "Admin" && act == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
            }
            <li>
                <a asp-controller="TaskBoard" asp-action="Index"
                   class="@(ctrl == "TaskBoard" ? "active" : "")">
                    <i class="bi bi-kanban"></i> Task Board
                </a>
            </li>
            @if (User.IsInRole("Employee") || User.IsInRole("Developer"))
            {
                @if (User.IsInRole("Developer"))
                {
                    <li>
                        <a asp-controller="Developer" asp-action="Summary"
                           class="@(ctrl == "Developer" && act == "Summary" ? "active" : "")">
                            <i class="bi bi-clipboard-data"></i> Developer Summary
                        </a>
                    </li>
                }
            }
        </ul>

        <div class="sidebar-section-label">Management</div>
        <ul class="sidebar-nav">
            <li>
                <a asp-controller="ChangeRequest" asp-action="Index"
                   class="@(ctrl == "ChangeRequest" ? "active" : "")">
                    <i class="bi bi-file-earmark-diff"></i> Change Requests
                </a>
            </li>
            @if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
            {
                <li>
                    <a asp-controller="Bug" asp-action="Index"
                       class="@(ctrl == "Bug" ? "active" : "")">
                        <i class="bi bi-bug"></i> Bugs
                    </a>
                </li>
            }
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Admin" asp-action="Employees"
                       class="@(ctrl == "Admin" && act == "Employees" ? "active" : "")">
                        <i class="bi bi-people"></i> Employees
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <i class="bi bi-person-circle"></i>
                <div>
                    <div class="fw-semibold text-white" style="font-size:0.82rem;">@User.Identity!.Name</div>
                    <div style="font-size:0.72rem;opacity:0.5;">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Tester") ? "Tester" : User.IsInRole("Developer") ? "Developer" : "Employee")</div>
                </div>
            </div>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    <div class="main-wrapper">
        <div class="main-topbar">
            <h1 class="page-title">@(ViewData["Title"] ?? "Softracker")</h1>
            <div class="d-flex align-items-center gap-2">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="TaskBoard" asp-action="Create" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>New Task
                    </a>
                }
            </div>
        </div>

        <div class="main-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-3">
                    <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

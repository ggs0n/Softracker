@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using WFHMonitor.Models
@using WFHMonitor.Services.Interfaces
@inject INotificationService NotificationService
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Softracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act  = ViewContext.RouteData.Values["action"]?.ToString();
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var notificationBell = string.IsNullOrWhiteSpace(userId)
        ? new WFHMonitor.ViewModels.NotificationBellViewModel()
        : await NotificationService.GetBellAsync(userId);
    var currentUser = string.IsNullOrWhiteSpace(userId)
        ? null
        : await UserManager.FindByIdAsync(userId);
    var isProActive = currentUser?.SubscriptionPlan == SubscriptionPlan.Pro && currentUser.IsProSubscriptionActive;
    var isProPending = currentUser?.SubscriptionPlan == SubscriptionPlan.Pro && !currentUser.IsProSubscriptionActive;
    var planIndicatorClass = isProActive ? "pro" : isProPending ? "pending" : "free";
    var planIndicatorLabel = isProActive ? "PRO ACTIVE" : isProPending ? "PRO PENDING" : "FREE";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var notificationDropdownModel = new WFHMonitor.ViewModels.NotificationDropdownViewModel
    {
        Bell = notificationBell,
        ReturnUrl = returnUrl
    };
    var isProjectsSectionActive = ctrl == "ChangeRequest" || ctrl == "Bug";
    var isMonitorSectionActive = ctrl == "Monitor";
    var isPaymentSectionActive = ctrl == "Payment";
    var isTeamSectionActive = ctrl == "Team" || ctrl == "Agent" || (ctrl == "Admin" && act == "Employees");

    <aside class="sidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon"><i class="bi bi-display"></i></div>
            <span>Softracker</span>
        </a>

        <div class="sidebar-section-label">Main</div>
        <ul class="sidebar-nav">
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Admin" asp-action="Index"
                       class="@(ctrl == "Admin" && act == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
            }
            <li>
                <a asp-controller="TaskBoard" asp-action="Index"
                   class="@(ctrl == "TaskBoard" ? "active" : "")">
                    <i class="bi bi-kanban"></i> Task Board
                </a>
            </li>
            @if (User.IsInRole("Employee") || User.IsInRole("Developer"))
            {
                @if (User.IsInRole("Developer"))
                {
                    <li>
                        <a asp-controller="Developer" asp-action="Summary"
                           class="@(ctrl == "Developer" && act == "Summary" ? "active" : "")">
                            <i class="bi bi-clipboard-data"></i> Developer Summary
                        </a>
                    </li>
                }
            }
        </ul>

        <div class="sidebar-section-label">Management</div>
        <ul class="sidebar-nav">
            <li class="sidebar-nav-group">
                <a href="#projectsNavGroup"
                   data-bs-toggle="collapse"
                   role="button"
                   aria-expanded="@(isProjectsSectionActive ? "true" : "false")"
                   aria-controls="projectsNavGroup"
                   class="sidebar-group-toggle @(isProjectsSectionActive ? "active" : "")">
                    <span><i class="bi bi-file-earmark-diff"></i> Projects</span>
                    <i class="bi bi-chevron-down sidebar-group-chevron"></i>
                </a>
                <ul class="sidebar-subnav collapse @(isProjectsSectionActive ? "show" : "")" id="projectsNavGroup">
                    <li>
                        <a asp-controller="ChangeRequest" asp-action="Index"
                           class="@(ctrl == "ChangeRequest" && act != "Features" ? "active" : "")">
                            <i class="bi bi-grid-1x2"></i> All Projects
                        </a>
                    </li>
                    <li>
                        <a asp-controller="ChangeRequest" asp-action="Features"
                           class="@(ctrl == "ChangeRequest" && act == "Features" ? "active" : "")">
                            <i class="bi bi-list-check"></i> Features
                        </a>
                    </li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
                    {
                        <li>
                            <a asp-controller="Bug" asp-action="Index"
                               class="@(ctrl == "Bug" ? "active" : "")">
                                <i class="bi bi-bug"></i> Bugs
                            </a>
                        </li>
                    }
                </ul>
            </li>
            @if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
            {
                <li>
                    <a asp-controller="Monitor" asp-action="Index"
                       class="@(isMonitorSectionActive ? "active" : "")">
                        <i class="bi bi-activity"></i> Monitor
                    </a>
                </li>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer") || User.IsInRole("Agent"))
            {
                <li class="sidebar-nav-group">
                    <a href="#teamNavGroup"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="@(isTeamSectionActive ? "true" : "false")"
                       aria-controls="teamNavGroup"
                       class="sidebar-group-toggle @(isTeamSectionActive ? "active" : "")">
                        <span><i class="bi bi-diagram-3"></i> Team</span>
                        <i class="bi bi-chevron-down sidebar-group-chevron"></i>
                    </a>
                    <ul class="sidebar-subnav collapse @(isTeamSectionActive ? "show" : "")" id="teamNavGroup">
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Team" asp-action="Index"
                                   class="@(ctrl == "Team" && act == "Index" ? "active" : "")">
                                    <i class="bi bi-people"></i> Team
                                </a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Agent" asp-action="Index"
                               class="@(ctrl == "Agent" ? "active" : "")">
                                <i class="bi bi-cpu"></i> Agent
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Team" asp-action="Employees"
                                   class="@(ctrl == "Admin" && act == "Employees" ? "active" : "")">
                                    <i class="bi bi-person-badge"></i> Employees
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            <li>
                <a asp-controller="Payment" asp-action="Index"
                   class="@(isPaymentSectionActive ? "active" : "")">
                    <i class="bi bi-credit-card-2-front"></i> Payment
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <i class="bi bi-person-circle"></i>
                <div>
                    <div class="fw-semibold text-white" style="font-size:0.82rem;">@User.Identity!.Name</div>
                    <div style="font-size:0.72rem;opacity:0.5;">@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Tester") ? "Tester" : User.IsInRole("Developer") ? "Developer" : User.IsInRole("Agent") ? "Agent" : "Employee")</div>
                    <div class="plan-indicator @planIndicatorClass">@planIndicatorLabel</div>
                </div>
            </div>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    <div class="main-wrapper">
        <div class="main-topbar">
            <h1 class="page-title">@(ViewData["Title"] ?? "Softracker")</h1>
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary notification-btn"
                            id="notificationBellButton"
                            type="button"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        <i class="bi bi-bell"></i>
                        @if (notificationBell.UnreadCount > 0)
                        {
                            <span class="notification-badge">@(notificationBell.UnreadCount > 99 ? "99+" : notificationBell.UnreadCount.ToString())</span>
                        }
                    </button>
                    <div id="notificationDropdownHost">
                        @await Html.PartialAsync("_NotificationDropdown", notificationDropdownModel)
                    </div>
                </div>
            </div>
        </div>

        <div class="main-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-3">
                    <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    (function () {
        const bellButton = document.getElementById('notificationBellButton');
        const dropdownHost = document.getElementById('notificationDropdownHost');
        if (!bellButton || !dropdownHost) {
            return;
        }

        let isRefreshing = false;

        function updateBadge(unreadCount) {
            const count = Number.isFinite(unreadCount) ? unreadCount : 0;
            let badge = bellButton.querySelector('.notification-badge');

            if (count <= 0) {
                if (badge) {
                    badge.remove();
                }
                return;
            }

            if (!badge) {
                badge = document.createElement('span');
                badge.className = 'notification-badge';
                bellButton.appendChild(badge);
            }

            badge.textContent = count > 99 ? '99+' : String(count);
        }

        async function refreshNotificationBell() {
            if (isRefreshing) {
                return;
            }

            isRefreshing = true;
            try {
                const returnUrl = window.location.pathname + window.location.search;
                const endpoint = '/Notification/BellFragment?returnUrl=' + encodeURIComponent(returnUrl);
                const response = await fetch(endpoint, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });

                if (!response.ok) {
                    return;
                }

                const html = await response.text();
                dropdownHost.innerHTML = html;

                const menu = dropdownHost.querySelector('.notification-menu');
                const unreadRaw = menu ? menu.getAttribute('data-unread-count') : '0';
                const unreadCount = parseInt(unreadRaw || '0', 10);
                updateBadge(Number.isNaN(unreadCount) ? 0 : unreadCount);
            } catch {
                // Ignore transient polling errors.
            } finally {
                isRefreshing = false;
            }
        }

        window.setInterval(refreshNotificationBell, 10000);
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) {
                refreshNotificationBell();
            }
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

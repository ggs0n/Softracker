@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using WFHMonitor.Models
@using WFHMonitor.Services.Interfaces
@inject INotificationService NotificationService
@inject ISystemSettingsService SystemSettingsService
@inject IGitHubOAuthService GitHubOAuthService
@inject ICodexAuthService CodexAuthService
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Softracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act  = ViewContext.RouteData.Values["action"]?.ToString();
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var notificationBell = string.IsNullOrWhiteSpace(userId)
        ? new WFHMonitor.ViewModels.NotificationBellViewModel()
        : await NotificationService.GetBellAsync(userId);
    var currentUser = string.IsNullOrWhiteSpace(userId)
        ? null
        : await UserManager.FindByIdAsync(userId);
    var runtimeAccess = await SystemSettingsService.BuildRuntimeAccessAsync(User);
    var isProActive = currentUser?.SubscriptionPlan == SubscriptionPlan.Pro
                      && currentUser.IsProSubscriptionActive
                      && (!currentUser.ProSubscriptionEndsAt.HasValue
                          || currentUser.ProSubscriptionEndsAt.Value > DateTime.UtcNow);
    var isProPending = currentUser?.SubscriptionPlan == SubscriptionPlan.Pro && !currentUser.IsProSubscriptionActive;
    var planIndicatorClass = isProActive ? "pro" : isProPending ? "pending" : "free";
    var planIndicatorLabel = isProActive ? "PRO ACTIVE" : isProPending ? "PRO PENDING" : "FREE";
    var sidebarRoleLabel = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Tester") ? "Tester" : User.IsInRole("Developer") ? "Developer" : User.IsInRole("Agent") ? "Agent" : "Employee";
    var profileDisplayName = string.IsNullOrWhiteSpace(currentUser?.FullName) ? (User.Identity?.Name ?? "User") : currentUser!.FullName;
    var profileEmail = currentUser?.Email ?? User.Identity?.Name ?? string.Empty;
    var profilePhotoFileName = string.IsNullOrWhiteSpace(currentUser?.ProfilePhotoPath)
        ? null
        : System.IO.Path.GetFileName(currentUser.ProfilePhotoPath);
    var profilePhotoUrl = string.IsNullOrWhiteSpace(profilePhotoFileName) ? null : Url.Content($"~/uploads/profiles/{profilePhotoFileName}");
    var profileInitial = string.IsNullOrWhiteSpace(profileDisplayName) ? "U" : profileDisplayName.Trim()[0].ToString().ToUpperInvariant();
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var notificationDropdownModel = new WFHMonitor.ViewModels.NotificationDropdownViewModel
    {
        Bell = notificationBell,
        ReturnUrl = returnUrl
    };
    var canManageGitHubConnection = User.IsInRole("Admin") || User.IsInRole("Developer") || User.IsInRole("Employee");
    var isGitHubOAuthConfigured = GitHubOAuthService.IsOAuthConfigured();
    var isGitHubConnected = canManageGitHubConnection && !string.IsNullOrWhiteSpace(userId)
        && await GitHubOAuthService.IsConnectedAsync(userId);
    var canManageCodexConnection = User.IsInRole("Admin");
    var codexAuthStatus = canManageCodexConnection
        ? await CodexAuthService.GetStatusAsync(Context.RequestAborted)
        : null;
    var isProjectsSectionActive = ctrl == "ChangeRequest" || ctrl == "Bug" || ctrl == "Qa";
    var isMonitorSectionActive = ctrl == "Monitor";
    var isPaymentSectionActive = ctrl == "Payment";
    var isTeamSectionActive = ctrl == "Team" || ctrl == "Agent" || (ctrl == "Admin" && act == "Employees");
    var canShowProjectsGroup = runtimeAccess.CanViewAllProjects || runtimeAccess.CanViewFeatures || runtimeAccess.CanViewBugs || runtimeAccess.CanViewQaTesting;

    <aside class="sidebar">
        <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
            <div class="brand-icon"><img src="/images/cat1.jpg" style="width:48px;height:48px;object-fit:contain;border-radius:10px" /></div>
            <span>Softracker</span>
        </a>

        <div class="sidebar-section-label">Main</div>
        <ul class="sidebar-nav">
            @if (User.IsInRole("Admin"))
            {
                <li>
                    <a asp-controller="Admin" asp-action="Index"
                       class="@(ctrl == "Admin" && act == "Index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
            }
            @if (User.IsInRole("Employee") || User.IsInRole("Developer"))
            {
                @if (User.IsInRole("Developer"))
                {
                    <li>
                        <a asp-controller="Developer" asp-action="Summary"
                           class="@(ctrl == "Developer" && act == "Summary" ? "active" : "")">
                            <i class="bi bi-clipboard-data"></i> Developer Summary
                        </a>
                    </li>
                }
            }
        </ul>

        <div class="sidebar-section-label">Management</div>
        <ul class="sidebar-nav">
            @if (canShowProjectsGroup)
            {
                <li class="sidebar-nav-group">
                    <a href="#projectsNavGroup"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="@(isProjectsSectionActive ? "true" : "false")"
                       aria-controls="projectsNavGroup"
                       class="sidebar-group-toggle @(isProjectsSectionActive ? "active" : "")">
                        <span><i class="bi bi-file-earmark-diff"></i> Projects</span>
                        <i class="bi bi-chevron-down sidebar-group-chevron"></i>
                    </a>
                    <ul class="sidebar-subnav collapse @(isProjectsSectionActive ? "show" : "")" id="projectsNavGroup">
                        @if (runtimeAccess.CanViewAllProjects)
                        {
                            <li>
                                <a asp-controller="ChangeRequest" asp-action="Index"
                                   data-onboarding-id="project-create-entry"
                                   class="@(ctrl == "ChangeRequest" && act != "Features" ? "active" : "")">
                                    <i class="bi bi-grid-1x2"></i> All Projects
                                </a>
                            </li>
                        }
                        @if (runtimeAccess.CanViewFeatures)
                        {
                            <li>
                                <a asp-controller="ChangeRequest" asp-action="Features"
                                   class="@(ctrl == "ChangeRequest" && act == "Features" ? "active" : "")">
                                    <i class="bi bi-list-check"></i> Features
                                </a>
                            </li>
                        }
                        @if (runtimeAccess.CanViewBugs)
                        {
                            <li>
                                <a asp-controller="Bug" asp-action="Index"
                                   class="@(ctrl == "Bug" ? "active" : "")">
                                    <i class="bi bi-bug"></i> Bugs
                                </a>
                            </li>
                        }
                        @if (runtimeAccess.CanViewQaTesting)
                        {
                            <li>
                                <a asp-controller="Qa" asp-action="Index"
                                   class="@(ctrl == "Qa" ? "active" : "")">
                                    <i class="bi bi-shield-check"></i> QA Testing
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer"))
            {
                <li>
                    <a asp-controller="Monitor" asp-action="Index"
                       class="@(isMonitorSectionActive ? "active" : "")">
                        <i class="bi bi-activity"></i> Monitor (BETA)
                    </a>
                </li>
            }
            @if (User.IsInRole("Admin") || User.IsInRole("Tester") || User.IsInRole("Developer") || User.IsInRole("Agent"))
            {
                <li class="sidebar-nav-group">
                    <a href="#teamNavGroup"
                       data-bs-toggle="collapse"
                       role="button"
                       aria-expanded="@(isTeamSectionActive ? "true" : "false")"
                       aria-controls="teamNavGroup"
                       class="sidebar-group-toggle @(isTeamSectionActive ? "active" : "")">
                        <span><i class="bi bi-diagram-3"></i> Team</span>
                        <i class="bi bi-chevron-down sidebar-group-chevron"></i>
                    </a>
                    <ul class="sidebar-subnav collapse @(isTeamSectionActive ? "show" : "")" id="teamNavGroup">
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Team" asp-action="Index"
                                   class="@(ctrl == "Team" && act == "Index" ? "active" : "")">
                                    <i class="bi bi-people"></i> Team
                                </a>
                            </li>
                        }
                        <li>
                            <a asp-controller="Agent" asp-action="Index"
                               class="@(ctrl == "Agent" ? "active" : "")">
                                <i class="bi bi-cpu"></i> Agent
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li>
                                <a asp-controller="Team" asp-action="Employees"
                                   class="@(ctrl == "Admin" && act == "Employees" ? "active" : "")">
                                    <i class="bi bi-person-badge"></i> Employees
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            <li>
                <a asp-controller="Payment" asp-action="Index"
                   class="@(isPaymentSectionActive ? "active" : "")">
                    <i class="bi bi-credit-card-2-front"></i> Subscription
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <button type="button" class="user-info user-info-trigger" data-bs-toggle="modal" data-bs-target="#sidebarProfileModal">
                <span class="sidebar-user-avatar" aria-hidden="true">
                    @if (!string.IsNullOrWhiteSpace(profilePhotoUrl))
                    {
                        <img src="@profilePhotoUrl" alt="@profileDisplayName profile photo" />
                    }
                    else
                    {
                        <span>@profileInitial</span>
                    }
                </span>
                <span class="user-info-meta">
                    <span class="fw-semibold text-white sidebar-user-name">@profileDisplayName</span>
                    <span class="sidebar-user-email">@profileEmail</span>
                    <span class="sidebar-user-role">@sidebarRoleLabel</span>
                    <span class="plan-indicator @planIndicatorClass">@planIndicatorLabel</span>
                </span>
            </button>
            <form asp-controller="Auth" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </aside>

    <div class="modal fade" id="sidebarProfileModal" tabindex="-1" aria-labelledby="sidebarProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sidebar-profile-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="sidebarProfileModalLabel">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="Auth" asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div class="modal-body">
                        <div class="sidebar-profile-preview mb-3">
                            <span class="sidebar-user-avatar sidebar-user-avatar-lg" aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(profilePhotoUrl))
                                {
                                    <img src="@profilePhotoUrl" alt="@profileDisplayName profile photo" />
                                }
                                else
                                {
                                    <span>@profileInitial</span>
                                }
                            </span>
                            <div>
                                <div class="fw-semibold">@profileDisplayName</div>
                                <div class="small text-muted">@profileEmail</div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="sidebarProfileNameInput" class="form-label">Name</label>
                            <input id="sidebarProfileNameInput"
                                   type="text"
                                   class="form-control"
                                   name="FullName"
                                   value="@profileDisplayName"
                                   maxlength="100"
                                   required />
                        </div>
                        <div class="mb-2">
                            <label for="sidebarProfilePhotoInput" class="form-label">Photo</label>
                            <input id="sidebarProfilePhotoInput"
                                   type="file"
                                   class="form-control"
                                   name="ProfilePhoto"
                                   accept=".jpg,.jpeg,.png,.webp,.gif,image/*" />
                        </div>
                        <div class="small text-muted">Upload JPG, JPEG, PNG, WEBP, or GIF up to 5 MB.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Profile</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="main-wrapper">
        <div class="main-topbar">
            <h1 class="page-title">@(ViewData["Title"] ?? "Softracker")</h1>
            <div class="st-clock" id="stClock" aria-label="Current local time">
                <div class="st-analog-clock" id="stAnalogClock" role="img" aria-hidden="true">
                    <span class="st-analog-clock-center"></span>
                    <span class="st-analog-hand st-analog-hour" id="stClockHour"></span>
                    <span class="st-analog-hand st-analog-minute" id="stClockMinute"></span>
                    <span class="st-analog-hand st-analog-second" id="stClockSecond"></span>
                    <span class="st-clock-marker st-clock-marker-12"></span>
                    <span class="st-clock-marker st-clock-marker-3"></span>
                    <span class="st-clock-marker st-clock-marker-6"></span>
                    <span class="st-clock-marker st-clock-marker-9"></span>
                </div>
                <span class="st-clock-date" id="stClockDate"></span>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (canManageCodexConnection && codexAuthStatus is not null)
                {
                    if (codexAuthStatus.IsAuthenticated)
                    {
                        <form asp-controller="CodexAuth" asp-action="Disconnect" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit"
                                    class="btn btn-sm btn-outline-success notification-btn"
                                    title="@codexAuthStatus.Message">
                                <i class="bi bi-robot me-1"></i>Codex Connected
                            </button>
                        </form>
                    }
                    else if (codexAuthStatus.IsAvailable)
                    {
                        <form asp-controller="CodexAuth" asp-action="Connect" method="post" target="_blank" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit"
                                    class="btn btn-sm btn-outline-dark notification-btn"
                                    title="Sign in to Codex with ChatGPT">
                                <i class="bi bi-robot me-1"></i>Connect Codex
                            </button>
                        </form>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary notification-btn"
                                title="@codexAuthStatus.Message"
                                disabled>
                            <i class="bi bi-robot me-1"></i>Codex Unavailable
                        </button>
                    }
                }
                @if (canManageGitHubConnection)
                {
                    if (isGitHubOAuthConfigured)
                    {
                        if (isGitHubConnected)
                        {
                            <form asp-controller="GitHubAuth" asp-action="Disconnect" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit"
                                        data-onboarding-id="github-connect-button"
                                        class="btn btn-sm btn-outline-success notification-btn"
                                        title="Disconnect GitHub">
                                    <i class="bi bi-github me-1"></i>GitHub Connected
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-controller="GitHubAuth"
                               asp-action="Connect"
                               asp-route-returnUrl="@returnUrl"
                               data-onboarding-id="github-connect-button"
                               class="btn btn-sm btn-outline-dark notification-btn"
                               title="Connect GitHub">
                                <i class="bi bi-github me-1"></i>Connect GitHub
                            </a>
                        }
                    }
                    else
                    {
                        <button type="button"
                                data-onboarding-id="github-connect-button"
                                class="btn btn-sm btn-outline-secondary notification-btn"
                                title="GitHub OAuth is not configured"
                                disabled>
                            <i class="bi bi-github me-1"></i>GitHub Unavailable
                        </button>
                    }
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Developer") || User.IsInRole("Employee"))
                {
                    <button type="button"
                            id="onboardingStartTourButton"
                            data-onboarding-id="start-tour-button"
                            class="btn btn-sm btn-outline-secondary notification-btn"
                            title="Help / Start Tour">
                        <i class="bi bi-question-circle me-1"></i>Help / Start Tour
                    </button>
                }
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary notification-btn"
                            id="notificationBellButton"
                            type="button"
                            data-initial-unread="@notificationBell.UnreadCount"
                            data-bell-sound-enabled="@(runtimeAccess.BellNotificationSoundEnabled.ToString().ToLowerInvariant())"
                            data-bell-sound-option="@runtimeAccess.BellNotificationSoundOption"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false">
                        <i class="bi bi-bell"></i>
                        @if (notificationBell.UnreadCount > 0)
                        {
                            <span class="notification-badge">@(notificationBell.UnreadCount > 99 ? "99+" : notificationBell.UnreadCount.ToString())</span>
                        }
                    </button>
                    <div id="notificationDropdownHost">
                        @await Html.PartialAsync("_NotificationDropdown", notificationDropdownModel)
                    </div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Settings" asp-action="Index" class="btn btn-sm btn-outline-secondary notification-btn settings-top-btn" title="Settings">
                        <i class="bi bi-gear"></i>
                    </a>
                }
            </div>
        </div>

        <div class="main-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-3">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-3">
                    <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show mb-3">
                    <i class="bi bi-info-circle me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </div>
    </div>

    @if (User.IsInRole("Admin") || User.IsInRole("Developer") || User.IsInRole("Employee"))
    {
        <div id="onboardingOverlay" class="onboarding-overlay d-none" aria-hidden="true">
            <div class="onboarding-backdrop"></div>
            <div class="onboarding-card" role="dialog" aria-modal="true" aria-labelledby="onboardingTitle">
                <div class="onboarding-card-head">
                    <div class="onboarding-step-label" id="onboardingStepLabel">Step 1 of 3</div>
                    <button type="button" class="btn-close" id="onboardingDismissTop" aria-label="Close"></button>
                </div>
                <h5 class="onboarding-title mb-2" id="onboardingTitle"></h5>
                <p class="onboarding-description mb-3" id="onboardingDescription"></p>
                <div class="onboarding-status-note mb-3 d-none" id="onboardingStatusNote"></div>
                <div class="onboarding-actions">
                    <a href="#" class="btn btn-sm btn-outline-primary d-none" id="onboardingGoTarget"></a>
                </div>
                <div class="onboarding-footer">
                    <div class="onboarding-footer-left">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="onboardingBack">Back</button>
                        <button type="button" class="btn btn-sm btn-primary" id="onboardingNext">Next</button>
                    </div>
                    <div class="onboarding-footer-right">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="onboardingRestart">Restart</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" id="onboardingDismiss">Dismiss</button>
                    </div>
                </div>
            </div>
        </div>
        <form id="onboardingAntiForgeryForm" class="d-none">
            @Html.AntiForgeryToken()
        </form>
    }
}
else
{
    @RenderBody()
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/onboarding.js" asp-append-version="true"></script>
<script>
    (function () {
        var hourEl = document.getElementById('stClockHour');
        var minuteEl = document.getElementById('stClockMinute');
        var secondEl = document.getElementById('stClockSecond');
        var dateEl = document.getElementById('stClockDate');
        var clockEl = document.getElementById('stClock');
        if (!hourEl || !minuteEl || !secondEl || !dateEl || !clockEl) return;

        function tick() {
            var now = new Date();
            var hours = now.getHours() % 12;
            var minutes = now.getMinutes();
            var seconds = now.getSeconds();

            var hourDeg = (hours * 30) + (minutes * 0.5) + (seconds * (0.5 / 60));
            var minuteDeg = (minutes * 6) + (seconds * 0.1);
            var secondDeg = seconds * 6;

            hourEl.style.transform = 'translateX(-50%) rotate(' + hourDeg + 'deg)';
            minuteEl.style.transform = 'translateX(-50%) rotate(' + minuteDeg + 'deg)';
            secondEl.style.transform = 'translateX(-50%) rotate(' + secondDeg + 'deg)';

            var day = now.toLocaleDateString('en-US', { weekday: 'short' });
            var month = now.toLocaleDateString('en-US', { month: 'short' });
            var date = now.getDate();
            var year = now.getFullYear();
            var tz = now.toLocaleTimeString('en-US', { timeZoneName: 'short' }).split(' ').pop();
            dateEl.textContent = day + ', ' + month + ' ' + date + ' ' + year + ' · ' + tz;

            var digitalTime = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            clockEl.setAttribute('aria-label', 'Current local time ' + digitalTime + ', ' + dateEl.textContent);
        }

        tick();
        setInterval(tick, 1000);
    })();
</script>
<script>
    (function () {
        const bellButton = document.getElementById('notificationBellButton');
        const dropdownHost = document.getElementById('notificationDropdownHost');
        if (!bellButton || !dropdownHost) {
            return;
        }

        let isRefreshing = false;
        let previousUnreadCount = parseInt(bellButton.getAttribute('data-initial-unread') || '0', 10);
        if (Number.isNaN(previousUnreadCount)) {
            previousUnreadCount = 0;
        }

        const isBellSoundEnabled = (bellButton.getAttribute('data-bell-sound-enabled') || '').toLowerCase() === 'true';
        const bellSoundOption = (bellButton.getAttribute('data-bell-sound-option') || 'classic').toLowerCase();
        let audioContext = null;

        function updateBadge(unreadCount) {
            const count = Number.isFinite(unreadCount) ? unreadCount : 0;
            let badge = bellButton.querySelector('.notification-badge');

            if (count <= 0) {
                if (badge) {
                    badge.remove();
                }
                return;
            }

            if (!badge) {
                badge = document.createElement('span');
                badge.className = 'notification-badge';
                bellButton.appendChild(badge);
            }

            badge.textContent = count > 99 ? '99+' : String(count);
        }

        function getAudioContext() {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) {
                return null;
            }

            if (!audioContext) {
                audioContext = new AudioCtx();
            }

            return audioContext;
        }

        document.addEventListener('click', function () {
            const ctx = getAudioContext();
            if (ctx && ctx.state === 'suspended') {
                ctx.resume().catch(function () { });
            }
        }, { once: true });

        function playNotificationSound() {
            if (!isBellSoundEnabled) {
                return;
            }

            const ctx = getAudioContext();
            if (!ctx) {
                return;
            }

            try {
                const now = ctx.currentTime;
                const playTone = function (freq, startOffset, duration, volume, type) {
                    const oscillator = ctx.createOscillator();
                    const gain = ctx.createGain();

                    oscillator.type = type || 'sine';
                    oscillator.frequency.setValueAtTime(freq, now + startOffset);

                    gain.gain.setValueAtTime(0.0001, now + startOffset);
                    gain.gain.exponentialRampToValueAtTime(volume, now + startOffset + 0.01);
                    gain.gain.exponentialRampToValueAtTime(0.0001, now + startOffset + duration);

                    oscillator.connect(gain);
                    gain.connect(ctx.destination);
                    oscillator.start(now + startOffset);
                    oscillator.stop(now + startOffset + duration + 0.02);
                };

                switch (bellSoundOption) {
                    case 'soft':
                        playTone(740, 0.00, 0.22, 0.07, 'sine');
                        break;
                    case 'chime':
                        playTone(880, 0.00, 0.12, 0.09, 'triangle');
                        playTone(1175, 0.14, 0.16, 0.08, 'triangle');
                        break;
                    case 'alert':
                        playTone(780, 0.00, 0.08, 0.10, 'square');
                        playTone(980, 0.10, 0.08, 0.10, 'square');
                        playTone(780, 0.20, 0.09, 0.09, 'square');
                        break;
                    default:
                        playTone(920, 0.00, 0.16, 0.10, 'sine');
                        break;
                }
            } catch {
                // Ignore browser audio errors.
            }
        }

        async function refreshNotificationBell() {
            if (isRefreshing) {
                return;
            }

            isRefreshing = true;
            try {
                const returnUrl = window.location.pathname + window.location.search;
                const endpoint = '/Notification/BellFragment?returnUrl=' + encodeURIComponent(returnUrl);
                const response = await fetch(endpoint, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });

                if (!response.ok) {
                    return;
                }

                const dropdown = window.bootstrap?.Dropdown?.getOrCreateInstance(bellButton);
                const wasOpen = bellButton.getAttribute('aria-expanded') === 'true';
                if (wasOpen && dropdown) {
                    dropdown.hide();
                }

                const html = await response.text();
                dropdownHost.innerHTML = html;

                if (dropdown) {
                    dropdown.dispose();
                    window.bootstrap.Dropdown.getOrCreateInstance(bellButton);
                }

                const menu = dropdownHost.querySelector('.notification-menu');
                const unreadRaw = menu ? menu.getAttribute('data-unread-count') : '0';
                const unreadCount = parseInt(unreadRaw || '0', 10);
                const normalizedUnread = Number.isNaN(unreadCount) ? 0 : unreadCount;

                if (normalizedUnread > previousUnreadCount) {
                    playNotificationSound();
                }

                previousUnreadCount = normalizedUnread;
                updateBadge(normalizedUnread);
            } catch {
                // Ignore transient polling errors.
            } finally {
                isRefreshing = false;
            }
        }

        if (window.bootstrap?.Dropdown) {
            window.bootstrap.Dropdown.getOrCreateInstance(bellButton);
        }

        window.setInterval(refreshNotificationBell, 10000);
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) {
                refreshNotificationBell();
            }
        });
    })();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<Window x:Class="WFHMonitor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Softracker"
        Icon="Assets/Softracker.ico"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        Closing="Window_Closing">
    <Grid>
        <wv2:WebView2 x:Name="Browser"
                      Visibility="Collapsed"
                      NavigationStarting="Browser_NavigationStarting"
                      CoreWebView2InitializationCompleted="Browser_CoreWebView2InitializationCompleted" />

        <Border x:Name="LoadingPanel" Background="#F4F6F8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
                <Border Width="62" Height="62" CornerRadius="16" Background="#18181B" HorizontalAlignment="Center">
                    <TextBlock Text="S" Foreground="#34D399" FontWeight="Bold" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Softracker" Margin="0,16,0,0" FontSize="25" FontWeight="Bold"
                           Foreground="#18181B" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingMessage" Text="Starting your local workspace…" Margin="0,8,0,0"
                           FontSize="14" Foreground="#71717A" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar x:Name="LoadingProgress" Margin="0,22,0,0" Height="5" IsIndeterminate="True"
                             Foreground="#10B981" Background="#E4E4E7" />
                <Button x:Name="RetryButton" Content="Try Again" Margin="0,18,0,0" Padding="18,8"
                        HorizontalAlignment="Center" Visibility="Collapsed" Click="RetryButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

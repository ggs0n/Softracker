{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "rootCause", "changes", "tests", "risks"],
  "properties": {
    "summary": { "type": "string", "minLength": 1 },
    "rootCause": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "details"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["Passed", "Failed", "Skipped"]
          },
          "details": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

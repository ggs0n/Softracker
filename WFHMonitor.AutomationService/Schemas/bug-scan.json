{
  "type": "object",
  "additionalProperties": false,
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "description",
          "workflow",
          "stepsToReproduce",
          "moduleImpacted",
          "severity",
          "screenshotPaths"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "minLength": 1 },
          "workflow": { "type": "string", "minLength": 1 },
          "stepsToReproduce": { "type": "string", "minLength": 1 },
          "moduleImpacted": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["Low", "Medium", "High", "Critical"]
          },
          "screenshotPaths": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}

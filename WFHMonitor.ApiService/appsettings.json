{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=WFHMonitorDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "DbContextPoolSize": 128
  },
  "FileStorage": {
    "WebRootPath": "../WFHMonitor/wwwroot",
    "UploadsDirectoryName": "uploads",
    "CacheMaxAgeSeconds": 604800
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60
  },
  "ResponseCompression": {
    "BrotliLevel": "Fastest",
    "GzipLevel": "SmallestSize"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "WFHMonitor",
    "Audience": "WFHMonitorUsers",
    "ExpiryMinutes": 60
  },
  "GitHubSettings": {
    "Token": "",
    "ApiBaseUrl": "https://api.github.com/",
    "WebBaseUrl": "https://github.com/"
  },
  "GitHubOAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "",
    "Scope": "repo read:user",
    "StateLifetimeMinutes": 15,
    "ForceAccountPicker": true,
    "AuthorizeUrl": "https://github.com/login/oauth/authorize",
    "AccessTokenUrl": "https://github.com/login/oauth/access_token",
    "UserApiUrl": "https://api.github.com/user"
  },
  "GitAutomation": {
    "WorkspaceRoot": "../.wfhtmp/ai-workspaces",
    "GitExecutablePath": "git",
    "CloneUrlTemplate": "https://github.com/{owner}/{repository}.git",
    "BranchPrefix": "wfhmonitor/fix",
    "CommitUserName": "WFHMonitor AI Automation",
    "CommitUserEmail": "wfhmonitor-ai@localhost",
    "CommandTimeoutSeconds": 300,
    "WorkspaceRetentionHours": 24,
    "CleanupIntervalMinutes": 30
  },
  "StripeBilling": {
    "SecretKey": "",
    "ApiBaseUrl": "https://api.stripe.com/v1/",
    "ProPriceId": "",
    "ProUnitAmount": 2900,
    "Currency": "usd",
    "ProductName": "Softracker Pro"
  },
  "ProjectMonitoring": {
    "RequestTimeoutSeconds": 10,
    "GoogleAnalytics": {
      "AccessToken": "",
      "ApiBaseUrl": "https://analyticsdata.googleapis.com/v1beta/",
      "LookbackDays": 30
    },
    "Stripe": {
      "SecretKey": "",
      "ApiBaseUrl": "https://api.stripe.com/v1/",
      "MaxPayments": 20
    },
    "Projects": []
  },
  "AiAutomation": {
    "ProfileId": "codex",
    "AllowedProfileIds": [
      "codex"
    ],
    "ScreenshotImportDirectory": "",
    "ScreenshotImportDirectories": [],
    "ScreenshotImportLookbackMinutes": 180,
    "ScreenshotImportMaxFiles": 5
  },
  "AiAutomationService": {
    "BaseUrl": "http://127.0.0.1:5201",
    "SharedSecret": "",
    "RequestTimeoutSeconds": 900,
    "MaxFindingsPerScan": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

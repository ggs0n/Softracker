{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "WFH Monitor",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/WFHMonitor/bin/Debug/net8.0/WFHMonitor.dll",
            "args": [],
            "cwd": "${workspaceFolder}/WFHMonitor",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/Auth/Login"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5227"
            }
        }
    ]
}
